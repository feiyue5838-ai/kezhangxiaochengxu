/* pages/auth/index.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #EEF1FF, #F8F7FC, #fff);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* 鑳屾櫙瑁呴グ */
.bg-top {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 480rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  border-radius: 0 0 48% 48%;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(91, 111, 232, 0.06);
}
.c1 { width: 300rpx; height: 300rpx; top: 340rpx; right: -60rpx; }
.c2 { width: 200rpx; height: 200rpx; top: 580rpx; left: -40rpx; }

/* ========== Logo鍖?========== */
.logo-section {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgb(91 111 232 / 0.25);
  margin-bottom: 24rpx;
}
.logo-text { font-size: 56rpx; font-weight: 700; color: #7B5CFA; }

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A2332;
  display: block;
  margin-bottom: 10rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
}

/* ========== 鐧诲綍鍗＄墖 ========== */
.login-card {
  position: relative;
  z-index: 10;
  width: 640rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 48rpx;
  box-shadow: 0 8rpx 48rpx rgb(91 111 232 / 0.12);
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A2332;
  display: block;
  text-align: center;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #B0BBC8;
  display: block;
  text-align: center;
  margin-bottom: 48rpx;
}

/* 微信登录按钮 */
.wechat-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 28rpx rgb(91 111 232 / 0.35);
  border: none;
  padding: 0;
  margin: 0 0 40rpx;
}
.wechat-btn::after { border: none; }
.wechat-btn[loading] { opacity: 0.7; }

.btn-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
  font-size: 24rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 鍒嗛殧绾? */
.divider-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #f0f0f0;
}

.divider-text {
  font-size: 24rpx;
  color: #B0BBC8;
  flex-shrink: 0;
}

/* 鍏朵粬鐧诲綍 */
.alt-login {
  display: flex;
  justify-content: center;
}

.alt-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 40rpx;
}

.alt-icon {
  width: 64rpx;
  height: 64rpx;
  background: #F8F7FC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #555;
  border: 1rpx solid #eee;
}

.alt-text {
  font-size: 22rpx;
  color: #B0BBC8;
}

/* ========== 协议 ========== */
.agreement-row {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 0 40rpx;
  margin-top: 40rpx;
}

.agreement-center {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ccc;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #7B5CFA;
  border-color: #7B5CFA;
}

.check-mark {
  font-size: 20rpx;
  color: #fff;
  font-weight: 700;
}

.agreement-center .link {
  font-size: 24rpx;
  color: #7B5CFA;
  font-weight: 500;
}

.agreement-hint {
  font-size: 20rpx;
  color: #999;
}

.material-declaration {
  margin-top: 16rpx;
  padding: 0 40rpx;
  text-align: center;
}

.material-declaration text {
  font-size: 22rpx;
  color: #666;
  line-height: 1.6;
}
