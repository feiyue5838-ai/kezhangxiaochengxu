<view class="page">
  <!-- 背景装饰 -->
  <view class="bg-top"></view>
  <view class="bg-circle c1"></view>
  <view class="bg-circle c2"></view>

  <!-- 顶部占位（配合状态栏） -->
  <nav-bar title="" />

  <!-- Logo区 -->
  <view class="logo-section">
    <view class="logo-icon">
      <text class="logo-text">蓉</text>
    </view>
    <text class="app-name">蓉城企服</text>
    <text class="app-slogan">一站式企业服务平台</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <text class="card-title">欢迎回来</text>
    <text class="card-desc">登录后享受完整服务体验</text>

    <!-- 微信一键登录 -->
    <button
      class="wechat-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{loading}}"
    >
      <text class="btn-icon">微</text>
      <text class="btn-text">微信一键登录</text>
    </button>

    <!-- 其他登录方式 -->
    <view class="divider-row">
      <view class="divider-line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="divider-line"></view>
    </view>

    <view class="alt-login">
      <view class="alt-btn" bindtap="onGuestEnter">
        <text class="alt-icon">访</text>
        <text class="alt-text">游客试玩</text>
      </view>
    </view>
  </view>

  <!-- 协议声明 -->
  <view class="agreement-row">
    <view class="agreement-center">
      <text class="link" bindtap="openPrivacy">《隐私政策》</text>
      <text class="link" bindtap="openTerms">《用户服务协议》</text>
      <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">
        <text wx:if="{{agreed}}" class="check-mark">✓</text>
      </view>
    </view>
    <text class="agreement-hint">登录即表示同意</text>
  </view>
</view>
