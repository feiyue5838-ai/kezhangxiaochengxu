page {
  background: var(--bg-color);
  padding-bottom: 60rpx;
}

/* ========== 导航栏（与 realname 对齐）========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  box-sizing: border-box;
}
.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0 32rpx;
}
.nav-back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  line-height: 1;
}

.container {
  padding: 20rpx 0;
}

.form-section {
  background: var(--bg-white);
  padding: 0 32rpx;
  border-radius: 20rpx;
  margin: 0 20rpx;
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: var(--text-primary);
  width: 180rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  text-align: right;
  height: 60rpx;
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.text-normal {
  font-size: 30rpx;
  color: var(--text-primary);
}

.placeholder {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}

.detail-item {
  flex-direction: column;
  align-items: flex-start;
}

.detail-item .form-label {
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.default-item {
  border-bottom: none;
}

.btn-section {
  padding: 60rpx 40rpx 0;
}

.save-btn {
  background: var(--primary-color);
  color: var(--bg-white);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 24rpx 0;
  border: none;
}

.save-btn::after {
  border: none;
}
