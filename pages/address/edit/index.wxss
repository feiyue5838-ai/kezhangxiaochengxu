/* pages/address/edit/index.wxss */
page {
  background: #F8F7FC;
  padding-bottom: 60rpx;
}

.container {
  padding: 20rpx 0;
}

/* 表单区块 */
.form-section {
  background: #fff;
  padding: 0 32rpx;
  border-radius: 20rpx;
  margin: 0 20rpx;
}

/* 表单项 */
.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #1A202C;
  width: 180rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #1A202C;
  text-align: right;
  height: 60rpx;
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.text-normal {
  font-size: 30rpx;
  color: #1A202C;
}

.placeholder {
  font-size: 30rpx;
  color: #C0C8D4;
}

.arrow {
  font-size: 32rpx;
  color: #C0C8D4;
  margin-left: 12rpx;
}

/* 详细地址多行 */
.detail-item {
  flex-direction: column;
  align-items: flex-start;
}

.detail-item .form-label {
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
  color: #1A202C;
  border: 1rpx solid #E8ECF4;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

/* 设为默认 */
.default-item {
  border-bottom: none;
}

/* 保存按钮 */
.btn-section {
  padding: 60rpx 40rpx 0;
}

.save-btn {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgb(91 111 232 / 0.3);
  letter-spacing: 2rpx;
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  box-shadow: 0 4rpx 12rpx rgb(91 111 232 / 0.25);
  transform: scale(0.98);
}
