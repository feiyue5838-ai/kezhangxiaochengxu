/* pages/seal-tab/index.wxss */

/* ========== 页面背景 ========== */
page {
  background: linear-gradient(180deg, #F8F7FC 0%, #EEF0F8 100%);
  min-height: 100vh;
}

.page {
  background: transparent;
  min-height: 100vh;
}

/* ========== 导航栏 ========== */

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-side {
  position: absolute;
  top: 0; bottom: 0;
  display: flex;
  align-items: center;
}
.nav-side--left  { left: 32rpx; }
.nav-side--right { right: 32rpx; }

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}


/* ========== Hero ========== */
.hero {
  position: relative;
  padding: 44rpx 36rpx 50rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  overflow: hidden;
}

.hero-glow-1 {
  position: absolute;
  top: -30%;
  left: -10%;
  width: 480rpx;
  height: 480rpx;
  background: radial-gradient(circle, rgb(255 255 255 / 0.18) 0%, transparent 65%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow-2 {
  position: absolute;
  bottom: -20%;
  right: -15%;
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, rgb(255 255 255 / 0.10) 0%, transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-label {
  font-size: 20rpx;
  color: rgb(255 255 255 / 0.85);
  font-weight: 600;
  letter-spacing: 4rpx;
  display: block;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.25;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgb(255 255 255 / 0.8);
  letter-spacing: 1rpx;
  margin-bottom: 32rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* 缁熻鏉? */
.hero-stats {
  display: flex;
  align-items: center;
  background: rgb(255 255 255 / 0.15);
  backdrop-filter: blur(8px);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid rgb(255 255 255 / 0.2);
  margin-bottom: 26rpx;
  position: relative;
  z-index: 1;
}

.stat-item { flex: 1; text-align: center; }

.stat-num {
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
  display: block;
}

.stat-label {
  font-size: 20rpx;
  color: rgb(255 255 255 / 0.7);
  margin-top: 4rpx;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 36rpx;
  background: rgb(255 255 255 / 0.18);
}

/* 寰界珷 */
.hero-badges {
  display: flex;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.badge {
  padding: 10rpx 22rpx;
  background: rgb(255 255 255 / 0.18);
  border-radius: 20rpx;
  border: 1rpx solid rgb(255 255 255 / 0.22);
}

.badge text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

/* ========== 鍒嗙被鍖哄煢 ========== */
.section {
  padding: 32rpx 28rpx 16rpx;
  margin-top: -32rpx;
  position: relative;
  z-index: 2;
  border-radius: 32rpx 32rpx 0 0;
  background: transparent;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28rpx;
}

/* ===== 鍥涗釜鍗¤兒鏈夎厚鎰燂紙鍗＄瑧锛?===== */
.cat-card {
  background: #FFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 
    0 4rpx 16rpx rgb(91 111 232 / 0.08),
    0 1rpx 4rpx rgb(0 0 0 / 0.04);
  position: relative;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 铏氭槑松杈广€傚厜鏅曟晥鏋? */
.cat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 24rpx;
  padding: 2rpx;
  background: linear-gradient(135deg, rgb(91 111 232 / 0.15), rgb(167 139 250 / 0.08), transparent);
  -webkit-mask: 
    linear-gradient(#fff 0 0) content-box, 
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
}

.cat-card:active {
  transform: scale(0.96);
  box-shadow: 
    0 8rpx 32rpx rgb(91 111 232 / 0.15),
    0 2rpx 8rpx rgb(0 0 0 / 0.06);
}

.cat-card:active::before {
  opacity: 1;
}

.card-inner {
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx 24rpx;
  position: relative;
}

/* 鍥惧爞鍖烘湰锛氭紨鍙樻部褰紙鍦嗗舰锛? */
.icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgb(0 0 0 / 0.08);
}

/* 鍥惧爞鍖虹殑鍏夋樉鏁堟灉 */
.icon-wrap::after {
  content: '';
  position: absolute;
  top: -4rpx; left: -4rpx; right: -4rpx; bottom: -4rpx;
  border-radius: 50%;
  background: inherit;
  filter: blur(8px);
  opacity: 0.3;
  z-index: -1;
}

/* SVG 鍥炬爣灏哄 */
.cat-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.cat-name {
  font-size: 30rpx;
  color: #1A202C;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.cat-desc {
  font-size: 23rpx;
  color: #6B7B8D;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: block;
}

.card-arrow {
  font-size: 32rpx;
  color: #B0B8C4;
  align-self: flex-end;
  line-height: 1;
  transition: transform 0.2s;
}

.cat-card:active .card-arrow {
  transform: translateX(4rpx);
}

/* 搴曢儴淇℃垒鏍峰紡浼樺寲 */
.trust-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 32rpx 40rpx 56rpx;
}

.trust-line {
  width: 40rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #D5DDE8, transparent);
}

.trust-text {
  font-size: 23rpx;
  color: #A8B4C5;
  letter-spacing: 1rpx;
}

/* ========== 搴曢儴淇′换鏍?========== */
.trust-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 28rpx 40rpx 52rpx;
}

.trust-line {
  width: 28rpx;
  height: 1rpx;
  background: #D5DDE8;
}

.trust-text {
  font-size: 22rpx;
  color: #A8B4C5;
  letter-spacing: 0.5rpx;
}

/* 搴曢儴瀹夊叏鍖? */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  width: 100%;
}
