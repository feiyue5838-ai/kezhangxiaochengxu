/* form.wxss - 登报表单 */

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  margin: 0 20rpx 0 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.filter-picker {
  flex: 1;
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 20rpx;
  background: #F5F6FA;
  border-radius: 12rpx;
}

.filter-text {
  font-size: 28rpx;
  color: #1A2332;
  font-weight: 500;
}

.filter-arrow {
  font-size: 20rpx;
  color: #8C8C8C;
  margin-left: 8rpx;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
}

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}



.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
.nav-action {
  font-size: 28rpx;
  color: #fff;
  padding: 8rpx 24rpx;
  background: rgb(255 255 255 / 0.2);
  border-radius: 20rpx;
}

.page {
  background: #F8F7FC;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* 闂佸憡鍔曢幊搴敊閹邦叏绱ｉ柛鏇ㄥ櫘濞? */
.content-preview {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.preview-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A2332;
}

.preview-edit {
  font-size: 26rpx;
  color: #5B6FE8;
}

.preview-content {
  background: #F8F7FC;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #1A2332;
  line-height: 1.6;
}

.preview-meta {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.idcard-info {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 24rpx;
  background: #F8F7FC;
  border-radius: 20rpx;
  margin-top: 12rpx;
}

.idcard-text {
  font-size: 24rpx;
  color: #5B6FE8;
}

.meta-item {
  font-size: 24rpx;
  color: #8C97A6;
}

.section-select,
.paper-section,
.count-section,
.receiver-section,
.upload-section,
.remark-section,
.invoice-section,
.price-section {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A2332;
}

.section-count {
  font-size: 26rpx;
  color: #8C97A6;
  margin-left: 12rpx;
}

.section-tip {
  font-size: 24rpx;
  color: #8C97A6;
  margin-left: 12rpx;
}

.paper-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.paper-card {
  background: #F8F7FC;
  border-radius: 20rpx;
  padding: 20rpx 12rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 3rpx solid transparent;
  position: relative;
  transition: all 0.3s ease;
  box-sizing: border-box;
  height: 260rpx;
}

.paper-card.selected {
  background: #EBF3FF;
  border-color: #5B6FE8;
}

.paper-check {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #5B6FE8;
  border-radius: 0 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.check-icon {
  width: 24rpx;
  height: 24rpx;
}

.paper-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

.logo-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.paper-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  color: #fff;
  margin-bottom: 4rpx;
  height: 26rpx;
  line-height: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.paper-tag.empty {
  background: transparent !important;
  color: transparent !important;
}

.paper-tag.hot {
  background: #5B6FE8;
}

.paper-tag.value {
  background: #52c41a;
}

.paper-tag.authority {
  background: #5B6FE8;
}

.paper-tag.local {
  background: #9BA8FF;
}

.paper-name {
  font-size: 24rpx;
  color: #1A2332;
  font-weight: bold;
  text-align: center;
  line-height: 1.3;
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.paper-price-row {
  position: absolute;
  bottom: 16rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.paper-price {
  font-size: 28rpx;
  color: #5B6FE8;
  font-weight: bold;
}

.paper-unit {
  font-size: 20rpx;
  color: #8C97A6;
  margin-left: 2rpx;
}

.count-selector {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.count-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.count-label {
  font-size: 28rpx;
  color: #1A2332;
}

.count-picker {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.picker-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  background: #F8F7FC;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  color: #1A2332;
}

.picker-btn:active {
  background: #F8F7FC;
}

.picker-btn.minus {
  color: #5B6FE8;
}

.picker-btn.plus {
  background: #5B6FE8;
  color: #fff;
}

.picker-value {
  font-size: 30rpx;
  color: #1A2332;
  font-weight: bold;
  min-width: 80rpx;
  text-align: center;
}

.receiver-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F8F7FC;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #1A2332;
  width: 160rpx;
  flex-shrink: 0;
}

.required {
  color: #5B6FE8;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #1A2332;
  text-align: right;
}

.upload-area {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.upload-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgb(0 0 0 / 0.5);
  border-radius: 50%;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.upload-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #D5DDE8;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #A8B4C5;
}

.add-text {
  font-size: 22rpx;
  color: #8C97A6;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  background: #F8F7FC;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1A2332;
  box-sizing: border-box;
}

.invoice-options {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.invoice-option {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #F8F7FC;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.invoice-option.active {
  background: #EBF3FF;
  border-color: #5B6FE8;
}

.option-text {
  font-size: 26rpx;
  color: #1A2332;
}

.option-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #5B6FE8;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.invoice-form {
  padding-top: 16rpx;
  border-top: 1rpx solid #F8F7FC;
}

.price-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.price-label {
  font-size: 28rpx;
  color: #1A2332;
}

.price-value {
  font-size: 28rpx;
  color: #1A2332;
}

.price-row.total {
  border-top: 1rpx solid #F8F7FC;
  padding-top: 20rpx;
  margin-top: 8rpx;
}

.price-row.total .price-label {
  font-size: 30rpx;
  color: #1A2332;
  font-weight: bold;
}

.price-row.total .price-value {
  font-size: 40rpx;
  color: #5B6FE8;
  font-weight: bold;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 32rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgb(0 0 0 / 0.08);
  z-index: 99;
}

.total-info {
  display: flex;
  flex-direction: column;
}

.total-label {
  font-size: 24rpx;
  color: #8C97A6;
}

.total-price {
  font-size: 42rpx;
  font-weight: bold;
  color: #5B6FE8;
}

.pay-btn {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  color: white;
  font-size: 30rpx;
  font-weight: bold;
  padding: 22rpx 60rpx;
  border-radius: 20rpx;
  border: none;
}

.pay-btn::after {
  border: none;
}

/* 条件变色：报纸+地址+内容未齐备时置灰 */
.pay-btn-disabled {
  background: #C5CAD5;
  box-shadow: none;
}

/* ========== 闂佸憡鐟﹂崹褰掑Χ閵婏妇鈹嶉柍鈺佸暕缁辨牠鏌ㄥ☉妯煎闁哄苯锕钘夌暋閹殿喚顢呴梺?========== */
.section-arrow {
  font-size: 32rpx;
  color: #8C97A6;
  margin-left: auto;
}

.invoice-display {
  padding: 16rpx 0;
}

.invoice-title {
  font-size: 28rpx;
  color: #1A2332;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.invoice-desc {
  font-size: 24rpx;
  color: #8C97A6;
  display: block;
}

.invoice-placeholder {
  padding: 16rpx 0;
}

.placeholder {
  font-size: 28rpx;
  color: #A8B4C5;
}/* 登报内容编辑 */
.content-edit {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.edit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.edit-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A2332;
}

.edit-count {
  font-size: 24rpx;
  color: #8C97A6;
}

.edit-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F8F7FC;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1A2332;
  line-height: 1.6;
  box-sizing: border-box;
}

.edit-meta {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

/* 收货地址卡片 */
.address-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.address-left {
  flex: 1;
  min-width: 0;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2332;
  margin-right: 16rpx;
}

.address-phone {
  font-size: 26rpx;
  color: #8C97A6;
}

.address-detail {
  font-size: 26rpx;
  color: #5A6573;
  line-height: 1.5;
}

.address-empty {
  flex: 1;
}

.address-empty-text {
  font-size: 28rpx;
  color: #A8B4C5;
}

.address-arrow {
  font-size: 40rpx;
  color: #C0C8D4;
  margin-left: 16rpx;
}

/* 版面选择 */
.section-tip {
  font-size: 24rpx;
  color: #8C97A6;
  margin-left: 12rpx;
}
.sec-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sec-card {
  position: relative;
  flex: 0 0 calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #5B6FE8;
  background: #fff;
  box-shadow:
    0 0 0 1rpx rgba(167, 139, 250, 0.55) inset,
    0 4rpx 20rpx rgba(91, 111, 232, 0.10),
    0 1rpx 3rpx rgba(12, 26, 46, 0.04);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.sec-card:active {
  transform: scale(0.97);
}
.sec-card.selected {
  border-color: #5B6FE8;
  border-width: 2rpx;
  box-shadow:
    0 0 0 2rpx rgba(167, 139, 250, 0.70) inset,
    0 6rpx 24rpx rgba(91, 111, 232, 0.20),
    0 1rpx 3rpx rgba(12, 26, 46, 0.04);
}
.sec-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #5B6FE8;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sec-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2332;
}
.sec-cycle {
  display: block;
  font-size: 22rpx;
  color: #8C97A6;
  margin-top: 6rpx;
}
.sec-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}
.sec-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #F56C6C;
}
.sec-unit {
  font-size: 20rpx;
  color: #8C97A6;
  margin-left: 4rpx;
}
