/* pages/newspaper/form/index.wxss */
.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
}

.nav-back {
  width: 60rpx; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: #fff; font-weight: 300;
}

.nav-title {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx; font-weight: 600; color: #fff;
}



.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
.nav-right { width: 60rpx; }

.page {
  background: #F8F7FC;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 内容摘要 */
.content-summary {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  padding: 32rpx;
  color: #fff;
}

.summary-header { margin-bottom: 16rpx; }
.summary-title { font-size: 28rpx; opacity: 0.85; }

.summary-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.summary-type {
  font-size: 24rpx;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.summary-name {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
}

.summary-chars {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 通用区块 */
.section {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2332;
}

.section-required {
  color: #F5222D;
  margin-left: 8rpx;
}

/* 报纸列表 */
.paper-list { display: flex; flex-direction: column; gap: 16rpx; }

.paper-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #E8EBF0;
  border-radius: 16rpx;
  position: relative;
}

.paper-item.selected {
  border-color: #5B6FE8;
  background: #F0F2FF;
}

.paper-info { flex: 1; }
.paper-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2332;
  display: block;
}

.paper-desc {
  font-size: 24rpx;
  color: #8C97A6;
  margin-top: 6rpx;
  display: block;
}

.paper-price { text-align: right; margin-right: 40rpx; }
.price-num { font-size: 32rpx; font-weight: 700; color: #F5222D; }
.price-unit { font-size: 24rpx; color: #8C97A6; }

.paper-check {
  position: absolute;
  right: 16rpx; top: 16rpx;
  width: 36rpx; height: 36rpx;
  background: #5B6FE8;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}

/* 份数选择 */
.quantity-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 24rpx;
}

.quantity-btn {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
}

.quantity-btn.minus {
  background: #F0F2F5;
  color: #1A2332;
}

.quantity-btn.plus {
  background: #5B6FE8;
  color: #fff;
}

.quantity-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A2332;
  min-width: 60rpx;
  text-align: center;
}

/* 表单 */
.form-list { display: flex; flex-direction: column; }

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.form-item:last-child { border-bottom: none; }

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #8C97A6;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A2332;
}

/* 发票 */
.invoice-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.toggle-label { font-size: 28rpx; color: #1A2332; }

.invoice-form { padding-top: 20rpx; }

.invoice-type-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.type-btn {
  flex: 1;
  height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid #E8EBF0;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #8C97A6;
}

.type-btn.active {
  border-color: #5B6FE8;
  background: #5B6FE8;
  color: #fff;
}

/* 备注 */
.remark-input {
  width: 100%;
  min-height: 120rpx;
  background: #F8F7FC;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1A2332;
  box-sizing: border-box;
}

/* 价格明细 */
.price-summary {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-label { font-size: 28rpx; color: #8C97A6; }
.price-value { font-size: 28rpx; color: #1A2332; }

.price-row.total {
  border-top: 1rpx solid #F0F2F5;
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.price-row.total .price-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2332;
}

.price-row.total .price-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #F5222D;
}

/* 底部提交 */
.bottom-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgb(0 0 0 / 0.05);
}

.submit-btn {
  height: 88rpx;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
}

.submit-btn.disabled {
  background: #D5DDE8;
  pointer-events: none;
}

.submit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
