<view class="page">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">填写订单信息</text>
    <view class="nav-right"></view>
  </view>

  <!-- 登报内容摘要 -->
  <view class="content-summary" style="margin-top: {{navHeight}}px;">
    <view class="summary-header">
      <text class="summary-title">登报内容摘要</text>
    </view>
    <view class="summary-info">
      <text class="summary-type">{{businessType}}</text>
      <text class="summary-name">{{templateName}}</text>
      <text class="summary-chars">{{charCount}}字</text>
    </view>
  </view>

  <!-- 报纸选择 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">选择报纸</text>
      <text class="section-required">*</text>
    </view>
    <view class="paper-list">
      <view 
        class="paper-item {{selectedPaper.id === item.id ? 'selected' : ''}}" 
        wx:for="{{papers}}" 
        wx:key="id"
        bindtap="selectPaper"
        data-id="{{item.id}}"
      >
        <view class="paper-info">
          <text class="paper-name">{{item.name}}</text>
          <text class="paper-desc">{{item.desc}}</text>
        </view>
        <view class="paper-price">
          <text class="price-num">¥{{item.price}}</text>
          <text class="price-unit">/份</text>
        </view>
        <view class="paper-check" wx:if="{{selectedPaper.id === item.id}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 份数选择 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">份数</text>
    </view>
    <view class="quantity-row">
      <view class="quantity-btn minus" bindtap="adjustQuantity" data-type="minus">-</view>
      <text class="quantity-num">{{quantity}}</text>
      <view class="quantity-btn plus" bindtap="adjustQuantity" data-type="add">+</view>
    </view>
  </view>

  <!-- 收件信息 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">收件信息</text>
      <text class="section-required">*</text>
    </view>
    <view class="form-list">
      <view class="form-item">
        <text class="form-label">收件人</text>
        <input class="form-input" placeholder="请输入收件人姓名" value="{{contactName}}" bindinput="onNameInput" />
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="请输入手机号" value="{{contactPhone}}" bindinput="onPhoneInput" maxlength="11" />
      </view>
      <view class="form-item">
        <text class="form-label">详细地址</text>
        <input class="form-input" placeholder="省市区+详细地址" value="{{addressDetail}}" bindinput="onAddressInput" />
      </view>
    </view>
  </view>

  <!-- 发票信息 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">发票信息</text>
    </view>
    <view class="invoice-toggle">
      <text class="toggle-label">需要发票</text>
      <switch checked="{{needInvoice}}" bindchange="onInvoiceChange" color="#5B6FE8" />
    </view>
    <view class="invoice-form" wx:if="{{needInvoice}}">
      <view class="invoice-type-row">
        <view class="type-btn {{invoiceType === 'personal' ? 'active' : ''}}" bindtap="selectInvoiceType" data-type="personal">个人</view>
        <view class="type-btn {{invoiceType === 'company' ? 'active' : ''}}" bindtap="selectInvoiceType" data-type="company">企业</view>
      </view>
      <view class="form-item" wx:if="{{invoiceType === 'company'}}">
        <text class="form-label">发票抬头</text>
        <input class="form-input" placeholder="请输入企业名称" value="{{invoiceTitle}}" bindinput="onInvoiceTitleInput" />
      </view>
      <view class="form-item" wx:if="{{invoiceType === 'company'}}">
        <text class="form-label">税号</text>
        <input class="form-input" placeholder="请输入统一社会信用代码" value="{{taxNumber}}" bindinput="onTaxNumberInput" />
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">备注</text>
    </view>
    <textarea class="remark-input" placeholder="如有特殊要求请备注（选填）" value="{{remark}}" bindinput="onRemarkInput" maxlength="200" />
  </view>

  <!-- 价格明细 -->
  <view class="price-summary">
    <view class="price-row">
      <text class="price-label">报纸费用</text>
      <text class="price-value">¥{{unitPrice}} × {{quantity}}</text>
    </view>
    <view class="price-row total">
      <text class="price-label">合计</text>
      <text class="price-num">¥{{totalPrice}}</text>
    </view>
  </view>

  <!-- 底部提交按钮 -->
  <view class="bottom-bar">
    <view class="submit-btn {{canSubmit() ? '' : 'disabled'}}" bindtap="submitOrder">
      <text class="submit-text">提交订单</text>
    </view>
  </view>
</view>
