page {
  background: #F8F7FC;
  min-height: 100vh;
}
.banner {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  padding: 40rpx 32rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.banner-deco-circle {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.14), transparent 70%);
  right: 20rpx;
  top: 10rpx;
}
.banner-deco-circle2 {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 70% 70%, rgb(255 255 255 / 0.10), transparent 70%);
  left: 120rpx;
  bottom: 20rpx;
}
.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}
.banner-subtitle {
  font-size: 26rpx;
  color: rgb(255 255 255 / 0.9);
  display: block;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}
.banner-tags {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}
.banner-tag {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: rgb(255 255 255 / 0.9);
  background: rgb(255 255 255 / 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}
.template-section {
  padding: 24rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 10;
}
.template-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.template-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid #5B6FE8;
  box-shadow:
    0 0 0 1rpx rgba(167, 139, 250, 0.85) inset,
    0 4rpx 20rpx rgba(91, 111, 232, 0.10),
    0 1rpx 3rpx rgba(12, 26, 46, 0.04);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  display: flex;
  flex-direction: column;
  position: relative;
}
.template-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgb(91 111 232 / 0.12), 0 1rpx 2rpx rgb(12 26 46 / 0.03);
}
.template-card.selected {
  border-color: #5B6FE8;
  border-width: 2rpx;
  box-shadow:
    0 0 0 2rpx rgba(167, 139, 250, 0.70) inset,
    0 6rpx 24rpx rgba(91, 111, 232, 0.20),
    0 1rpx 3rpx rgba(12, 26, 46, 0.04);
}
.card-top {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
  position: relative;
  overflow: visible;
}
.card-top::before {
  content: '';
  position: absolute;
  left: -20rpx;
  top: -20rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--card-color, #A78BFA);
  opacity: 0.10;
  filter: blur(24rpx);
}
.card-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--card-color, #A78BFA);
  position: relative;
  z-index: 1;
  box-shadow: 0 2rpx 10rpx rgb(0 0 0 / 0.12);
}
.card-body {
  padding: 8rpx 24rpx 24rpx;
  background: #fff;
  flex: 1;
  position: relative;
}
.card-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A2332;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
}
.card-desc {
  font-size: 21rpx;
  color: #8C97A6;
  display: block;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-check {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: var(--card-color, #A78BFA);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 24rpx 0 16rpx;
  z-index: 3;
}
.check-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.template-card::after {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 8rpx;
  height: 4rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  opacity: 0.5;
}
.template-card + .doc-grid,
.doc-grid {
  /* 容器：grid 布局，保持原样 */
}

.doc-grid-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #5B6FE8;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-sizing: border-box;

  box-shadow:
    0 0 0 1rpx rgba(167, 139, 250, 0.55) inset,
    0 4rpx 20rpx rgba(91, 111, 232, 0.10),
    0 1rpx 3rpx rgba(12, 26, 46, 0.04);
}

.doc-grid-item:active {
  border-color: #5B6FE8;
  border-width: 2rpx;
  box-shadow:
    0 0 0 2rpx rgba(167, 139, 250, 0.70) inset,
    0 4rpx 16rpx rgba(91, 111, 232, 0.20),
    0 1rpx 2rpx rgba(12, 26, 46, 0.03);
}


/* Loading */
.loading-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(91, 111, 232, 0.15);
  border-top-color: #5B6FE8;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8c9dcc;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
