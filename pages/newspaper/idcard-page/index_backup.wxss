}

/* ========== 妯℃澘閫夋嫨鍖哄煙 ========== */
.template-section {
  padding: 24rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 10;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2332;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.section-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

/* ========== 妯℃澘鍗＄墖缃戞牸 ========== */
.template-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.template-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgb(91 111 232 / 0.10), 0 1rpx 3rpx rgb(12 26 46 / 0.04);
  border: 1rpx solid rgb(255 255 255 / 0.80);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  display: flex;
  flex-direction: column;
  position: relative;
}

.template-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgb(91 111 232 / 0.12), 0 1rpx 2rpx rgb(12 26 46 / 0.03);
}

.template-card.selected {
  border-color: rgb(91 111 232 / 0.30);
  box-shadow: 0 4rpx 20rpx rgb(91 111 232 / 0.15), 0 1rpx 3rpx rgb(12 26 46 / 0.04);
}

