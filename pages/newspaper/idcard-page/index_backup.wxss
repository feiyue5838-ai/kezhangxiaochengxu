/* ========== Banner ========== */
.banner {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  padding: 40rpx 32rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* 瑁呴グ锟? */
.banner-deco-circle { 
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.14), transparent 70%);
  right: 20rpx;
  top: 10rpx;
}

.banner-deco-circle2 { 
  position: absolute;
  width: 100rpx;
