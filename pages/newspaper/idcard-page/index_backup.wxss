  z-index: 1;
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgb(255 255 255 / 0.9);
  display: block;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.banner-tags {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.banner-tag {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: rgb(255 255 255 / 0.9);
  background: rgb(255 255 255 / 0.2);
