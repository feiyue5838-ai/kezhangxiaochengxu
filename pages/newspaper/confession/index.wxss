/* pages/newspaper/confession/index.wxss */

/* 与发票收据页面完全对�? */

/* ========== 页面基础 ========== */
.page {
  background: #F8F7FC;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  background: transparent;
}

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
  white-space: nowrap;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}

/* ========== 头部区域 ========== */
.header {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7, #9BA8FF);
  padding: 48rpx 40rpx 80rpx;
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -80rpx; right: -60rpx;
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.09);
}

.header::after {
  content: '';
  position: absolute;
  bottom: -40rpx; left: -30rpx;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.07);
}

.header-deco-circle {
  position: absolute;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.14), transparent 70%);
  right: 20rpx; top: 10rpx;
}

.header-deco-circle2 {
  position: absolute;
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 70% 70%, rgb(255 255 255 / 0.10), transparent 70%);
  left: 120rpx; bottom: 20rpx;
}

.header-content {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.header-text { flex: 1; }

.header-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgb(255 255 255 / 0.80);
  display: block;
}

/* ========== 主滚动区 ========== */
.main-scroll {
  flex: 1;
  min-height: 0;
}

/* ========== 分类2列网�?========== */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 24rpx 24rpx;
  margin-top: -56rpx;
  position: relative;
  z-index: 10;
}

.cat-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgb(91 111 232 / 0.10), 0 1rpx 3rpx rgb(12 26 46 / 0.04);
  border: 1rpx solid rgb(255 255 255 / 0.80);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  display: flex;
  flex-direction: column;
  position: relative;
}

.cat-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgb(91 111 232 / 0.12), 0 1rpx 2rpx rgb(12 26 46 / 0.03);
}

.cat-card:last-child:nth-child(odd) {
  grid-column: 1 / -1;
  flex-direction: row;
  align-items: stretch;
}

.cat-card:last-child:nth-child(odd) .cat-card-top {
  width: 120rpx;
  height: auto;
  flex-shrink: 0;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  border-radius: 24rpx 0 0 24rpx;
}
.cat-card:last-child:nth-child(odd) .cat-card-top::before { display: none; }
.cat-card:last-child:nth-child(odd) .cat-card-dot { width: 20rpx; height: 20rpx; }
.cat-card:last-child:nth-child(odd) .cat-card-badge { font-size: 22rpx; }

.cat-card:last-child:nth-child(odd) .cat-card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20rpx 28rpx 28rpx;
  position: relative;
  overflow: hidden;
}
.cat-card:last-child:nth-child(odd)::after { left: 28rpx; right: 28rpx; bottom: 8rpx; }

.cat-card-top {
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
  position: relative;
  overflow: hidden;
}

.cat-card-top::before {
  content: '';
  position: absolute;
  left: -20rpx; top: -20rpx;
  width: 160rpx; height: 160rpx;
  background: var(--cat-color, #5B6FE8);
  opacity: 0.10;
  border-radius: 50%;
  filter: blur(24rpx);
}

.cat-card-dot {
  width: 20rpx; height: 20rpx;
  border-radius: 50%;
  position: relative;
  z-index: 1;
  box-shadow: 0 2rpx 10rpx rgb(0 0 0 / 0.12);
}

.cat-card-badge {
  font-size: 21rpx;
  color: #fff;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 700;
  position: relative;
  z-index: 1;
  box-shadow: 0 2rpx 10rpx rgb(0 0 0 / 0.18);
}

.cat-card-body {
  padding: 8rpx 24rpx 24rpx;
  background: #fff;
  flex: 1;
}

.cat-card::after {
  content: '';
  position: absolute;
  left: 24rpx; right: 24rpx; bottom: 8rpx;
  height: 4rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, var(--cat-color, #5B6FE8), transparent);
  opacity: 0.5;
}

.cat-card-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A2332;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
}

.cat-card-desc {
  font-size: 21rpx;
  color: #8C97A6;
  display: block;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 底部弹窗 ========== */
.doc-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgb(0 0 0 / 0.45);
  z-index: 200;
  transition: opacity 0.3s ease;
}

.doc-picker {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 210;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 40rpx rgb(0 0 0 / 0.10);
}
.doc-picker--show { transform: translateY(0); }

.doc-picker-drag {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 0;
  flex-shrink: 0;
}

.drag-bar {
  width: 48rpx; height: 6rpx;
  background: #D5DDE8;
  border-radius: 4rpx;
}

.doc-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F2F5;
  flex-shrink: 0;
}

.doc-picker-title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
}

.doc-picker-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgb(0 0 0 / 0.10);
}

.doc-picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2332;
}

.doc-picker-subtitle {
  font-size: 24rpx;
  color: #8C97A6;
  margin-left: 12rpx;
}

.doc-picker-close {
  width: 56rpx; height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8C97A6;
  background: #F8F7FC;
  border-radius: 50%;
}



.doc-picker-body {
  flex: 1;
  padding: 0 32rpx 48rpx;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.doc-empty {
  padding: 60rpx 0;
  text-align: center;
}

.doc-empty-text {
  font-size: 26rpx;
  color: #8C97A6;
}

/* ========== 模板网格 ========== */
.doc-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 8rpx 0 40rpx;
}

.doc-grid-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgb(91 111 232 / 0.07), 0 1rpx 2rpx rgb(12 26 46 / 0.03);
  border: 1rpx solid rgb(255 255 255 / 0.70);
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-sizing: border-box;
}

.doc-grid-item:active {
  transform: scale(0.97);
  box-shadow: 0 1rpx 6rpx rgb(91 111 232 / 0.10), 0 1rpx 2rpx rgb(12 26 46 / 0.02);
}

.doc-grid-color {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 8rpx;
  width: 100%;
  border-radius: 20rpx 20rpx 0 0;
}

.doc-grid-content {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.doc-grid-name {
  font-size: 25rpx;
  color: #1A2332;
  font-weight: 500;
  line-height: 1.4;
  flex: 1;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}

/* ========== 浮动客服按钮 ========== */
.float-btn {
  position: fixed;
  right: 24rpx;
  z-index: 150;
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgb(91 111 232 / 0.35), 0 2rpx 8rpx rgb(12 26 46 / 0.06);
  animation: float-breathe 3s ease-in-out infinite;
}

@keyframes float-breathe {
  0%, 100% {
    box-shadow: 0 6rpx 24rpx rgb(91 111 232 / 0.35), 0 2rpx 8rpx rgb(12 26 46 / 0.06);
  }

  50% {
    box-shadow: 0 8rpx 32rpx rgb(91 111 232 / 0.45), 0 2rpx 10rpx rgb(12 26 46 / 0.08);
  }
}

.float-btn-icon {
  width: 38rpx;
  height: 38rpx;
}

