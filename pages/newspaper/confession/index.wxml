<!--pages/newspaper/confession/index.wxml-->
<view class="page">
  <!-- 自定义导航栏 -->
  <nav-bar title="真情告白" bind:back="goBack"></nav-bar>

  <!-- 头部区域 -->
  <view class="header">
    <view class="header-content">
      <view class="header-text">
        <text class="header-title">真情告白登报</text>
        <text class="header-desc">涵盖{{categories.length}}大类 ·  {{totalCount}}种告白模板</text>
      </view>
    </view>
    <view class="header-deco-circle"></view>
    <view class="header-deco-circle2"></view>
  </view>

  <!-- 主内容区 -->
  <scroll-view scroll-y class="main-scroll">
    <!-- 分类2列网格 -->
    <view class="cat-grid">
      <view
        class="cat-card"
        wx:for="{{categories}}"
        wx:key="name"
        bindtap="openDocPicker"
        data-index="{{index}}"
        style="--cat-color: {{item.color}};"
      >
        <view class="cat-card-top">
          <view class="cat-card-dot" style="background: {{item.color}};"></view>
          <text class="cat-card-badge" style="background: {{item.color}};">{{item.docs.length}}</text>
        </view>
        <view class="cat-card-body">
          <text class="cat-card-name">{{item.name}}</text>
          <text class="cat-card-desc">
            {{item.docs[0].name}}{{item.docs[1] ? '、' + item.docs[1].name : ''}}{{item.docs[2] ? '、' + item.docs[2].name : ''}}
          </text>
        </view>
      </view>
    </view>
    <view style="height: 40rpx;"></view>
  </scroll-view>

  <!-- 模板弹窗（底部半屏） -->
  <view class="doc-mask" wx:if="{{showDocPicker}}" bindtap="closeDocPicker"></view>
  <view class="doc-picker {{showDocPicker ? 'doc-picker--show' : ''}}">
    <!-- 拖拽区 -->
    <view class="doc-picker-drag"><view class="drag-bar"></view></view>
    <!-- 标题区 -->
    <view class="doc-picker-header">
      <view class="doc-picker-title-wrap">
        <view class="doc-picker-dot" style="background: {{categories[pickedIndex].color}};"></view>
        <text class="doc-picker-title">{{categories[pickedIndex].name}}</text>
        <text class="doc-picker-subtitle">{{pickedItems.length}}个模板</text>
      </view>
      <view class="doc-picker-close" bindtap="closeDocPicker"><text>✕</text></view>
    </view>
    <!-- 搜索框 -->
    
    <scroll-view scroll-y class="doc-picker-body" style="margin-top: 20rpx;">
      <view class="doc-grid">
        <view
          class="doc-grid-item"
          wx:for="{{pickedItems}}"
          wx:key="name"
          bindtap="selectItem"
          data-name="{{item.name}}"
          style="--cat-color: {{categories[pickedIndex].color}};"
        >
          <view class="doc-grid-color" style=""></view>
          <view class="doc-grid-content">
            <text class="doc-grid-name">{{item.name}}</text>
          </view>
        </view>
        <view class="doc-empty" wx:if="{{pickedItems.length === 0}}">
          <text class="doc-empty-text">没有找到匹配的模板</text>
        </view>
      </view>
    </scroll-view>
  </view>

</view>
