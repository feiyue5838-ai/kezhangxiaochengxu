<!-- pages/newspaper/paper.wxml -->
<view class="page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="nav-title">选择报纸</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 内容摘要 -->
  <view class="content-summary" style="margin-top: {{navHeight}}px;" wx:if="{{content}}">
    <text class="summary-label">登报内容</text>
    <text class="summary-text">{{content}}</text>
  </view>

  <!-- 报纸网格 -->
  <scroll-view scroll-y class="paper-scroll" style="padding-top: {{scrollPadding}}px;">
    <view class="section-header">
      <text class="section-title">请选择报纸</text>
      <text class="section-count">共{{papers.length}}家</text>
    </view>
    
    <view class="paper-grid">
      <view class="paper-card {{selectedPaper === item.id ? 'selected' : ''}}" 
        wx:for="{{papers}}" wx:key="id" 
        bindtap="selectPaper" data-id="{{item.id}}">
        
        <!-- Logo -->
        <view class="card-logo" style="background: linear-gradient(135deg, {{item.logoColor || '#5B6FE8'}} 0%, {{item.logoColorEnd || '#7B8FF7'}} 100%);">
          <text class="logo-text">{{item.logoText}}</text>
          <!-- 标签 -->
          <view class="card-tag" wx:if="{{item.tag}}" style="background: {{item.tagBg || 'rgba(255,255,255,0.25)'}}; color: #fff;">
            {{item.tag}}
          </view>
        </view>
        
        <!-- 信息区 -->
        <view class="card-body">
          <text class="card-name">{{item.name}}</text>
          <text class="card-price">¥{{item.price}}<text class="price-unit">/份</text></text>
          
          <!-- 选中标记 -->
          <view class="check-mark" wx:if="{{selectedPaper === item.id}}">
            <text style="font-size:24rpx;">&#10003;</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="price-info">
      <text class="price-label">应付金额</text>
      <text class="price-value">¥{{totalPrice}}</text>
    </view>
    <button class="submit-btn" bindtap="submitOrder" disabled="{{!selectedPaper}}">确认选择</button>
  </view>
</view>