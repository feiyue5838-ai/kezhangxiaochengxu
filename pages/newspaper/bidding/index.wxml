<view class="page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">招标公告</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- Banner -->
  <view class="banner" style="margin-top: {{navHeight}}px;">
    <view class="banner-deco-circle"></view>
    <view class="banner-deco-circle2"></view>
    <text class="banner-title">招标公告登报</text>
    <text class="banner-subtitle">涵盖{{categoryList.length}}大类 · 全类型招标模板</text>
    <view class="banner-tags">
      <view class="banner-tag"><image src="/assets/icons/icon-idcard-shield.svg" mode="aspectFit" class="tag-icon" />合规公示</view>
      <view class="banner-tag"><image src="/assets/icons/icon-idcard-check.svg" mode="aspectFit" class="tag-icon" />法律依据</view>
    </view>
  </view>

  <!-- 分类卡片网格 -->
  <view class="template-section">
    <view class="template-grid">
      <view class="template-card" wx:for="{{categoryList}}" wx:key="id"
        bindtap="openDocPicker" data-index="{{index}}">
        <view class="card-top" style="--card-color: {{item.color || '#5B6FE8'}}">
          <view class="card-dot" style="background: {{item.color || '#5B6FE8'}};"></view>
          <view class="card-count" style="background: {{item.color || '#5B6FE8'}};">{{item.docs.length}}</view>
        </view>
        <view class="card-body">
          <text class="card-name">{{item.name}}</text>
          <text class="card-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部弹窗 -->
  <view class="doc-mask" wx:if="{{showDocPicker}}" bindtap="closeDocPicker"></view>
  <view class="doc-picker {{showDocPicker ? 'doc-picker--show' : ''}}">
    <view class="doc-picker-drag"><view class="drag-bar"></view></view>
    <view class="doc-picker-header">
      <view class="doc-picker-title-wrap">
        <view class="doc-picker-dot" style="background: {{categoryList[pickedIndex].color}};"></view>
        <text class="doc-picker-title">{{categoryList[pickedIndex].name}}</text>
        <text class="doc-picker-subtitle">{{pickedItems.length}}个模板</text>
      </view>
      <view class="doc-picker-close" bindtap="closeDocPicker"><text>✕</text></view>
    </view>
    
    <scroll-view scroll-y class="doc-picker-body" style="margin-top: 20rpx;">
      <view class="doc-grid">
        <view class="doc-grid-item" wx:for="{{pickedItems}}" wx:key="name"
          bindtap="selectItem" data-name="{{item.name}}"
          style="--cat-color: {{categoryList[pickedIndex].color}};">
          <view class="doc-grid-color" style=""></view>
          <view class="doc-grid-content">            <text class="doc-grid-name">{{item.name}}</text>
          </view>
        </view>
        <view class="doc-empty" wx:if="{{pickedItems.length === 0}}">
          <text class="doc-empty-text">没有找到匹配的模板</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
