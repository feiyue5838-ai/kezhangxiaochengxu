<view class="page">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-back" bindtap="goHome">‹</view>
    <text class="nav-title">订单详情</text>
    <view class="nav-right"></view>
  </view>

  <!-- 订单状态 -->
  <view class="status-banner" style="margin-top: {{navHeight}}px;">
    <view class="status-icon {{status}}"></view>
    <view class="status-info">
      <text class="status-text" style="color: {{statusColor}};">{{statusText}}</text>
      <text class="status-desc">您的订单正在处理中</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info-bar">
    <text class="order-id">订单号: {{orderId}}</text>
    <text class="order-time">{{createTime}}</text>
  </view>

  <!-- 主要内容区域 -->
  <view class="main-content">
    
    <!-- 登报内容卡片 -->
    <view class="content-card">
      <view class="card-header">
        <text class="card-title">登报内容</text>
      </view>
      <view class="card-body">
        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">业务类型</text>
            <text class="info-value">{{businessType}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">证件名称</text>
            <text class="info-value">{{templateName}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">字数</text>
            <text class="info-value">{{charCount}}字</text>
          </view>
        </view>
        <view class="content-preview">
          <text class="preview-label">内容预览</text>
          <text class="preview-text">{{content}}</text>
        </view>
      </view>
    </view>

    <!-- 报纸信息卡片 -->
    <view class="content-card">
      <view class="card-header">
        <text class="card-title">报纸信息</text>
      </view>
      <view class="card-body">
        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">报纸名称</text>
            <text class="info-value">{{selectedPaper.name}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">份数</text>
            <text class="info-value">×{{quantity}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">单价</text>
            <text class="info-value price">¥{{unitPrice}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 收件信息卡片 -->
    <view class="content-card">
      <view class="card-header">
        <text class="card-title">收件信息</text>
      </view>
      <view class="card-body">
        <view class="address-block">
          <text class="address-name">{{contactName}}</text>
          <text class="address-phone">{{contactPhone}}</text>
        </view>
        <text class="address-detail">{{addressDetail}}</text>
      </view>
    </view>

    <!-- 发票信息卡片 -->
    <view class="content-card" wx:if="{{needInvoice}}">
      <view class="card-header">
        <text class="card-title">发票信息</text>
      </view>
      <view class="card-body">
        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">发票类型</text>
            <text class="info-value">{{invoiceType === 'personal' ? '个人' : '企业'}}</text>
          </view>
          <view class="info-item" wx:if="{{invoiceType === 'company'}}">
            <text class="info-label">发票抬头</text>
            <text class="info-value">{{invoiceTitle}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 金额汇总 -->
    <view class="amount-card">
      <view class="amount-row">
        <text class="amount-label">报纸费用</text>
        <text class="amount-value">¥{{unitPrice}} × {{quantity}}</text>
      </view>
      <view class="amount-row">
        <text class="amount-label">运费</text>
        <text class="amount-value">¥0</text>
      </view>
      <view class="amount-row total">
        <text class="amount-label">实付金额</text>
        <text class="amount-num">¥{{totalPrice}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <view class="action-btn secondary" bindtap="viewNewspaperStyle">
        <text class="btn-text">查看报纸样式</text>
      </view>
      <view class="action-btn primary" bindtap="contactService">
        <text class="btn-text">联系客服</text>
      </view>
    </view>
  </view>
</view>
