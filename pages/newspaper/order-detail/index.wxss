/* pages/newspaper/order-detail/index.wxss */
.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
}

.nav-back {
  width: 60rpx; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: #fff; font-weight: 300;
}

.nav-title {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx; font-weight: 600; color: #fff;
}



.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
.nav-right { width: 60rpx; }

.page { background: #F8F7FC; min-height: 100vh; }

/* 状态横幅 */
.status-banner {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.status-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
}

.status-icon.pending {
  background: rgba(255,176,32,0.2);
}

.status-icon.pending::after {
  content: '⏳';
  font-size: 40rpx;
}

.status-icon.approved,
.status-icon.completed {
  background: rgba(82,196,26,0.2);
}

.status-info { flex: 1; }

.status-text {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-top: 8rpx;
}

/* 订单信息栏 */
.order-info-bar {
  background: #fff;
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-id {
  font-size: 26rpx;
  color: #8C97A6;
}

.order-time {
  font-size: 24rpx;
  color: #8C97A6;
}

/* 主要内容 */
.main-content {
  padding: 20rpx;
}

/* 内容卡片 */
.content-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2332;
}

.card-body { padding: 24rpx; }

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.info-item { text-align: center; }

.info-label {
  font-size: 24rpx;
  color: #8C97A6;
  display: block;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2332;
  display: block;
}

.info-value.price { color: #F5222D; }

/* 内容预览 */
.content-preview {
  padding: 20rpx;
  background: #F8F7FC;
  border-radius: 12rpx;
}

.preview-label {
  font-size: 24rpx;
  color: #8C97A6;
  display: block;
  margin-bottom: 8rpx;
}

.preview-text {
  font-size: 26rpx;
  color: #1A2332;
  line-height: 1.6;
  display: block;
}

/* 地址块 */
.address-block {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2332;
}

.address-phone {
  font-size: 28rpx;
  color: #8C97A6;
}

.address-detail {
  font-size: 28rpx;
  color: #1A2332;
  line-height: 1.5;
  display: block;
}

/* 金额卡片 */
.amount-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.amount-label { font-size: 28rpx; color: #8C97A6; }
.amount-value { font-size: 28rpx; color: #1A2332; }

.amount-row.total {
  border-top: 1rpx solid #F0F2F5;
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.amount-row.total .amount-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2332;
}

.amount-row.total .amount-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #F5222D;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
}

.action-btn.secondary {
  background: #F0F2F5;
}

.action-btn.primary {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn.secondary .btn-text { color: #1A2332; }
.action-btn.primary .btn-text { color: #fff; }
