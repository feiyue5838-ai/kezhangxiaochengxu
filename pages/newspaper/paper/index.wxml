<!-- pages/newspaper/paper/index.wxml -->
<view class="page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-back" bindtap="goBack"><text>‹</text></view>
    <text class="nav-title">选择报纸</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 报纸列表 -->
  <view class="paper-list" style="margin-top: {{navHeight}}px;">
    <view class="paper-header">
      <text class="paper-title">选择刊登报纸</text>
      <text class="paper-desc">不同报纸价格不同，请选择</text>
    </view>

    <view class="paper-options">
      <view 
        class="paper-option {{selectedNewspaper === item.id ? 'selected' : ''}}"
        wx:for="{{newspapers}}"
        wx:key="id"
        bindtap="selectNewspaper"
        data-id="{{item.id}}"
      >
        <view class="paper-info">
          <text class="paper-name">{{item.name}}</text>
          <text class="paper-desc">{{item.desc}}</text>
        </view>
        <view class="paper-price">
          <text class="price-num">{{item.price}}</text>
          <text class="price-unit">元/字</text>
        </view>
        <view class="paper-check" wx:if="{{selectedNewspaper === item.id}}">✓</view>
      </view>
    </view>

    <!-- 字数统计 -->
    <view class="char-stat">
      <text class="stat-label">登报内容字数：</text>
      <text class="stat-value">{{charCount}} 字</text>
    </view>

    <!-- 费用估算 -->
    <view class="cost-estimate" wx:if="{{selectedNewspaper}}">
      <text class="cost-label">预估费用：</text>
      <text class="cost-value">¥ {{estimatedCost}}</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <view class="btn-submit {{selectedNewspaper ? '' : 'disabled'}}" bindtap="confirmSelection">
      <text>确认选择</text>
    </view>
  </view>
</view>
