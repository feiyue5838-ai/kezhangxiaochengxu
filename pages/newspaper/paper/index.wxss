/* pages/newspaper/paper/index.wxss */
.page {
  background: #F8F7FC;
  min-height: 100vh;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #5B6FE8 0%, #7B8FF7 100%);
}

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

.paper-list {
  padding: 32rpx;
}

.paper-header {
  margin-bottom: 32rpx;
}

.paper-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A202C;
  display: block;
  margin-bottom: 8rpx;
}

.paper-desc {
  font-size: 26rpx;
  color: #8896B3;
  display: block;
}

.paper-options {
  margin-bottom: 32rpx;
}

.paper-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.08);
  position: relative;
}

.paper-option.selected {
  border: 2rpx solid #5B6FE8;
  background: #F0F5FF;
}

.paper-info {
  flex: 1;
  min-width: 0;
}

.paper-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A202C;
  display: block;
  margin-bottom: 8rpx;
}

.paper-desc {
  font-size: 24rpx;
  color: #8896B3;
  display: block;
}

.paper-price {
  margin-left: 20rpx;
  text-align: right;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #5B6FE8;
  display: block;
}

.price-unit {
  font-size: 22rpx;
  color: #8896B3;
}

.paper-check {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  background: #5B6FE8;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.char-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #8896B3;
}

.stat-value {
  font-size: 26rpx;
  color: #1A202C;
  font-weight: 500;
}

.cost-estimate {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 120rpx;
}

.cost-label {
  font-size: 26rpx;
  color: #8896B3;
}

.cost-value {
  font-size: 32rpx;
  color: #5B6FE8;
  font-weight: 700;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgb(0 0 0 / 0.05);
}

.btn-submit {
  background: linear-gradient(135deg, #5B6FE8 0%, #7B8FF7 100%);
  color: #fff;
  border-radius: 44rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-submit.disabled {
  opacity: 0.5;
}
