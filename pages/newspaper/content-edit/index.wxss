/* content-edit.wxss - 填写登报内容页面 */

/* ========== 页面整体 ========== */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F8F7FC;
}

/* ========== 导航栏（固定顶部） ========== */
.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
}

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
  white-space: nowrap;
}

.nav-placeholder { width: 60rpx; height: 100%; }
.nav-right { width: 60rpx; height: 100%; }

/* ========== 可滚动内容区 ========== */
.content-scroll {
  flex: 1;
  height: 0;
  padding-top: 0;
}

/* ========== 信息回显模块 ========== */
.info-display {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.info-row:last-child { border-bottom: none; }

.info-label { font-size: 28rpx; color: #8C97A6; }
.info-value { font-size: 28rpx; color: #1A2332; font-weight: 500; }

/* ========== 登报内容编辑模块 ========== */
.content-editor {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
}

.editor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.editor-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2332;
}

.editor-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #5B6FE8;
}

.action-divider {
  color: #D5DDE8;
  font-size: 26rpx;
}

/* 编辑区容器 */
.editor-box {
  position: relative;
  width: 100%;
  min-height: 400rpx;
  background: #F8F7FC;
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 占位提示 */
.editor-placeholder {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  font-size: 28rpx;
  color: #C0C8D4;
  line-height: 1.8;
  pointer-events: none;
  z-index: 0;
}

/* 可编辑区 */
.editor-inner {
  width: 100%;
  min-height: 360rpx;
  font-size: 28rpx;
  color: #1A2332;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
  outline: none;
  -webkit-user-select: text;
  overflow-wrap: break-word;
}

.editor-box.empty .editor-inner {
  color: transparent;
  caret-color: #1A2332;
}

.editor-footer {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 0;
}

.char-count {
  font-size: 24rpx;
  color: #8C97A6;
}

/* 便捷替换按钮 */
.replace-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.replace-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
}

.replace-icon { font-size: 28rpx; }
.replace-text { font-size: 26rpx; color: #fff; font-weight: 500; }

.editor-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #FFF9E6;
  border-radius: 12rpx;
  border-left: 4rpx solid #FFB800;
}

.tip-text {
  font-size: 24rpx;
  color: #8B6914;
  line-height: 1.5;
}

/* ========== 信息填写说明模块 ========== */
.note-section {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
}

.note-item { margin-bottom: 24rpx; }
.note-item:last-child { margin-bottom: 0; }

.note-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2332;
  margin-bottom: 8rpx;
}

.note-desc {
  display: block;
  font-size: 24rpx;
  color: #8C97A6;
  line-height: 1.5;
  margin-top: 8rpx;
}

/* ========== 底部操作按钮区 ========== */
.bottom-actions {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.action-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-button.preview {
  background: #F0F2F5;
  color: #1A2332;
}

.action-button.submit {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  color: #fff;
}

.action-button.submit.disabled {
  background: #D5DDE8;
  color: #8C97A6;
  pointer-events: none;
}

.button-text {
  font-size: 30rpx;
  font-weight: 600;
}

/* ========== 预览弹窗 ========== */
.preview-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 900;
}

.preview-panel {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  max-height: 75vh;
  background: #fff;
  border-radius: 24rpx;
  z-index: 901;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2332;
}

.preview-close {
  font-size: 28rpx;
  color: #8C97A6;
  padding: 8rpx;
}

.preview-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.preview-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.preview-meta-label {
  font-size: 24rpx;
  color: #5B6FE8;
  font-weight: 500;
}

.preview-meta-count {
  font-size: 22rpx;
  color: #8C97A6;
}

.preview-divider {
  height: 1rpx;
  background: #E8ECF1;
  margin-bottom: 20rpx;
}

.preview-text {
  background: #FAFBFC;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #1A2332;
  word-break: keep-all;
  white-space: pre-wrap;
}

.preview-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0F2F5;
}

.preview-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: #F0F2F5;
  color: #1A2332;
}

.preview-btn-primary {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  color: #fff;
}
