.page { background: #F8F7FC; min-height: 100vh; padding-bottom: 160rpx; }

/* 加载中 / 空状态 */
.loading-wrap, .empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-text, .empty-text {
  font-size: 30rpx;
  color: #8C97A6;
  margin-bottom: 32rpx;
}
.back-btn {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 60rpx;
  border: none;
}
.back-btn::after { border: none; }

/* 状态卡 */
.status-card { margin: 24rpx; padding: 40rpx; border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; }
.status-card.pending { background: linear-gradient(135deg, #5B6FE8, #A78BFA); }
.status-card.processing { background: linear-gradient(135deg, #5B6FE8, #A78BFA); }
.status-card.completed { background: linear-gradient(135deg, #52C41A, #73D13D); }
.status-card.cancelled { background: linear-gradient(135deg, #999, #bbb); }
.status-icon { width: 48rpx; height: 48rpx; margin-bottom: 12rpx; }
.status-text { font-size: 32rpx; font-weight: bold; color: #fff; }

/* 信息卡 */
.info-card { margin: 0 24rpx 24rpx; padding: 30rpx; background: white; border-radius: 20rpx; }
.info-title { font-size: 30rpx; font-weight: bold; color: #1A2332; margin-bottom: 24rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #F8F7FC; }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; }
.info-label { font-size: 28rpx; color: #8C97A6; }
.info-value { font-size: 28rpx; color: #1A2332; }
.info-value.price { color: #7B5CFA; font-weight: bold; }
.content-text { font-size: 28rpx; color: #1A2332; line-height: 1.8; }

/* 上传证件图片 */
.cert-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.cert-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #F2F1F7;
  border: 1rpx solid #ECEAF3;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  display: flex;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgb(0 0 0 / 0.1);
  z-index: 99;
}

.cancel-btn {
  flex: 1;
  background: white;
  color: #8C97A6;
  font-size: 30rpx;
  border: 2rpx solid #D5DDE8;
  border-radius: 20rpx;
  padding: 20rpx 0;
  text-align: center;
}

.pay-btn, .complete-btn {
  flex: 1;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  color: white;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 0;
  text-align: center;
}

.pay-btn::after, .complete-btn::after { border: none; }

.aftersale-btn {
  flex: 1;
  background: #fff;
  color: #7B5CFA;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #7B5CFA;
  border-radius: 20rpx;
  padding: 20rpx 0;
  text-align: center;
}

.aftersale-btn::after { border: none; }

.delete-btn {
  flex: 1;
  background: #fff;
  color: #FF4D4F;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #FF4D4F;
  border-radius: 20rpx;
  padding: 20rpx 0;
  text-align: center;
}

.delete-btn::after { border: none; }
