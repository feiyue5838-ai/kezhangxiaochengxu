.page { background: #F8F7FC; min-height: 100vh; padding-bottom: 160rpx; }

.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
}
.nav-left { display: flex; align-items: center; }
.back-btn { width: 60rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: white; margin-right: 20rpx; }
.nav-title { font-size: 34rpx; font-weight: bold; color: white; }



.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
.status-card { margin: 24rpx; padding: 40rpx; border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; }
.status-card.pending { background: linear-gradient(135deg, #5B6FE8, #7B8FF7); }
.status-card.processing { background: linear-gradient(135deg, #5B6FE8, #7B8FF7); }
.status-card.completed { background: linear-gradient(135deg, #5B6FE8, #7B8FF7); }
.status-icon { width: 48rpx; height: 48rpx; margin-bottom: 12rpx; }
.status-text { font-size: 32rpx; font-weight: bold; color: #1A2332; }

.info-card { margin: 0 24rpx 24rpx; padding: 30rpx; background: white; border-radius: 20rpx; }
.info-title { font-size: 30rpx; font-weight: bold; color: #1A2332; margin-bottom: 24rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #F8F7FC; }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; }
.info-label { font-size: 28rpx; color: #8C97A6; }
.info-value { font-size: 28rpx; color: #1A2332; }
.info-value.price { color: #5B6FE8; font-weight: bold; }
.content-text { font-size: 28rpx; color: #1A2332; line-height: 1.8; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: white; display: flex; padding: 20rpx 30rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); gap: 24rpx; box-shadow: 0 -4rpx 20rpx rgb(0 0 0 / 0.1); z-index: 99; 
  transition: all 0.3s ease;
}
.cancel-btn { flex: 1; background: white; color: #8C97A6; font-size: 30rpx; border: 2rpx solid #D5DDE8; border-radius: 20rpx; padding: 20rpx 0; text-align: center; }
.pay-btn { flex: 1; background: #5B6FE8; color: white; font-size: 30rpx; font-weight: bold; border: none; border-radius: 20rpx; padding: 20rpx 0; text-align: center; }
.pay-btn::after { border: none; }

