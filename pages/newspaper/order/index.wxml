<view class="page">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">确认订单</text>
    <view class="nav-right"></view>
  </view>

  <!-- 订单内容区域 -->
  <view class="order-content" style="margin-top: {{navHeight}}px;">
    
    <!-- 登报内容卡片 -->
    <view class="order-card">
      <view class="card-header">
        <text class="card-title">登报内容</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">业务类型</text>
          <text class="info-value">{{businessType}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">证件名称</text>
          <text class="info-value">{{templateName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">字数统计</text>
          <text class="info-value">{{charCount}}字</text>
        </view>
        <view class="content-preview">
          <text class="preview-label">内容预览</text>
          <text class="preview-text">{{content}}</text>
        </view>
      </view>
    </view>

    <!-- 报纸信息卡片 -->
    <view class="order-card">
      <view class="card-header">
        <text class="card-title">报纸信息</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">报纸名称</text>
          <text class="info-value">{{selectedPaper.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">报纸描述</text>
          <text class="info-value">{{selectedPaper.desc}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">份数</text>
          <text class="info-value">×{{quantity}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">单价</text>
          <text class="info-value price">¥{{unitPrice}}</text>
        </view>
      </view>
    </view>

    <!-- 收件信息卡片 -->
    <view class="order-card">
      <view class="card-header">
        <text class="card-title">收件信息</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">收件人</text>
          <text class="info-value">{{contactName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">手机号</text>
          <text class="info-value">{{contactPhone}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">详细地址</text>
          <text class="info-value address">{{addressDetail}}</text>
        </view>
      </view>
    </view>

    <!-- 发票信息卡片 -->
    <view class="order-card" wx:if="{{needInvoice}}">
      <view class="card-header">
        <text class="card-title">发票信息</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">发票类型</text>
          <text class="info-value">{{invoiceType === 'personal' ? '个人' : '企业'}}</text>
        </view>
        <view class="info-row" wx:if="{{invoiceType === 'company'}}">
          <text class="info-label">发票抬头</text>
          <text class="info-value">{{invoiceTitle}}</text>
        </view>
        <view class="info-row" wx:if="{{invoiceType === 'company'}}">
          <text class="info-label">税号</text>
          <text class="info-value">{{taxNumber}}</text>
        </view>
      </view>
    </view>

    <!-- 备注卡片 -->
    <view class="order-card" wx:if="{{remark}}">
      <view class="card-header">
        <text class="card-title">备注</text>
      </view>
      <view class="card-body">
        <text class="remark-text">{{remark}}</text>
      </view>
    </view>

    <!-- 价格汇总 -->
    <view class="price-card">
      <view class="price-row">
        <text class="price-label">报纸费用</text>
        <text class="price-value">¥{{unitPrice}} × {{quantity}}</text>
      </view>
      <view class="price-row total">
        <text class="price-label">合计金额</text>
        <text class="price-num">¥{{totalPrice}}</text>
      </view>
    </view>

    <!-- 平台承诺 -->
    <view class="promise-section">
      <view class="promise-item">
        <text class="promise-icon">✓</text>
        <text class="promise-text">100%有效，审核通过后再付款</text>
      </view>
      <view class="promise-item">
        <text class="promise-icon">✓</text>
        <text class="promise-text">正规发票，正规报纸</text>
      </view>
      <view class="promise-item">
        <text class="promise-icon">✓</text>
        <text class="promise-text">不满意可退款</text>
      </view>
    </view>
  </view>

  <!-- 底部提交按钮 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{totalPrice}}</text>
    </view>
    <view class="submit-btn {{isSubmitting ? 'loading' : ''}}" bindtap="submitOrder">
      <text class="submit-text">{{isSubmitting ? '提交中...' : '提交订单'}}</text>
    </view>
  </view>
</view>
