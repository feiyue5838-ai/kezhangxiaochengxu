<!-- pages/newspaper/company-docs/list.wxml -->
<view class="page">
  <!-- 自定义导航栏 -->
  <nav-bar title="{{categoryName}}" bind:back="goBack" />

  <!-- 搜索栏 -->
  <view class="search-wrap">
    <view class="search-bar">
      <input class="search-input" placeholder="搜索证件类型" placeholder-class="search-placeholder" bindinput="onSearch" value="{{searchKey}}" />
      <text>✓</text>
    </view>
  </view>

  <!-- 证件网格 -->
  <scroll-view scroll-y class="doc-scroll">
    <view class="doc-grid">
      <view class="doc-card" wx:for="{{filteredDocs}}" wx:key="name" bindtap="selectDoc" data-doc="{{item}}"
        style="--cat-color: {{categoryColor}};">
        <view class="doc-icon-wrap">
          <text>✓</text>
        </view>
        <view class="doc-info">
          <text class="doc-name">{{item.name}}</text>
        </view>
        <text class="doc-arrow">›</text>
      </view>
    </view>

    <!-- 无搜索结果 -->
    <view class="empty-state" wx:if="{{searchKey && filteredDocs.length === 0}}">
      <text>✓</text>
      <text class="empty-text">未找到"{{searchKey}}"相关证件</text>
    </view>
  </scroll-view>
</view>
