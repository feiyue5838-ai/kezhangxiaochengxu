<view class="page">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{empty}}" class="empty">
    <text>暂无订单</text>
  </view>

  <view wx:else class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="card-hd">
        <text class="order-no">{{item.orderNo || item.id}}</text>
        <text class="status">{{item.statusText || '待处理'}}</text>
      </view>
      <view class="card-bd">
        <view class="row">
          <text class="label">公司名称</text>
          <text class="value">{{item.companyName || '-'}}</text>
        </view>
        <view class="row">
          <text class="label">印章类型</text>
          <text class="value">{{item.sealType || '-'}}</text>
        </view>
        <view class="row">
          <text class="label">创建时间</text>
          <text class="value">{{item.createdAt || '-'}}</text>
        </view>
      </view>
      <view class="card-ft">
        <text class="hint">点击查看详情</text>
      </view>
    </view>
  </view>
</view>
