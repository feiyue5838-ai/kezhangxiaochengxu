.page {
  padding: 24rpx;
  background: #f5f6f7;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading, .empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #999;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.order-no {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.status {
  font-size: 24rpx;
  color: #1890ff;
  padding: 4rpx 12rpx;
  background: #e6f7ff;
  border-radius: 6rpx;
}

.card-bd {
  padding: 16rpx 0;
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 40rpx;
}

.label {
  color: #999;
}

.value {
  color: #333;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-ft {
  padding-top: 12rpx;
  text-align: right;
}

.hint {
  font-size: 24rpx;
  color: #1890ff;
}
