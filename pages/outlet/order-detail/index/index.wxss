.page {
  padding: 24rpx;
  background: #f5f6f7;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #999;
  font-size: 28rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 44rpx;
}

.label {
  color: #999;
}

.value {
  color: #333;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.receipts {
  margin-top: 12rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.receipts-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.receipt-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.actions {
  margin-top: 24rpx;
}

.upload-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

.upload-btn[disabled] {
  background: #b3d9ff;
}
