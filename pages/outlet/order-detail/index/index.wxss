.page {
  padding: 24rpx;
  background: #f5f6f7;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #999;
  font-size: 28rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  line-height: 44rpx;
}

.label {
  color: #999;
}

.value {
  color: #333;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.receipts {
  margin-top: 12rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.receipts-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.receipt-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.actions {
  margin-top: 24rpx;
}

.upload-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

.upload-btn[disabled] {
  background: #b3d9ff;
}

/* 状态进度条 */
.steps {
  background: #fff;
  border-radius: 12rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  position: relative;
}

.step-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: calc(50% + 16rpx);
  right: calc(-50% + 16rpx);
  height: 4rpx;
  background: #e0e0e0;
}

.step-item.active::after {
  background: #7B5CFA;
}

.step-item.active .step-dot {
  background: #7B5CFA;
  border-color: #7B5CFA;
}

.step-item.current .step-dot {
  background: #fff;
  border-color: #7B5CFA;
}

.step-item.current .step-dot::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  background: #7B5CFA;
  border-radius: 50%;
}

.step-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #e0e0e0;
  border: 4rpx solid #e0e0e0;
  position: relative;
  box-sizing: border-box;
  transition: all 0.2s;
}

.step-label {
  font-size: 22rpx;
  color: #999;
}

.step-item.active .step-label {
  color: #7B5CFA;
}

/* 状态标签 */
.status-tag {
  color: #fff;
  background: #7B5CFA;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

/* 操作按钮 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #7B5CFA;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  margin-bottom: 20rpx;
}

.btn-primary[disabled] {
  background: #c8b8ff;
}

.btn-upload {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #7B5CFA;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 2rpx solid #7B5CFA;
}

.btn-upload[disabled] {
  color: #c8b8ff;
  border-color: #c8b8ff;
}

.done-tip {
  text-align: center;
  color: #52c41a;
  font-size: 28rpx;
  padding: 20rpx 0;
  font-weight: 600;
}
