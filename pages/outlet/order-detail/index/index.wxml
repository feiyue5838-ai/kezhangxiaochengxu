<view class="page">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{order}}" class="content">
    <view class="section">
      <view class="sec-title">订单信息</view>
      <view class="row"><text class="label">订单编号</text><text class="value">{{order.orderNo}}</text></view>
      <view class="row"><text class="label">公司名称</text><text class="value">{{order.companyName}}</text></view>
      <view class="row"><text class="label">印章类型</text><text class="value">{{order.sealType || '-'}}</text></view>
      <view class="row"><text class="label">状态</text><text class="value">{{order.statusText || '待处理'}}</text></view>
      <view class="row"><text class="label">创建时间</text><text class="value">{{order.createdAt}}</text></view>
    </view>

    <view class="section">
      <view class="sec-title">交付回执</view>
      <view class="receipts">
        <view wx:if="{{receipts.length === 0}}" class="empty-tip">
          <text>暂无回执，点击下方按钮上传</text>
        </view>
        <view wx:else class="receipts-grid">
          <image
            wx:for="{{receipts}}" wx:key="id"
            class="receipt-img"
            src="{{item.url}}"
            mode="aspectFill"
            bindtap="previewImage"
            data-url="{{item.url}}"
          />
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="upload-btn" bindtap="chooseAndUpload" disabled="{{uploading}}">
        {{uploading ? '上传中...' : '上传回执图片'}}
      </button>
    </view>
  </view>
</view>
