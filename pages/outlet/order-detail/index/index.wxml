<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 订单内容 -->
  <view wx:elif="{{order}}" class="content">

    <!-- 状态进度条 -->
    <view class="steps">
      <view
        wx:for="{{[2, 3, 4]}}"
        wx:key="index"
        class="step-item {{order.status >= item ? 'active' : ''}} {{currentStep === index ? 'current' : ''}}"
      >
        <view class="step-dot"></view>
        <text class="step-label">{{index === 0 ? '已支付' : index === 1 ? '制作中' : '已发货'}}</text>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="section">
      <view class="sec-title">订单信息</view>
      <view class="row"><text class="label">订单编号</text><text class="value">{{order.orderNo}}</text></view>
      <view class="row"><text class="label">公司名称</text><text class="value">{{order.companyName}}</text></view>
      <view class="row"><text class="label">印章类型</text><text class="value">{{order.type || '-'}}</text></view>
      <view class="row"><text class="label">订单状态</text><text class="value status-tag">{{order.statusText || '待处理'}}</text></view>
      <view class="row" wx:if="{{order.expressNo}}"><text class="label">快递单号</text><text class="value">{{order.expressNo}}</text></view>
      <view class="row"><text class="label">创建时间</text><text class="value">{{order.createdAt}}</text></view>
    </view>

    <!-- 客户信息 -->
    <view class="section" wx:if="{{order.user}}">
      <view class="sec-title">客户信息</view>
      <view class="row"><text class="label">昵称</text><text class="value">{{order.user.nickname || '-'}}</text></view>
      <view class="row"><text class="label">手机号</text><text class="value">{{order.user.phone || '-'}}</text></view>
    </view>

    <!-- 交付回执 -->
    <view class="section">
      <view class="sec-title">交付回执</view>
      <view wx:if="{{receipts.length === 0}}" class="empty-tip">
        <text>暂无回执，点击下方按钮上传</text>
      </view>
      <view wx:else class="receipts-grid">
        <image
          wx:for="{{receipts}}"
          wx:key="id"
          class="receipt-img"
          src="{{item.url}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-url="{{item.url}}"
        />
      </view>
    </view>

    <!-- 操作按钮（根据状态显示） -->
    <view class="actions">
      <!-- 已支付待接单：sealOrder.status=2 -->
      <button
        wx:if="{{order.status === 2}}"
        class="btn-primary"
        bindtap="onAccept"
        disabled="{{actionLoading}}"
      >{{actionLoading ? '处理中...' : '确认接单'}}</button>

      <!-- 制作中：status=3 -->
      <block wx:if="{{order.status === 3}}">
        <button
          wx:if="{{order.statusText !== '制作完成待发货'}}"
          class="btn-primary"
          bindtap="onComplete"
          disabled="{{actionLoading}}"
        >{{actionLoading ? '处理中...' : '完成制作'}}</button>
        <button
          wx:if="{{order.statusText === '制作完成待发货'}}"
          class="btn-primary"
          bindtap="onShip"
          disabled="{{actionLoading}}"
        >{{actionLoading ? '处理中...' : '确认发货'}}</button>
      </block>

      <!-- 已发货 -->
      <view wx:if="{{order.status === 4}}" class="done-tip">
        <text>已完成</text>
      </view>

      <!-- 上传回执（待接单/制作中/已发货都可上传） -->
      <button
        wx:if="{{order.status !== 4}}"
        class="btn-upload"
        bindtap="chooseAndUpload"
        disabled="{{uploading}}"
      >{{uploading ? '上传中...' : '上传回执图片'}}</button>
    </view>

  </view>
</view>
