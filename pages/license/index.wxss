/* pages/license/index.wxss */

/* ========== 瀵艰埅鏍?========== */

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-side {
  position: absolute;
  top: 0; bottom: 0;
  display: flex;
  align-items: center;
}
.nav-side--left  { left: 32rpx; }
.nav-side--right { right: 32rpx; }

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
page {
  background: #F8F7FC;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.page {
  background: #F8F7FC;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ========== Banner ========== */
.banner {
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
}

.banner-subtitle {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  display: block;
  letter-spacing: 2rpx;
}

.banner-tags {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.banner-tag {
  background: rgb(255 255 255 / 0.25);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgb(255 255 255 / 0.4);
}

.banner-tag-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

/* ========== 鏈嶅姟鍒楄〃 ========== */
.service-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 30rpx;
}

.service-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgb(91 111 232 / 0.06);
  position: relative;
  transition: all 0.3s ease;
}

/* SVG 鍥炬爣 */
.service-icon-img {
  width: 48rpx;
  height: 48rpx;
}

/* 鍥炬爣鑳屾櫙瀹瑰櫒 */
.svc-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
}

.service-name {
  font-size: 30rpx;
  color: #1A202C;
  font-weight: 500;
  text-align: center;
}

.service-arrow {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 32rpx;
  color: #C0C8D4;
}

/* 搴曢儴瀹夊叏鍖?*/
.safe-bottom {
  height: env(safe-area-inset-bottom);
  width: 100%;
}
