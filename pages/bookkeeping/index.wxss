page {
  background: #F8F7FC;
  min-height: 100vh;
  padding-bottom: 120rpx;
}
.page {
  background: #F8F7FC;
  min-height: 100vh;
  padding-bottom: 120rpx;
}
.banner {
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #5B6FE8 0%, #A78BFA 100%);
}
.banner-title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
  display: block;
  letter-spacing: 2rpx;
}
.banner-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  display: block;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}
.banner-tags {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 20rpx;
  margin-top: 24rpx;
}
.banner-tag {
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.4);
}
.service-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 30rpx;
  gap: 20rpx;
}
.service-item {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(91,111,232,0.08);
  position: relative;
  box-sizing: border-box;
}
.service-icon-img {
  width: 56rpx;
  height: 56rpx;
}
.svc-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.service-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.service-name {
  font-size: 30rpx;
  color: #1A202C;
  font-weight: 500;
}
.service-desc {
  font-size: 22rpx;
  color: #8B95A5;
  text-align: center;
  line-height: 1.4;
}
.service-arrow {
  display: none;
}
.safe-bottom {
  height: env(safe-area-inset-bottom);
  width: 100%;
}
