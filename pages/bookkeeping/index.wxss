/* pages/bookkeeping/index.wxss */

/* ===== 页面背景 ===== */
page {
  background: linear-gradient(180deg, #F8F7FC 0%, #EEF0F8 100%);
  min-height: 100vh;
}

.page {
  background: transparent;
  min-height: 100vh;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  padding: 44rpx 36rpx 50rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  overflow: hidden;
}

.hero-glow-1 {
  position: absolute;
  top: -30%;
  left: -10%;
  width: 480rpx;
  height: 480rpx;
  background: radial-gradient(circle, rgb(255 255 255 / 0.18) 0%, transparent 65%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow-2 {
  position: absolute;
  bottom: -20%;
  right: -15%;
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, rgb(255 255 255 / 0.10) 0%, transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-label {
  font-size: 20rpx;
  color: rgb(255 255 255 / 0.85);
  font-weight: 600;
  letter-spacing: 4rpx;
  display: block;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.25;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgb(255 255 255 / 0.8);
  letter-spacing: 1rpx;
  margin-bottom: 32rpx;
  display: block;
  position: relative;
  z-index: 1;
}

.hero-stats {
  display: flex;
  align-items: center;
  background: rgb(255 255 255 / 0.15);
  backdrop-filter: blur(8px);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid rgb(255 255 255 / 0.2);
  margin-bottom: 26rpx;
  position: relative;
  z-index: 1;
}

.stat-item { flex: 1; text-align: center; }

.stat-num {
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
  display: block;
}

.stat-label {
  font-size: 20rpx;
  color: rgb(255 255 255 / 0.7);
  margin-top: 4rpx;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgb(255 255 255 / 0.25);
}

.service-icons {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 1;
}
.service-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.service-icon-circle {
  width: 72rpx;
  height: 72rpx;
  background: rgb(255 255 255 / 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgb(255 255 255 / 0.25);
}
.service-icon-img {
  width: 38rpx;
  height: 38rpx;
  filter: brightness(0) invert(1);
}
.service-icon-label {
  font-size: 22rpx;
  color: rgb(255 255 255 / 0.9);
  font-weight: 500;
}

.hero-badges {
  display: flex;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.badge {
  padding: 10rpx 22rpx;
  background: rgb(255 255 255 / 0.18);
  border-radius: 20rpx;
  border: 1rpx solid rgb(255 255 255 / 0.22);
}

.badge text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

/* ===== 表单卡片 ===== */
.form-card {
  margin: -32rpx 28rpx 200rpx;
  padding: 8rpx 0 12rpx;
  background: #fff;
  border-radius: 32rpx;
  position: relative;
  z-index: 2;
  overflow: hidden;
  box-shadow:
    0 4rpx 16rpx rgb(91 111 232 / 0.08),
    0 1rpx 4rpx rgb(0 0 0 / 0.04);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.form-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 32rpx;
  padding: 2rpx;
  background: linear-gradient(135deg, rgb(91 111 232 / 0.18), rgb(167 139 250 / 0.10), transparent);
  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
}

.form-card:active {
  transform: scale(0.97);
  box-shadow:
    0 8rpx 32rpx rgb(91 111 232 / 0.14),
    0 2rpx 8rpx rgb(0 0 0 / 0.06);
}

.form-card:active::before {
  opacity: 1;
}

.form-section { padding: 28rpx 36rpx; }

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D26;
  margin-bottom: 20rpx;
}

.section-divider {
  height: 1rpx;
  background: #F0F1F4;
  margin: 0 -36rpx;
}

.option-row { display: flex; flex-wrap: wrap; gap: 20rpx; }

.option-btn {
  position: relative;
  min-width: 200rpx;
  padding: 20rpx 32rpx;
  background: #F5F6FA;
  border: 2rpx solid #E8E9EE;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
}
.option-text { font-size: 28rpx; color: #4A4D5A; transition: color 0.18s; }
.option-btn.active {
  background: #EEF2FF;
  border: 2rpx solid #5B6FE8;
}
.option-btn.active .option-text { color: #5B6FE8; font-weight: 600; }
.option-btn:active {
  transform: scale(0.94);
  opacity: 0.85;
}

.phone-row { display: flex; align-items: center; gap: 16rpx; }
.phone-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F5F6FA;
  border: 2rpx solid #E8E9EE;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1A1D26;
  box-sizing: border-box;
}
.contact-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F6FA;
  border: 2rpx solid #E8E9EE;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.contact-icon { width: 40rpx; height: 40rpx; }

.link-section { display: flex; justify-content: flex-end; padding-top: 8rpx; }
.detail-link { font-size: 26rpx; color: #5B6FE8; }

/* ===== 底部悬浮结算栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 36rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgb(0 0 0 / 0.05);
  z-index: 100;
}
.total-info { display: flex; align-items: baseline; }
.total-price {
  font-size: 48rpx;
  color: #5B6FE8;
  font-weight: 700;
  line-height: 1;
}
.pay-btn {
  background: #5B6FE8;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 60rpx;
  border-radius: 20rpx;
  border: none;
  line-height: 1;
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.25);
}
.pay-btn text { font-size: 32rpx; font-weight: 500; color: #fff; }
.pay-btn.disabled { background: #C4C9D9; }
.pay-btn.disabled text { color: #fff; }
.pay-btn::after { border: none; }