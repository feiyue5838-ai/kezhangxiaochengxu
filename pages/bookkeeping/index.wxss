/* pages/bookkeeping/index.wxss */
page { background: #f5f6fa; }

/* ===== Banner ===== */
.banner {
  margin: 24rpx 32rpx;
  padding: 48rpx 40rpx;
  background: linear-gradient(135deg, #4A6FE8 0%, #6B8CF8 100%);
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}
.banner::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}
.banner-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}
.banner-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 28rpx;
}
.banner-tags { display: flex; gap: 16rpx; flex-wrap: wrap; }
.banner-tag {
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #fff;
}

/* ===== 表单卡片 ===== */
.form-card {
  margin: 0 32rpx 200rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(74,111,232,0.06);
}

.form-section { padding: 28rpx 36rpx; }

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D26;
  margin-bottom: 20rpx;
}

.section-divider {
  height: 1rpx;
  background: #F0F1F4;
  margin: 0 -36rpx;
}

.option-row { display: flex; flex-wrap: wrap; gap: 20rpx; }

.option-btn {
  position: relative;
  min-width: 200rpx;
  padding: 20rpx 32rpx;
  background: #F5F6FA;
  border: 2rpx solid #E8E9EE;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.option-text { font-size: 28rpx; color: #4A4D5A; }
.option-btn.active {
  background: #EEF2FF;
  border: 2rpx solid #4A6FE8;
}
.option-btn.active .option-text { color: #4A6FE8; font-weight: 600; }
.option-check {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 0;
  height: 0;
  border-top: 36rpx solid #4A6FE8;
  border-left: 36rpx solid transparent;
  border-radius: 0 12rpx 0 0;
}
.option-check::after {
  content: '✓';
  position: absolute;
  top: -32rpx;
  right: 2rpx;
  font-size: 18rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.phone-row { display: flex; align-items: center; gap: 16rpx; }
.phone-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F5F6FA;
  border: 2rpx solid #E8E9EE;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1A1D26;
  box-sizing: border-box;
}
.contact-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F6FA;
  border: 2rpx solid #E8E9EE;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.contact-icon { width: 40rpx; height: 40rpx; }

.link-section { display: flex; justify-content: flex-end; padding-top: 8rpx; }
.detail-link { font-size: 26rpx; color: #4A6FE8; }

/* ===== 底部悬浮结算栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.bottom-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 36rpx;
}
.total-info { display: flex; align-items: baseline; gap: 8rpx; }
.total-label { font-size: 26rpx; color: #8B95A5; }
.total-price { font-size: 44rpx; font-weight: 700; color: #4A6FE8; }
.pay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 88rpx;
  background: #4A6FE8;
  border-radius: 44rpx;
}
.pay-btn text { font-size: 30rpx; font-weight: 600; color: #fff; }
.pay-btn.disabled { background: #C4C9D9; }
.pay-btn.disabled text { color: #fff; }
