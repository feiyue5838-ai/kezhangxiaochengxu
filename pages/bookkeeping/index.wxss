/* pages/bookkeeping/index.wxss */

/* ===== 页面背景 ===== */
page {
  background: linear-gradient(180deg, #F8F7FC 0%, #EEF0F8 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  background: transparent;
  min-height: 100vh;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  padding: 88rpx 36rpx 96rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  overflow: hidden;
}

.hero-glow-1 {
  position: absolute;
  top: -30%;
  left: -10%;
  width: 480rpx;
  height: 480rpx;
  background: radial-gradient(circle, rgb(255 255 255 / 0.18) 0%, transparent 65%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow-2 {
  position: absolute;
  bottom: -20%;
  right: -15%;
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, rgb(255 255 255 / 0.10) 0%, transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-label {
  font-size: 24rpx;
  color: rgb(255 255 255 / 0.9);
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 18rpx;
  position: relative;
  z-index: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.hero-title {
  font-size: 52rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 0rpx;
  line-height: 1.25;
  display: block;
  position: relative;
  z-index: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.hero-divider {
  width: 60rpx;
  height: 2rpx;
  background: rgb(255 255 255 / 0.6);
  margin: 28rpx 0 32rpx;
  position: relative;
  z-index: 1;
}

/* Hero 右上装饰：账本圆形 + 抽象线条 */
.hero-deco {
  position: absolute;
  top: 0;
  right: 0;
  width: 320rpx;
  height: 320rpx;
  pointer-events: none;
  z-index: 0;
}
.hero-deco-circle {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.12);
  border: 2rpx solid rgb(255 255 255 / 0.25);
}
.hero-deco-circle::before {
  content: '';
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.10);
  border: 1rpx dashed rgb(255 255 255 / 0.35);
}
.hero-deco-lines {
  position: absolute;
  top: 100rpx;
  right: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background-image:
    linear-gradient(90deg, rgb(255 255 255 / 0.4) 1rpx, transparent 1rpx),
    linear-gradient(0deg, rgb(255 255 255 / 0.4) 1rpx, transparent 1rpx);
  background-size: 24rpx 24rpx;
  border-radius: 12rpx;
  transform: rotate(15deg);
  opacity: 0.5;
}

.stat-item { flex: 1; text-align: center; }

.stat-num {
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
  display: block;
}

.stat-label {
  font-size: 20rpx;
  color: rgb(255 255 255 / 0.7);
  margin-top: 4rpx;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgb(255 255 255 / 0.25);
}

.hero-badges {
  display: flex;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.badge {
  padding: 8rpx 18rpx;
  background: rgb(255 255 255 / 0.18);
  border-radius: 24rpx;
  border: 1rpx solid rgb(255 255 255 / 0.22);
}

.badge text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
  margin: -48rpx 28rpx 0;
  padding: 12rpx 0 16rpx;
  background: #fff;
  border-radius: 32rpx;
  position: relative;
  z-index: 2;
  overflow: hidden;
  box-shadow:
    0 12rpx 40rpx rgb(91 111 232 / 0.12),
    0 2rpx 8rpx rgb(0 0 0 / 0.04);
}

.form-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #5B6FE8, #A78BFA, transparent);
  border-radius: 0 0 8rpx 8rpx;
  z-index: 3;
}

.form-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 32rpx;
  padding: 2rpx;
  background: linear-gradient(135deg, rgb(91 111 232 / 0.20), rgb(167 139 250 / 0.15), transparent 60%);
  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.form-section { padding: 32rpx 36rpx; }

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D26;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
.section-label::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  background: linear-gradient(180deg, #5B6FE8, #A78BFA);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.section-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #EAEAF4 30%, #EAEAF4 70%, transparent);
  margin: 4rpx -36rpx 0;
}

.option-row { display: flex; flex-wrap: wrap; gap: 20rpx; }
.option-row.cols-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.option-row.cols-3 .option-btn { min-width: 0; padding: 20rpx 8rpx; }
.option-row.cols-3 .option-text { font-size: 26rpx; }
.option-row.cols-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.option-row.cols-2 .option-btn { min-width: 0; padding: 22rpx 8rpx; }

.option-btn {
  position: relative;
  min-width: 200rpx;
  padding: 22rpx 32rpx;
  background: #F5F6FA;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
.option-text { font-size: 28rpx; color: #4A4D5A; transition: all 0.2s; }
.option-btn.active {
  background: linear-gradient(135deg, #5B6FE8, #7B6CE8);
  border-color: transparent;
  box-shadow: 0 6rpx 20rpx rgb(91 111 232 / 0.35);
}
.option-btn.active .option-text { color: #fff; font-weight: 600; }
.option-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  right: 16rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid transparent;
  border-top-color: #fff;
  border-right-color: #fff;
  transform: translateY(-50%) rotate(135deg) scale(0);
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 0;
}
.option-btn.active::before {
  transform: translateY(-50%) rotate(135deg) scale(1);
  opacity: 1;
}
.option-btn:active {
  transform: scale(0.94);
}

.phone-row { display: flex; align-items: center; gap: 16rpx; }
.phone-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F5F6FA;
  border: 2rpx solid #E8E9EE;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1A1D26;
  box-sizing: border-box;
}
.contact-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F6FA;
  border: 2rpx solid #E8E9EE;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.contact-icon { width: 40rpx; height: 40rpx; }

.link-section { display: flex; justify-content: flex-end; padding-top: 8rpx; }
.detail-link { font-size: 26rpx; color: #5B6FE8; }

/* ===== 底部悬浮结算栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255 255 255 / 0.96);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(234 234 244 / 0.8);
  padding: 20rpx 36rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  box-shadow: 0 -8rpx 32rpx rgb(91 111 232 / 0.06);
}
.total-info { display: flex; align-items: baseline; }
.total-label {
  font-size: 24rpx;
  color: #8A8D9A;
  margin-right: 12rpx;
  font-weight: 400;
}
.total-price {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.pay-btn {
  background: linear-gradient(135deg, #5B6FE8 0%, #7B6CE8 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 56rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1;
  box-shadow: 0 6rpx 20rpx rgb(91 111 232 / 0.35);
  transition: all 0.2s;
}
.pay-btn text { font-size: 30rpx; font-weight: 500; color: #fff; }
.pay-btn.disabled { background: #C4C9D9; box-shadow: none; }
.pay-btn.disabled text { color: #fff; }
.pay-btn::after { border: none; }