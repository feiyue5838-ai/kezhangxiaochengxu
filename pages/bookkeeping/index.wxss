/* pages/bookkeeping/index.wxss */
page { background: #f5f6fa; }

.banner {
  margin: 24rpx 32rpx;
  padding: 48rpx 40rpx;
  background: linear-gradient(135deg, #4A6FE8 0%, #6B8CF8 100%);
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}
.banner::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}
.banner-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}
.banner-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 28rpx;
}
.banner-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.banner-tag {
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #fff;
}

.main-action {
  margin: 0 32rpx;
}
.action-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(74,111,232,0.08);
}
.action-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #EEF2FF, #DCE4FF);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 28rpx;
}
.action-icon {
  width: 52rpx;
  height: 52rpx;
}
.action-info {
  flex: 1;
}
.action-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1D26;
  margin-bottom: 10rpx;
}
.action-desc {
  display: block;
  font-size: 26rpx;
  color: #8B95A5;
  line-height: 1.5;
}
.action-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
}
.arrow-icon {
  font-size: 48rpx;
  color: #C4C9D9;
  font-weight: 300;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
