<!-- pages/bookkeeping/form/index.wxml -->
<view class="page">
  <nav-bar title="代理记账" bind:back="goBack"></nav-bar>

  <view class="content">
    <!-- 顶部卖点标签栏 -->
    <view class="top-tags">
      <view class="tag-item">
        <text class="tag-icon">✓</text>
        <text class="tag-text">专业会计团队</text>
      </view>
      <view class="tag-item">
        <text class="tag-icon">✓</text>
        <text class="tag-text">智能做账报税</text>
      </view>
      <view class="tag-item">
        <text class="tag-icon">✓</text>
        <text class="tag-text">全程合规保障</text>
      </view>
    </view>

    <!-- 主表单白色卡片容器 -->
    <view class="form-card">
      <!-- 企业类型 -->
      <view class="form-section">
        <view class="section-label">企业类型</view>
        <view class="option-row">
          <view
            class="option-btn {{taxpayerType === 'small' ? 'active' : ''}}"
            bindtap="onTaxpayerSelect"
            data-type="small"
          >
            <text class="option-text">小规模纳税人</text>
            <view class="option-check" wx:if="{{taxpayerType === 'small'}}">✓</view>
          </view>
          <view
            class="option-btn {{taxpayerType === 'general' ? 'active' : ''}}"
            bindtap="onTaxpayerSelect"
            data-type="general"
          >
            <text class="option-text">一般纳税人</text>
            <view class="option-check" wx:if="{{taxpayerType === 'general'}}">✓</view>
          </view>
        </view>
        <view class="section-divider"></view>
      </view>

      <!-- 服务周期 -->
      <view class="form-section">
        <view class="section-label">服务周期</view>
        <view class="option-row">
          <!-- 小规模: 全年、半年 -->
          <block wx:if="{{taxpayerType === 'small'}}">
            <view
              class="option-btn {{cycle === 'year' ? 'active' : ''}}"
              bindtap="onCycleSelect"
              data-cycle="year"
            >
              <text class="option-text">全年</text>
              <view class="option-check" wx:if="{{cycle === 'year'}}">✓</view>
            </view>
            <view
              class="option-btn {{cycle === 'half' ? 'active' : ''}}"
              bindtap="onCycleSelect"
              data-cycle="half"
            >
              <text class="option-text">半年</text>
              <view class="option-check" wx:if="{{cycle === 'half'}}">✓</view>
            </view>
          </block>
          <!-- 一般纳税人: 全年、半年、9.9预定 -->
          <block wx:if="{{taxpayerType === 'general'}}">
            <view
              class="option-btn {{cycle === 'year' ? 'active' : ''}}"
              bindtap="onCycleSelect"
              data-cycle="year"
            >
              <text class="option-text">全年</text>
              <view class="option-check" wx:if="{{cycle === 'year'}}">✓</view>
            </view>
            <view
              class="option-btn {{cycle === 'half' ? 'active' : ''}}"
              bindtap="onCycleSelect"
              data-cycle="half"
            >
              <text class="option-text">半年</text>
              <view class="option-check" wx:if="{{cycle === 'half'}}">✓</view>
            </view>
            <view
              class="option-btn {{cycle === 'preorder' ? 'active' : ''}}"
              bindtap="onCycleSelect"
              data-cycle="preorder"
            >
              <text class="option-text">9.9 预定</text>
              <view class="option-check" wx:if="{{cycle === 'preorder'}}">✓</view>
            </view>
          </block>
        </view>
        <view class="section-divider"></view>
      </view>

      <!-- 开票 -->
      <view class="form-section">
        <view class="section-label">开票</view>
        <view class="option-row">
          <view
            class="option-btn {{invoice === 'none' ? 'active' : ''}}"
            bindtap="onInvoiceSelect"
            data-invoice="none"
          >
            <text class="option-text">不开票</text>
            <view class="option-check" wx:if="{{invoice === 'none'}}">✓</view>
          </view>
          <view
            class="option-btn {{invoice === 'within5' ? 'active' : ''}}"
            bindtap="onInvoiceSelect"
            data-invoice="within5"
          >
            <text class="option-text">5 张内</text>
            <view class="option-check" wx:if="{{invoice === 'within5'}}">✓</view>
          </view>
          <view
            class="option-btn {{invoice === 'normal' ? 'active' : ''}}"
            bindtap="onInvoiceSelect"
            data-invoice="normal"
          >
            <text class="option-text">正常开票</text>
            <view class="option-check" wx:if="{{invoice === 'normal'}}">✓</view>
          </view>
        </view>
        <view class="section-divider"></view>
      </view>

      <!-- 社保 -->
      <view class="form-section">
        <view class="section-label">社保</view>
        <view class="option-row">
          <view
            class="option-btn {{social === 'none' ? 'active' : ''}}"
            bindtap="onSocialSelect"
            data-social="none"
          >
            <text class="option-text">不缴社保</text>
            <view class="option-check" wx:if="{{social === 'none'}}">✓</view>
          </view>
          <view
            class="option-btn {{social === 'with' ? 'active' : ''}}"
            bindtap="onSocialSelect"
            data-social="with"
          >
            <text class="option-text">缴社保</text>
            <view class="option-check" wx:if="{{social === 'with'}}">✓</view>
          </view>
        </view>
        <view class="section-divider"></view>
      </view>

      <!-- 动态模块：公积金（仅一般纳税人显示） -->
      <view class="form-section" wx:if="{{taxpayerType === 'general'}}">
        <view class="section-label">公积金</view>
        <view class="option-row">
          <view
            class="option-btn {{fund === 'none' ? 'active' : ''}}"
            bindtap="onFundSelect"
            data-fund="none"
          >
            <text class="option-text">不开户</text>
            <view class="option-check" wx:if="{{fund === 'none'}}">✓</view>
          </view>
          <view
            class="option-btn {{fund === 'with' ? 'active' : ''}}"
            bindtap="onFundSelect"
            data-fund="with"
          >
            <text class="option-text">开户</text>
            <view class="option-check" wx:if="{{fund === 'with'}}">✓</view>
          </view>
        </view>
        <view class="section-divider"></view>
      </view>

      <!-- 联系电话 -->
      <view class="form-section">
        <view class="section-label">联系电话</view>
        <view class="phone-row">
          <input
            class="phone-input"
            type="number"
            maxlength="11"
            placeholder="请输入手机号码"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
          <view class="contact-btn" bindtap="onPickContact">
            <image class="contact-icon" src="/assets/icons/icon-contact.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="section-divider"></view>
      </view>

      <!-- 评价与反馈按钮 -->
      <view class="form-section feedback-section">
        <view class="feedback-btn" bindtap="onFeedback">
          <text class="feedback-btn-text">评价与反馈</text>
        </view>
      </view>

      <!-- 服务详情链接 -->
      <view class="form-section link-section">
        <text class="detail-link" bindtap="onShowDetail">服务详情 ›</text>
      </view>
    </view>
  </view>

  <!-- 底部悬浮结算栏 -->
  <view class="bottom-bar">
    <view class="bottom-bar-inner">
      <view class="total-info">
        <text class="total-label">总计金额：</text>
        <text class="total-price">¥{{price}}</text>
      </view>
      <view
        class="pay-btn {{payDisabled ? 'disabled' : ''}}"
        bindtap="onPay"
      >
        <text>立即付款</text>
      </view>
    </view>
  </view>
</view>
