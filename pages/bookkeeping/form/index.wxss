/* pages/bookkeeping/form/index.wxss */

.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部卖点标签栏 ===== */
.top-tags {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 20rpx 30rpx;
  background: var(--primary-bg);
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-icon {
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.tag-text {
  font-size: 22rpx;
  color: var(--text-regular);
}

/* ===== 主表单白色卡片 ===== */
.form-card {
  margin: 20rpx 24rpx;
  background: var(--bg-white);
  border-radius: 16rpx;
  overflow: hidden;
}

/* ===== 表单分组 ===== */
.form-section {
  padding: 28rpx 30rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.section-divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 0 -30rpx;
}

/* ===== 选项行 ===== */
.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

/* 未选中按钮 */
.option-btn {
  position: relative;
  min-width: 200rpx;
  padding: 20rpx 36rpx;
  background: var(--bg-white);
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 选中按钮 */
.option-btn.active {
  background: var(--primary-bg);
  border: 2rpx solid var(--primary-color);
}

.option-btn.active .option-text {
  color: var(--primary-color);
  font-weight: 600;
}

/* 右上角勾选标识 */
.option-check {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 0;
  height: 0;
  border-top: 36rpx solid var(--primary-color);
  border-left: 36rpx solid transparent;
  border-radius: 0 12rpx 0 0;
}

.option-check::after {
  content: '✓';
  position: absolute;
  top: -32rpx;
  right: 2rpx;
  font-size: 18rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

/* ===== 联系电话行 ===== */
.phone-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.phone-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
  box-sizing: border-box;
}

.contact-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  flex-shrink: 0;
}

.contact-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ===== 评价与反馈按钮 ===== */
.feedback-section {
  display: flex;
  justify-content: center;
}

.feedback-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  border: 2rpx solid var(--primary-color);
  border-radius: 40rpx;
}

.feedback-btn-text {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* ===== 服务详情链接 ===== */
.link-section {
  display: flex;
  justify-content: flex-end;
  padding-top: 8rpx;
}

.detail-link {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* ===== 底部悬浮结算栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-white);
  box-shadow: 0 -2rpx 12rpx rgb(0 0 0 / 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.bottom-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
}

.total-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 26rpx;
  color: var(--text-regular);
}

.total-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.pay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 84rpx;
  background: var(--primary-color);
  border-radius: 42rpx;
}

.pay-btn text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.pay-btn.disabled {
  background: var(--text-disabled);
}

.pay-btn.disabled text {
  color: var(--text-secondary);
}
