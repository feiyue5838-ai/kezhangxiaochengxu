/* pages/profile/index.wxss */
page {
  background: #F8F7FC;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ========== 头部区域 ========== */
.header {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  padding: 48rpx 40rpx 60rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: rgb(255 255 255 / 0.3);
  display: block;
  margin-bottom: 16rpx;
}

.avatar--default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(255 255 255 / 0.25);
  border: 2rpx solid rgb(255 255 255 / 0.4);
}

.avatar-icon {
  font-size: 60rpx;
  line-height: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.phone {
  font-size: 26rpx;
  color: rgb(255 255 255 / 0.8);
}

.login-btn {
  margin-top: 24rpx;
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #7B5CFA;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgb(123 92 250 / 0.3);
}

.login-btn::after { border: none; }

/* ========== 订单统计（3列） ========== */
.stats-row {
  display: flex;
  align-items: center;
  background: #fff;
  margin: -30rpx 20rpx 20rpx;
  border-radius: 20rpx;
  padding: 32rpx 0;
  box-shadow: 0 2rpx 12rpx rgb(123 92 250 / 0.06);
  position: relative;
  z-index: 10;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #f0f0f0;
  padding: 0 8rpx;
}

.stat-item:last-child { border-right: none; }

.stat-item:nth-child(4) .stat-label {
  font-size: 22rpx;
}

.stat-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.stat-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #7B5CFA;
  line-height: 1;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* ========== 电子印章卡片 ========== */
.seal-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  margin: 0 20rpx 20rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.2);
}

.seal-card__content {
  display: flex;
  align-items: center;
}

.seal-card__icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: rgb(255 255 255 / 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.seal-card__icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1);
}

.seal-card__info {
  display: flex;
  flex-direction: column;
}

.seal-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.seal-card__desc {
  font-size: 24rpx;
  color: rgb(255 255 255 / 0.8);
}

.seal-card__arrow {
  font-size: 40rpx;
  color: rgb(255 255 255 / 0.8);
}

/* ========== 常用功能 ========== */
.func-section {
  margin: 0 20rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgb(123 92 250 / 0.06);
}

.func-section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A202C;
  margin-bottom: 24rpx;
  display: block;
}

.func-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32rpx 24rpx;
}

.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.func-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.func-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.func-name {
  font-size: 24rpx;
  color: #555;
  text-align: center;
}

/* ========== 菜单列表 ========== */
.menu-list {
  margin: 0 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgb(123 92 250 / 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.menu-icon-wrap--primary {
  background: #F0EBFF;
}

.menu-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #1A202C;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C0C8D4;
}

/* ========== 底部安全区 ========== */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  width: 100%;
}
