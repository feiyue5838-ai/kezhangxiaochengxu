<!-- pages/profile/index.wxml -->
<view class="page">
  <!-- 自定义导航栏 -->
  <nav-bar title="我的" showBack="{{false}}" />

  <!-- 用户信息区 -->
  <view class="header">
    <view class="user-info">
      <button class="avatar-btn" wx:if="{{!userInfo.avatarUrl}}" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar avatar--default">
          <text class="avatar-icon">👤</text>
        </view>
      </button>
      <button wx:if="{{userInfo.avatarUrl}}" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      </button>
      <view wx:if="{{!userInfo.nickName}}" class="nickname-input-wrap">
        <input
          class="nickname-input"
          type="nickname"
          placeholder="点击设置昵称"
          placeholder-class="nickname-placeholder"
          bindblur="onNicknameBlur"
          bindconfirm="onNicknameBlur"
        />
      </view>
      <text class="nickname" wx:else>{{userInfo.nickName}}</text>
      <button wx:if="{{userInfo.avatarUrl && !userInfo.nickName}}" class="login-btn" bindtap="onConfirmLogin">
        完成登录
      </button>
      <text class="phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
    </view>
    <view class="edit-entry" bindtap="goToEditProfile">
      <text>编辑资料</text>
      <text class="edit-entry-arrow">›</text>
    </view>
  </view>

  <!-- 订单统计（3个状态） -->
  <view class="stats-row">
    <view class="stat-item" wx:for="{{orderTypes}}" wx:key="id" bindtap="goToOrderList" data-type="{{item.id}}">
      <view class="stat-icon-wrap" style="background:{{item.bgColor}}">
        <image class="stat-icon-img" src="{{item.iconSvg}}" mode="aspectFit" />
      </view>
      <text class="stat-value">{{item.count || 0}}</text>
      <text class="stat-label">{{item.name}}</text>
    </view>
  </view>

  <!-- 订单管理（突出显示） -->
  <view class="seal-card" bindtap="goToOrders">
    <view class="seal-card__content">
      <view class="seal-card__icon-wrap">
        <image class="seal-card__icon" src="/assets/icons/icon-clipboard.svg" mode="aspectFit" />
      </view>
      <view class="seal-card__info">
        <text class="seal-card__title">订单管理</text>
        <text class="seal-card__desc">查看全部订单</text>
      </view>
    </view>
    <text class="seal-card__arrow">›</text>
  </view>

  <!-- 常用功能（4个） -->
  <view class="func-section">
    <text class="func-section__title">常用功能</text>
    <view class="func-grid">
      <view class="func-item" wx:for="{{functions}}" wx:key="id" bindtap="onFuncTap" data-id="{{item.id}}">
        <view class="func-icon-wrap" style="background:{{item.bgColor}}">
          <image class="func-icon-img" src="{{item.iconSvg}}" mode="aspectFit" />
        </view>
        <text class="func-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToSupplierWorkbench">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/assets/icons/icon-b64-20.svg" mode="aspectFit" />
      </view>
      <text class="menu-name">商家工作台</text>
      <text class="menu-desc" wx:if="{{outletName}}">{{outletName}}｜接单/制作/发货/结算</text>
      <text class="menu-desc" wx:else>门店与供应商同一入口</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToAftersale">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/assets/icons/icon-b64-16.svg" mode="aspectFit" />
      </view>
      <text class="menu-name">售后记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onViewPrivacy">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/assets/icons/icon-b64-22.svg" mode="aspectFit" />
      </view>
      <text class="menu-name">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onViewTerms">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/assets/icons/icon-b64-22.svg" mode="aspectFit" />
      </view>
      <text class="menu-name">用户服务协议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/assets/icons/icon-b64-24.svg" mode="aspectFit" />
      </view>
      <text class="menu-name">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
