/* pages/about/index.wxss */
page { background: #F8F7FC; }

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
.nav-placeholder { flex: 1; }

.nav-title {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx; font-weight: 600; color: #fff;
}

.about-wrap {
  padding: 0 0 80rpx;
}

/* Logo鍖? */
.logo-section {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  padding: 48rpx 40rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 48rpx 48rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}
.logo-icon image { width: 72rpx; height: 72rpx; }

.app-name { font-size: 40rpx; font-weight: 700; color: #fff; margin-bottom: 8rpx; }
.app-version { font-size: 24rpx; color: rgba(255,255,255,0.7); }

/* 浠嬬粛鍗＄墖 */
.info-card {
  background: #fff;
  border-radius: 20rpx;
  margin: -32rpx 20rpx 0;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgb(91 111 232 / 0.12);
  position: relative;
  z-index: 10;
}

.info-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.9;
  margin-bottom: 32rpx;
}

.intro-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

/* 鍔熻兘鍒楄〃 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.feature-item { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.feature-icon { width: 56rpx; height: 56rpx; }
.feature-text { font-size: 22rpx; color: #555; text-align: center; line-height: 1.3; }

/* 鍒嗛殧绾? */
.divider { height: 1rpx; background: #f0f0f0; margin: 0 -36rpx 28rpx; }

/* 鑱旂郴淇℃伅 */
.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.contact-item:last-child { border-bottom: none; }
.contact-icon { width: 44rpx; height: 44rpx; margin-right: 16rpx; }
.contact-label { font-size: 26rpx; color: #999; width: 160rpx; flex-shrink: 0; white-space: nowrap; overflow: hidden; }
.contact-value { flex: 1; font-size: 26rpx; color: #1A2332; }

/* 搴曢儴 */
.footer-note {
  text-align: center;
  font-size: 22rpx;
  color: #B0BBC8;
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  line-height: 1.8;
}
