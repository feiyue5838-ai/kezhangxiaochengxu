<!--pages/payment/result/index.wxml-->
<view class="page">
  <!-- 结果图标 -->
  <view class="result-icon {{status}}">
    <image class="icon" src="{{iconUrl}}" mode="aspectFit" />
  </view>

  <!-- 结果标题 -->
  <view class="result-title">{{title}}</view>
  <view class="result-desc">{{description}}</view>

  <!-- 订单信息 -->
  <view class="order-info-card">
    <view class="info-item">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{orderId}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">支付金额</text>
      <text class="info-value price">¥{{amount}}</text>
    </view>
    <view class="info-item" wx:if="{{payTime}}">
      <text class="info-label">支付时间</text>
      <text class="info-value">{{payTime}}</text>
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="tips-card" wx:if="{{status === 'success'}}">
    <view class="tips-item">
      <image class="tips-icon" src="/assets/icons/icon-check-circle.svg" mode="aspectFit" />
      <text class="tips-text">客服将在24小时内联系您确认材料</text>
    </view>
    <view class="tips-item">
      <image class="tips-icon" src="/assets/icons/icon-phone.svg" mode="aspectFit" />
      <text class="tips-text">如有疑问请拨打客服热线：400-123-4567</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-primary" bindtap="viewOrder">
      查看订单
    </button>
    <button class="btn-secondary" bindtap="goHome">
      返回首页
    </button>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-bottom"></view>
</view>
