/* pages/payment/result/index.wxss */

/* ========== 页面基础 ========== */
page {
  background: #F8F7FC;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ========== 结果图标 ========== */
.result-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  animation: scaleIn 0.4s ease-out;
}

.result-icon.success {
  background: linear-gradient(135deg, #E6F7F0, #D1F2E3);
}

.result-icon.failed {
  background: linear-gradient(135deg, #FFF1F0, #FFE7E6);
}

.result-icon .icon {
  width: 96rpx;
  height: 96rpx;
}

@keyframes scaleIn {
  from {
    transform: scale(0);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* ========== 结果标题 ========== */
.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A202C;
  margin-bottom: 16rpx;
  text-align: center;
}

.result-desc {
  font-size: 28rpx;
  color: #718096;
  margin-bottom: 48rpx;
  text-align: center;
  line-height: 1.5;
}

/* ========== 订单信息卡片 ========== */
.order-info-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(91, 111, 232, 0.08);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #718096;
}

.info-value {
  font-size: 28rpx;
  color: #1A202C;
  font-weight: 500;
}

.info-value.price {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 700;
}

/* ========== 提示卡片 ========== */
.tips-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(91, 111, 232, 0.08);
}

.tips-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}

.tips-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.5;
}

/* ========== 操作按钮 ========== */
.actions {
  width: 100%;
  margin-top: auto;
  padding: 0 16rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 111, 232, 0.3);
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(91, 111, 232, 0.4);
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #E2E8F0;
  border-radius: 44rpx;
  color: #4A5568;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.btn-secondary:active {
  background: #F7FAFC;
  border-color: #CBD5E0;
}

/* ========== 底部安全区域 ========== */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  width: 100%;
}
