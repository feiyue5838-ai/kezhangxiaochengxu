/* ===== 页面基础 ===== */
.page { min-height: 100vh; background: #F5F5F7; }

/* ===== 内容区 ===== */
.content { padding: 20rpx 20rpx 40rpx; }

/* ===== 订单卡片 ===== */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.shop-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.order-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.status-7 { color: #FA8C16; background: #FFF7E6; }   /* 售后中-橙 */
.status-8 { color: #5B6FE8; background: #EEF1FF; }    /* 退款中-蓝 */
.status-9 { color: #52C41A; background: #F6FFED; }   /* 已退款-绿 */

/* 商品行 */
.goods-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FAFAFA;
}

.goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #F0F0F0;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2332;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sub {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-right {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2332;
}

/* 售后摘要行 */
.aftersale-summary {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F5F5F5;
  background: #FFF;
}

.aftersale-tag {
  font-size: 24rpx;
  color: #5B6FE8;
  font-weight: 600;
  flex-shrink: 0;
}

.aftersale-reason {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F5F5F5;
  gap: 16rpx;
}
.action-btns { display: flex; align-items: center; gap: 16rpx; }

.btn-detail {
  font-size: 24rpx;
  color: #5B6FE8;
  padding: 6rpx 0;
}

.arrow {
  font-size: 32rpx;
  color: #CCC;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 160rpx 0;
}
.empty-icon { font-size: 100rpx; display: block; margin-bottom: 32rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; color: #333; display: block; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #999; display: block; }

/* ===== Loading ===== */
.loading-state { text-align: center; padding: 80rpx 0; }
.loading-text { font-size: 26rpx; color: #999; }
