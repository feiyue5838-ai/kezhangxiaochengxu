/* pages/aftersale/list/index.wxss */

.page { min-height: 100vh; background: #F8F7FC; }

/* ========== 导航栏 ========== */
.nav-back {
  position: absolute; left: 0; top: 0; width: 60rpx; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; color: #fff; font-weight: 300; line-height: 1;
}
.nav-placeholder { width: 60rpx; height: 100%; }
.nav-title {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx; font-weight: 600; color: #fff;
}

/* ========== 内容区 ========== */
.content { padding: 24rpx 20rpx 40rpx; }

/* 申请入口 */
.apply-banner {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  border-radius: 20rpx; padding: 28rpx 32rpx;
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgb(91 111 232 / 0.35);
}
.apply-left { display: flex; align-items: center; gap: 20rpx; }
.apply-icon { font-size: 48rpx; }
.apply-title { font-size: 30rpx; font-weight: 600; color: #fff; display: block; margin-bottom: 6rpx; }
.apply-sub { font-size: 24rpx; color: rgba(255,255,255,0.75); display: block; }
.apply-arrow { font-size: 40rpx; color: rgba(255,255,255,0.8); }

/* 售后记录卡片 */
.record-list { }
.record-item {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgb(91 111 232 / 0.08);
}
.record-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.record-id { font-size: 22rpx; color: #B0BBC8; }
.record-status {
  font-size: 24rpx; font-weight: 600; padding: 4rpx 16rpx; border-radius: 20rpx;
}
.status-pending { color: #fa8c16; background: #fff7e6; }
.status-processing { color: #5B6FE8; background: #e6f7ff; }
.status-completed { color: #52c41a; background: #f6ffed; }
.status-rejected { color: #999; background: #f5f5f5; }

.record-body { margin-bottom: 12rpx; }
.record-product { font-size: 30rpx; font-weight: 600; color: #1A2332; display: block; margin-bottom: 8rpx; }
.record-reason { font-size: 26rpx; color: #555; display: block; margin-bottom: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
.record-time { font-size: 22rpx; color: #B0BBC8; display: block; }

.record-footer {
  display: flex; align-items: center; justify-content: space-between;
  border-top: 1rpx solid #f0f0f0; padding-top: 14rpx; margin-top: 4rpx;
}
.record-category { font-size: 24rpx; color: #5B6FE8; font-weight: 500; }
.record-view { font-size: 24rpx; color: #B0BBC8; }

/* 空状态 */
.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 24rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; color: #1A2332; display: block; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #B0BBC8; display: block; }
