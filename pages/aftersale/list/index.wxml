<view class="page">
  <nav-bar title="退款/售后" bind:back="goBack" />

  <view class="content" style="padding-top: {{navHeight}}px;">

    <!-- 售后列表 -->
    <view class="order-list" wx:if="{{records.length > 0}}">
      <view
        class="order-card"
        wx:for="{{records}}"
        wx:key="id"
      >
        <!-- 卡片头部：单号 + 状态 -->
        <view class="card-header">
          <text class="shop-name">蓉城企服</text>
          <text class="order-status status-{{item.status}}">{{statusText[item.status]}}</text>
        </view>

        <!-- 商品信息 -->
        <view class="goods-row" bindtap="viewDetail" data-record="{{item}}">
          <image
            class="goods-img"
            src="{{item.module === 'seal' ? '/assets/icons/icon-seal.png' : '/assets/icons/icon-seal.png'}}"
            mode="aspectFill"
          />
          <view class="goods-info">
            <text class="goods-name">{{item.type || item.productName || '刻章订单'}}</text>
            <text class="goods-sub">{{item.companyName || item.module || '公章'}} · {{item.createdAt ? item.createdAt.slice(0,10) : item.createTime}}</text>
          </view>
          <view class="goods-right">
            <text class="goods-price">¥{{item.payPrice || item.total_price || '0.00'}}</text>
          </view>
        </view>

        <!-- 售后信息摘要 -->
        <view class="aftersale-summary">
          <text class="aftersale-tag">【{{categoryText[item.remark.afterSales.category] || categoryText[item.category] || '其他'}}】</text>
          <text class="aftersale-reason">{{item.remark.afterSales.reason || item.reason || '未填写原因'}}</text>
        </view>

        <!-- 卡片底部：查看详情 -->
        <view class="card-footer" bindtap="viewDetail" data-record="{{item}}">
          <view class="action-btns">
            <text class="btn-detail">查看详情</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{records.length === 0 && !loading}}">
      <text class="empty-icon">📦</text>
      <text class="empty-title">暂无退款/售后记录</text>
      <text class="empty-desc">您的退款和售后记录将在此处显示</text>
    </view>

    <!-- Loading -->
    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>
