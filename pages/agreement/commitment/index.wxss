/* pages/agreement/commitment/index.wxss */
@import '../privacy/index.wxss';

/* rich-text 内联样式（与 privacy/terms 保持一致） */
.agreement-rich {
  display: block;
}

.agreement-rich .p {
  font-size: 26rpx;
  color: #444;
  line-height: 1.9;
  margin-bottom: 16rpx;
}

.agreement-rich .ul,
.agreement-rich .ol {
  padding-left: 40rpx;
  margin-bottom: 16rpx;
}

.agreement-rich .li {
  font-size: 26rpx;
  color: #444;
  line-height: 1.9;
  margin-bottom: 8rpx;
}

.agreement-rich .loading,
.agreement-rich .empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #999;
}
