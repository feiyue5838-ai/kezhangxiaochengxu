/* pages/agreement/privacy/index.wxss & pages/agreement/terms/index.wxss */

page {
  background: #F8F7FC;
  min-height: 100vh;
}

/* ========== 导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  box-sizing: border-box;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  position: relative;
}

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
.nav-placeholder {
  width: 60rpx;
  height: 100%;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
}

/* ========== 内容区 ========== */
.content-wrap {
  padding-top: calc(88rpx + constant(safe-area-inset-top));
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 80rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgb(91 111 232 / 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2332;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.card-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.9;
  margin-bottom: 16rpx;
}

.card-text:last-child { margin-bottom: 0; }

.bold { font-weight: 600; color: #1A2332; }

.update-date {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  padding: 16rpx 0 8rpx;
}
