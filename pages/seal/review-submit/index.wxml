<!--pages/seal/review-submit/index.wxml-->
<view class="page">
  <view class="form-wrap">

    <view class="form-title">发表评价</view>

    <!-- 服务态度评分 -->
    <view class="score-row">
      <text class="score-label">服务态度</text>
      <view class="stars-row">
        <text
          class="star {{s < serviceScore ? 'active' : ''}}"
          wx:for="{{5}}"
          wx:for-item="s"
          wx:key="*this"
          data-score="{{s + 1}}"
          bindtap="onServiceStarTap"
        >{{s < serviceScore ? '★' : '☆'}}</text>
      </view>
    </view>

    <!-- 刻章质量评分 -->
    <view class="score-row">
      <text class="score-label">刻章质量</text>
      <view class="stars-row">
        <text
          class="star {{s < qualityScore ? 'active' : ''}}"
          wx:for="{{5}}"
          wx:for-item="s"
          wx:key="*this"
          data-score="{{s + 1}}"
          bindtap="onQualityStarTap"
        >{{s < qualityScore ? '★' : '☆'}}</text>
      </view>
    </view>

    <!-- 评价内容 -->
    <view class="text-area-wrap">
      <textarea
        class="text-area"
        placeholder="说说您的体验吧（选填）"
        value="{{reviewText}}"
        bindinput="onTextInput"
        maxlength="200"
        cursor-spacing="100"
        auto-focus="{{false}}"
        show-confirm-bar
      />
      <text class="word-count">{{reviewText.length}}/200</text>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
      <text wx:if="{{submitting}}">提交中...</text>
      <text wx:else>提交评价</text>
    </view>

    <view class="form-footer"></view>

  </view>
</view>
