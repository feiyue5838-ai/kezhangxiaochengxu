/* pages/seal/review-submit/index.wxss */
.page {
  background: var(--bg-color);
  min-height: 100vh;
  padding: 20rpx;
}

.form-wrap {
  background: var(--bg-white);
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 30rpx;
}

.score-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.score-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.stars-row {
  display: flex;
  flex-direction: row;
}

.star {
  font-size: 44rpx;
  color: var(--border-color);
  margin-left: 12rpx;
}

.star.active {
  color: var(--star-color);
}

.text-area-wrap {
  position: relative;
  margin-bottom: 30rpx;
}

.text-area {
  width: 100%;
  height: 200rpx;
  background: var(--bg-light);
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

.word-count {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  color: var(--bg-white);
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 20rpx;
  border: none;
}

.star-icon {
  width: 28rpx;
  height: 28rpx;
}