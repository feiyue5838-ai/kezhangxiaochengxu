<view class="page">
  <nav-bar title="订单详情" bind:back="goBack" />

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 订单不存在 -->
  <view class="empty-wrap" wx:elif="{{!order}}">
    <text class="empty-text">订单不存在或已被删除</text>
    <button class="back-btn" bindtap="goBack">返回</button>
  </view>

  <!-- 订单详情 -->
  <block wx:else>
    <!-- 订单状态 -->
    <view class="status-card {{order.statusClass}}">
      <view class="status-icon" style="background-image: url({{order.statusIconSvg}});"></view>
      <text class="status-text">{{order.statusText}}</text>
    </view>

    <!-- 订单信息 -->
    <view class="info-card">
      <view class="info-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">业务类型</text>
        <text class="info-value">{{order.type}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">印章名称</text>
        <text class="info-value">{{order.desc}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">提交时间</text>
        <text class="info-value">{{order.createTime || order.date}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单金额</text>
        <text class="info-value price">¥{{order.price}}</text>
      </view>
    </view>

    <!-- 邮寄信息 -->
    <view class="info-card" wx:if="{{address}}">
      <view class="info-title">邮寄信息</view>
      <view class="info-row">
        <text class="info-label">收件人</text>
        <text class="info-value">{{address.name}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">手机号</text>
        <text class="info-value">{{address.phone}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">邮寄地址</text>
        <text class="info-value">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-bar" wx:if="{{order.status === 'pending'}}">
      <button class="cancel-btn" bindtap="cancelOrder">取消订单</button>
      <button class="pay-btn" bindtap="payOrder">立即支付</button>
    </view>
    <view class="bottom-bar" wx:elif="{{order.status === 'processing'}}">
      <button class="complete-btn" bindtap="completeOrder">确认完成</button>
    </view>
  </block>
</view>
