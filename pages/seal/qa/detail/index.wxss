/* pages/seal/qa/detail/index.wxss — 问答详情 */
.page {
  min-height: 100vh;
  background: #f5f6fa;
}

/* 问题卡片 */
.q-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.q-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.q-badge {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #5B6FE8;
  color: #fff;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.q-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.6;
}

.q-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-left: 60rpx;
}

.q-status {
  font-size: 22rpx;
  color: #fa8c16;
  background: #fff7e6;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.q-status.answered {
  color: #52c41a;
  background: #f0fff0;
}

.q-date {
  font-size: 22rpx;
  color: #9097a1;
}

/* 回复区 */
.a-section {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

.a-header {
  font-size: 26rpx;
  color: #6b7280;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f5;
}

.a-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f8;
}

.a-item:last-child {
  border-bottom: none;
}

.a-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.a-author {
  font-size: 26rpx;
  color: #5B6FE8;
  font-weight: 500;
}

.a-date {
  font-size: 22rpx;
  color: #9097a1;
}

.a-text {
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.7;
}

.a-empty {
  text-align: center;
  padding: 60rpx 0;
}

.a-empty-text {
  font-size: 26rpx;
  color: #9097a1;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(31, 35, 41, 0.06);
}

.ask-again-btn {
  background: #5B6FE8;
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.bottom-placeholder {
  height: 140rpx;
}

/* 状态页 */
.state {
  text-align: center;
  padding: 200rpx 40rpx;
}

.state-text {
  font-size: 26rpx;
  color: #9097a1;
  display: block;
  margin-bottom: 32rpx;
}

.state-btn {
  width: 240rpx;
  margin: 0 auto;
  background: #5B6FE8;
  color: #fff;
  font-size: 28rpx;
  border-radius: 32rpx;
  padding: 16rpx 0;
}
