/* pages/seal/order-confirm/index.wxss */

/* ========== CSS变量定义 ========== */
page {
  --primary-color: #5B6FE8;
  --primary-dark: #4A5CD1;
  --error: #5B6FE8;
  --bg-color: #F8F7FC;
  --bg-white: #ffffff;
  --bg-light: #F8F7FC;
  --border-color: #D5DDE8;
  --text-secondary: #8C97A6;
  --text-hint: #A8B4C5;
  --text-disabled: #D5DDE8;
  --disabled-bg: #D5DDE8;
}

/* ========== 椤甸潰鍩虹鏍峰紡 ========== */
.page {
  background: #F8F7FC;
  min-height: 100vh;
}

/* ========== 导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
}

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%; transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1;
  white-space: nowrap;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}

page {
  background: var(--bg-color);
  padding-bottom: 140rpx;
}

.container {
  padding: 0;
}

/* ========== 琛ㄥ崟鍖哄潡 ========== */
.form-section {
  background: var(--bg-white);
  margin-top: 20rpx;
  padding: 0 32rpx;
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1A202C;
  margin-bottom: 16rpx;
}

.label-icon {
  margin-right: 12rpx;
  width: 32rpx;
  height: 32rpx;
}

.required {
  color: var(--error);
  margin-left: 8rpx;
}

.optional {
  color: var(--text-secondary);
  font-size: 26rpx;
  margin-left: 8rpx;
}

.form-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 20rpx 44rpx;
}

.address-box {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-color);
  border-radius: 20rpx;
}

.address-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-name {
  font-size: 28rpx;
  color: #1A202C;
  font-weight: 500;
  max-width: 50%;
}

.address-phone {
  font-size: 28rpx;
  color: #1A202C;
  max-width: 50%;
  text-align: right;
}

.address-divider {
  height: 1rpx;
  background: #F8F7FC;
  margin: 12rpx 0;
}

.address-region {
  font-size: 26rpx;
  color: #1A202C;
  line-height: 1.6;
}

.address-detail {
  font-size: 26rpx;
  color: #1A202C;
  line-height: 1.6;
  word-break: break-all;
}

.placeholder {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.arrow {
  font-size: 36rpx;
  color: var(--text-disabled);
  flex-shrink: 0;
}

.form-input {
  font-size: 28rpx;
  color: #1A202C;
  height: 60rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 20rpx;
  padding: 0 32rpx;
}

.form-textarea {
  font-size: 28rpx;
  color: #1A202C;
  height: 120rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ========== 鏉愭枡涓婁紶鍖哄煙 ========== */
.material-section {
  background: var(--bg-white);
  margin-top: 20rpx;
  padding: 30rpx;
}

.material-dash-box {
  border: 3rpx dashed var(--text-hint);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  background: var(--bg-light);
}

.material-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.material-title-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.material-icon-large {
  width: 48rpx;
  height: 48rpx;
}

.material-add-text {
  font-size: 28rpx;
  color: #1A202C;
  text-align: center;
  display: block;
  margin-top: 12rpx;
}

.material-title {
  font-size: 28rpx;
  color: #1A202C;
  font-weight: 500;
}

.required {
  color: #5B6FE8;
  margin-left: 4rpx;
}

.material-list {
  margin-top: 24rpx;
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: 20rpx;
}

.material-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.material-item:last-child {
  border-bottom: none;
}

.material-type-label {
  font-size: 26rpx;
  color: #1A202C;
  width: 140rpx;
  flex-shrink: 0;
}

.material-thumb-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  flex: 1;
}

.material-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border-color);
}

.material-delete {
  width: 24rpx;
  height: 24rpx;
  padding: 8rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.material-note {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 24rpx;
}

.note-icon {
  font-size: 22rpx;
}

.note-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.arrow {
  font-size: 36rpx;
  color: var(--text-disabled);
}

/* ========== 娓╅Θ鎻愮ず ========== */
.material-tips {
  background: #F8F7FC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
}

/* ========== 娉ㄦ剰浜嬮」 ========== */
.tips-warning {
  display: flex;
  align-items: center;
  background: #FFF1F0;
  border: 1rpx solid #FFA39E;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.warning-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #5B6FE8;
  font-weight: 500;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.tips-sub {
  font-size: 24rpx;
  color: #1A202C;
  margin-bottom: 12rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #1A202C;
  line-height: 1.6;
}

.tips-note {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.tips-highlight {
  font-size: 26rpx;
  color: var(--primary-dark);
  line-height: 2;
}

.tips-divider {
  height: 1rpx;
  background: #C8D4E5;
  margin: 12rpx 0;
}

/* ========== 鍚堣璇存槑 ========== */
.compliance-section {
  background: var(--bg-white);
  margin-top: 20rpx;
  padding: 24rpx 30rpx;
}

.compliance-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 2;
}

/* ========== 璁㈠崟淇℃伅 ========== */
.info-section {
  background: var(--bg-white);
  margin-top: 20rpx;
  padding: 30rpx;
}

.info-list {
  background: var(--bg-color);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #1A202C;
}

.info-value {
  font-size: 28rpx;
  color: #1A202C;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
}

.bottom-placeholder {
  height: 40rpx;
}

/* ========== 搴曢儴浠樻鏍?========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgb(0 0 0 / 0.05);
  transition: all 0.3s ease;
}

.price-section {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 28rpx;
  color: #1A202C;
}

.price-symbol {
  font-size: 28rpx;
  color: #5B6FE8;
  margin-left: 8rpx;
}

.price-value {
  font-size: 48rpx;
  color: #5B6FE8;
  font-weight: 700;
}

.pay-btn {
  background: var(--primary-color);
  color: var(--bg-white);
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 60rpx;
  border-radius: 20rpx;
  border: none;
  line-height: 1;
}

.pay-btn.disabled {
  background: var(--disabled-bg);
  color: var(--text-secondary);
}

.pay-btn::after {
  border: none;
}

.svg-icon {
  width: 24rpx;
  height: 24rpx;
}