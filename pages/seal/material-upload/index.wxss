/* pages/seal/material-upload/index.wxss */

/* ========== 妞ょ敻娼伴崺铏诡攨閺嶅嘲绱?========== */
.page {
  background: #F8F7FC;
  min-height: 100vh;
}

/* ========== 瀵艰埅鏍?========== */

.nav-back {
  position: absolute;
  left: 32rpx;

  /* top 鐢?inline style 鍔ㄦ€佹彁渚涳紝涓庤兌鍥婃寜閽瀭鐩村眳涓? */
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  z-index: 2;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%; transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
  white-space: nowrap;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}

/* ========== 鐎圭懓娅掔敮鍐ㄧ湰 ========== */
.container {
  padding: 24rpx 32rpx;
  padding-bottom: 180rpx;
}

/* ========== 濡€虫健 ========== */
.module {
  margin-bottom: 32rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.module-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.title-note {
  font-size: 22rpx;
  color: #6B7280;
}

.photo-note-red {
  color: #5B6FE8;
}

/* ========== 娑撳﹣绱堕崠鍝勭厵 ========== */
.upload-row {
  display: flex;
  gap: 24rpx;
}

.upload-item {
  flex: 1;
  position: relative;
}

.upload-single {
  width: 100%;
  position: relative;
}

.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.upload-item-sm {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.add-more {
  border: 2rpx dashed #D0D5DD;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 鍒犻櫎鎸夐挳 ========== */
.delete-btn {
  position: absolute;
  top: 0; right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgb(0 0 0 / 0.45);
  border-radius: 0 12rpx 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 澶у浘涓婁紶妲界殑鍒犻櫎鎸夐挳 */
.delete-btn-lg {
  position: absolute;
  top: 0; right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgb(0 0 0 / 0.45);
  border-radius: 0 20rpx 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.delete-btn-sm {
  position: absolute;
  top: 0; right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgb(0 0 0 / 0.45);
  border-radius: 0 12rpx 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
}

/* ========== 娑撳﹣绱堕崡鐘辩秴缁?========== */
.upload-placeholder {
  height: 200rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx dashed #D0D5DD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.upload-placeholder-lg {
  height: 200rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx dashed #D0D5DD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

/* ===== 涓婁紶缂╃暐鍥撅紙鎷嶅畬鐓у悗鏄剧ず锛?===== */
.upload-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 20rpx;
  display: block;
  position: relative;
}

.upload-thumb-lg {
  width: 100%;
  height: 200rpx;
  border-radius: 20rpx;
  display: block;
}

.upload-thumb-sm {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: block;
}

/* 宸︿笂瑙掔豢鑹插鍕捐鏍? */
.check-badge {
  position: absolute;
  top: 0; left: 0;
  width: 44rpx;
  height: 44rpx;
  background: #5B6FE8;
  border-radius: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  font-weight: bold;
  z-index: 2;
}

.check-badge-sm {
  position: absolute;
  top: 0; left: 0;
  width: 36rpx;
  height: 36rpx;
  background: #5B6FE8;
  border-radius: 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  font-weight: bold;
  z-index: 2;
}

.upload-placeholder-add {
  height: 160rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx dashed #D0D5DD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.card-style {
  border-radius: 20rpx;
}

.placeholder-emoji {
  width: 48rpx;
  height: 48rpx;
}

.placeholder-label {
  font-size: 24rpx;
  color: #6B7280;
}

.star {
  color: #F53F3F;
}

/* ========== 閸旂姴褰块崶鐐垼 ========== */
.plus-icon-lg {
  font-size: 48rpx;
  color: #6B7280;
  line-height: 1;
}

.plus-icon-xl {
  font-size: 64rpx;
  color: #6B7280;
  line-height: 1;
}

/* ========== 琛ュ厖鎵嬬画鎻愮ず ========== */
.additional-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #6B7280;
  padding-left: 8rpx;
}

/* ========== 鎼存洟鍎撮崡鐘辩秴 ========== */
.bottom-placeholder {
  height: 20rpx;
}

/* ========== 鎼存洟鍎撮幓鎰唉閹稿鎸?========== */

/* ========== 瑙勮寖鎻愮ず鏂囧瓧锛堟瘡涓笂浼犳ā鍧椾笅鏂癸級 ===== */
.spec-tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #F8F7FC;
  border-radius: 12rpx;
}

.spec-tip-warn {
  background: #FFF7F0;
  border: 1rpx solid #FFE0C0;
}

.spec-tip-gray {
  background: #F8F7FC;
}

.spec-tip-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
  display: block;
}

.spec-warn {
  color: #C06000;
}

.spec-gray {
  color: #999;
}

/* ===== 鏍囬鍙充晶 ===== */
.title-row-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* ===== 鏍囬澶囨敞 ===== */
.title-note {
  font-size: 24rpx;
  color: #999;
  max-width: 280rpx;
  text-align: right;
}

.title-note-gray {
  font-size: 24rpx;
  color: #B8C4D4;
}

/* ===== 澶у彿 emoji 鍥炬爣 ===== */
.placeholder-emoji-lg {
  width: 64rpx;
  height: 64rpx;
  font-size: 56rpx;
  display: block;
  margin: 0 auto 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgb(0 0 0 / 0.05);
  z-index: 50;
  transition: all 0.3s ease;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background: #D0D5DD;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

button.submit-btn::after {
  border: none;
}

.submit-btn.active {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  box-shadow: 0 8rpx 24rpx rgba(91, 111, 232, 0.3);
}

.submit-btn.active:active {
  box-shadow: 0 4rpx 12rpx rgba(91, 111, 232, 0.25);
  transform: scale(0.98);
}
