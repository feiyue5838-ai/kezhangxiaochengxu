/* pages/seal/reviews/my/index.wxss — 我提交的评价 */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* Tabs */
.my-tabs {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}

.my-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  padding: 24rpx 0;
  position: relative;
}

.my-tab.active {
  color: #5B6FE8;
  font-weight: 600;
}

.my-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #5B6FE8;
}

/* 列表 */
.my-list {
  padding: 24rpx;
}

.my-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.my-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.my-item-badges {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.badge--pending {
  background: #fff7e6;
  color: #fa8c16;
}

.badge--approved {
  background: #f0fff0;
  color: #52c41a;
}

.badge--rejected {
  background: #fff0e6;
  color: #e05050;
}

.my-item-order {
  font-size: 22rpx;
  color: #9097a1;
}

.my-item-date {
  font-size: 22rpx;
  color: #9097a1;
}

.my-item-stars {
  display: flex;
  align-items: center;
  margin: 8rpx 0;
}

.star-label {
  font-size: 24rpx;
  color: #6b7280;
  width: 130rpx;
}

.star {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.my-item-text {
  display: block;
  font-size: 28rpx;
  color: #1f2329;
  margin-top: 12rpx;
  line-height: 1.6;
}

.reject-box {
  margin-top: 16rpx;
  background: #fff5f5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
}

.reject-label {
  color: #e05050;
}

.reject-text {
  color: #8a5a5a;
}

/* 空态 / 加载 / 未登录 */
.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #9097a1;
  display: block;
}

.empty-btn {
  margin: 32rpx auto 0;
  width: 240rpx;
  background: #5B6FE8;
  color: #fff;
  font-size: 28rpx;
  border-radius: 32rpx;
  padding: 16rpx 0;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #9097a1;
}

.login-tip {
  text-align: center;
  padding: 120rpx 40rpx;
}

.login-tip-text {
  font-size: 26rpx;
  color: #9097a1;
  display: block;
  margin-bottom: 32rpx;
}

.login-tip-btn {
  width: 240rpx;
  margin: 0 auto;
  background: #5B6FE8;
  color: #fff;
  font-size: 28rpx;
  border-radius: 32rpx;
  padding: 16rpx 0;
}
