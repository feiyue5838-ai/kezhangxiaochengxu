<!--pages/seal/reviews/index.wxml-->
<view class="page">
  <view class="review-header">
    <text class="review-total">共 {{reviewList.length}} 条评价</text>
  </view>

  <view class="review-list">
    <view class="review-item" wx:for="{{reviewList}}" wx:key="id">
      <view class="review-top">
        <text class="review-phone">{{item.maskedPhone}}</text>
        <text class="review-date">{{item.date}}</text>
      </view>
      <view class="review-stars">
        <text class="star-label">服务态度</text>
        <text class="star {{item.serviceScore > s ? 'active' : ''}}" wx:for="{{5}}" wx:for-item="s"><text style="font-size:24rpx;">&#11088;</text></text>
      </view>
      <view class="review-stars">
        <text class="star-label">刻章质量</text>
        <text class="star {{item.qualityScore > s ? 'active' : ''}}" wx:for="{{5}}" wx:for-item="s"><text style="font-size:24rpx;">&#11088;</text></text>
      </view>
      <text class="review-text">{{item.text}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{reviewList.length === 0}}">
    <text class="empty-text">暂无评价</text>
  </view>

  <!-- 底部写评价按钮 -->
  <view class="bottom-bar">
    <view class="write-btn" bindtap="goWriteReview">评论</view>
  </view>
  <view class="bottom-placeholder"></view>
</view>
