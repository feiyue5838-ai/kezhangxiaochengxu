/* pages/seal/reviews/index.wxss */
.page {
  background: var(--bg-color);
  min-height: 100vh;
  padding: 20rpx;
  padding-top: calc(88rpx + env(safe-area-inset-top) + 20rpx);
}

.review-header {
  background: var(--bg-white);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.review-total {
  font-size: 28rpx;
  color: var(--text-regular);
}

.review-item {
  background: var(--bg-white);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.review-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.review-phone {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.review-date {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.review-stars {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.star-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-right: 10rpx;
}

.star {
  font-size: 24rpx;
  color: var(--border-color);
  margin-right: 4rpx;
}

.star.active {
  color: var(--star-color);
}

.review-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin-top: 10rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-white);
  padding: 16rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgb(0 0 0 / 0.06);
  z-index: 999;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  transition: all 0.3s ease;
}

.write-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  color: var(--bg-white);
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 20rpx;
}

.bottom-placeholder {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.star-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 我的评价入口（header 右侧） */
.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.my-review-entry {
  font-size: 24rpx;
  color: #5B6FE8;
  padding: 8rpx 20rpx;
  background: rgba(91, 111, 232, 0.08);
  border-radius: 24rpx;
}
