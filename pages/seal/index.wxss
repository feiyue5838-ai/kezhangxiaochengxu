/* pages/seal/index.wxss */

/* ========== 瀵艰埅鏍?========== */

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-side {
  position: absolute;
  top: 0; bottom: 0;
  display: flex;
  align-items: center;
}
.nav-side--left  { left: 32rpx; }
.nav-side--right { right: 32rpx; }

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
page { background: #F8F7FC; min-height: 100vh; }
.page { background: #F8F7FC; min-height: 100vh; }

/* ========== Hero ========== */
.hero {
  position: relative;
  padding: 44rpx 36rpx 50rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  overflow: hidden;
}

.hero-glow-1 {
  position: absolute;
  top: -30%;
  left: -10%;
  width: 480rpx;
  height: 480rpx;
  background: radial-gradient(circle, rgb(255 255 255 / 0.18) 0%, transparent 65%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow-2 {
  position: absolute;
  bottom: -20%;
  right: -15%;
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, rgb(255 255 255 / 0.10) 0%, transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-label {
  font-size: 20rpx;
  color: rgb(255 255 255 / 0.85);
  font-weight: 600;
  letter-spacing: 4rpx;
  display: block;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.25;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgb(255 255 255 / 0.8);
  letter-spacing: 1rpx;
  margin-bottom: 32rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* 缁熻鏉?*/
.hero-stats {
  display: flex;
  align-items: center;
  background: rgb(255 255 255 / 0.15);
  backdrop-filter: blur(8px);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid rgb(255 255 255 / 0.2);
  margin-bottom: 26rpx;
  position: relative;
  z-index: 1;
}

.stat-item { flex: 1; text-align: center; }

.stat-num {
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
  display: block;
}

.stat-label {
  font-size: 20rpx;
  color: rgb(255 255 255 / 0.7);
  margin-top: 4rpx;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 36rpx;
  background: rgb(255 255 255 / 0.18);
}

/* 寰界珷 */
.hero-badges {
  display: flex;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.badge {
  padding: 10rpx 22rpx;
  background: rgb(255 255 255 / 0.18);
  border-radius: 20rpx;
  border: 1rpx solid rgb(255 255 255 / 0.22);
}

.badge text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

/* ========== 鍒嗙被鍖哄煙 ========== */
.section {
  padding: 28rpx 24rpx 12rpx;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
  border-radius: 20rpx 32rpx 0 0;
  background: #F8F7FC;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

/* ===== 涓诲崱鐗囷細浼佷笟鍒荤珷锛堣法涓ゅ垪锛?===== */
.cat-card--featured {
  grid-column: span 2;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 6rpx 24rpx rgb(91 111 232 / 0.18);
}

.cat-card--featured:active {
  transform: scale(0.98);
  box-shadow: 0 10rpx 36rpx rgb(91 111 232 / 0.28);
}

.card-inner {
  display: flex;
  align-items: center;
  padding: 28rpx;
  position: relative;
  z-index: 1;
}

/* 鍏夋劅鏉＄汗 */
.card-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  pointer-events: none;
}

.cat-card--featured:active .card-shine {
  animation: shine 0.5s ease forwards;
}

@keyframes shine {
  to { left: 200%; }
}

.icon-wrap--dark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: rgb(255 255 255 / 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 1rpx solid rgb(255 255 255 / 0.15);
  color: #fff;
}

.card-info {
  flex: 1;
}

.cat-card--featured .cat-name {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.cat-card--featured .cat-desc {
  font-size: 24rpx;
  color: rgb(255 255 255 / 0.7);
  display: block;
}

.card-arrow-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgb(255 255 255 / 0.12);
}

.card-arrow-circle .card-arrow {
  font-size: 34rpx;
  color: rgb(255 255 255 / 0.7);
  line-height: 1;
}

/* ===== 鍓崱鐗囬€氱敤鏍峰紡 ===== */
.cat-card--small {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgb(91 111 232 / 0.06);
  position: relative;
}

.cat-card--small::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  opacity: 0;
  transition: opacity 0.2s;
}

.cat-card--small:active::before { opacity: 1; }
.cat-card--small:active { transform: scale(0.97); }

.cat-card--small .card-inner {
  display: flex;
  flex-direction: column;
  padding: 22rpx 20rpx 18rpx;
}

.icon-wrap--light {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  color: #7B5CFA;
}

/* SVG 鍥炬爣灏哄 */
.cat-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.cat-icon-img--sm {
  width: 36rpx;
  height: 36rpx;
}

.cat-card--small .cat-icon {
  font-size: 38rpx;
}

.cat-name--sm {
  font-size: 27rpx;
  color: #1A202C;
  font-weight: 600;
  margin-bottom: 4rpx !important;
}

.cat-desc--sm {
  font-size: 21rpx;
  color: #8E99AB;
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: block;
}

.card-arrow--sub {
  font-size: 28rpx;
  color: #C0C8D4;
  align-self: flex-end;
  line-height: 1;
}

/* ========== 搴曢儴淇′换鏍?========== */
.trust-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 28rpx 40rpx 52rpx;
}

.trust-line {
  width: 28rpx;
  height: 1rpx;
  background: #D5DDE8;
}

.trust-text {
  font-size: 22rpx;
  color: #A8B4C5;
  letter-spacing: 0.5rpx;
}

/* 搴曢儴瀹夊叏鍖?*/
.safe-bottom {
  height: env(safe-area-inset-bottom);
  width: 100%;
}
