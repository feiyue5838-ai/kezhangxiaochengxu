<!--pages/seal/form/index.wxml-->
<view class="page">
  <!-- 自定义导航栏 -->
  <nav-bar title="{{pageTitle}}" bind:back="goBack"></nav-bar>

  <!-- 内容区域 -->
  <view class="content">
  <!-- ========== 刻章备案查询模式 ========== -->
  <block wx:if="{{isQuery}}">
    <!-- 1. 顶部地区选择（picker 形式） -->
    <picker mode="selector" range="{{provinces}}" range-key="name" value="{{provinceIndex}}" bindchange="onProvinceChange">
      <view class="query-location-bar">
        <icon type="location" size="18" color="#7B5CFA" style="margin-right:8rpx;vertical-align:middle;"></icon>
        <text class="query-location-city">{{currentProvince.name}}</text>
        <text class="query-location-arrow">▼</text>
      </view>
    </picker>

    <!-- 3. 平台信息卡片 -->
    <view class="query-platform-card">
      <view class="query-platform-header">
        <text style="margin-right:4rpx;vertical-align:middle;">🔄</text>
        <text class="query-platform-title">{{currentProvince.platformName || currentProvince.name + '印章查询平台'}}</text>
      </view>
      <view class="query-platform-url">
        <text class="query-platform-link">{{currentProvince.url || '暂无网址'}}</text>
      </view>
      <view class="query-platform-actions" wx:if="{{currentProvince.url}}">
        <view class="query-platform-btn" bindtap="onGoVerify">
          <text>前往验证</text>
          <text style="font-size:20rpx;">›</text>
        </view>
      </view>
      <view class="query-platform-tip">
        <text class="query-platform-tip-text">查询结果以当地公安机关备案信息为准</text>
      </view>
    </view>



    <!-- 5. 信任提示 -->
    <view class="query-trust-card">
      <text style="font-size:20rpx;">✔</text>
      <view class="query-trust-content">
        <text class="query-trust-title">正规备案，平台代办，公安监管</text>
        <text class="query-trust-desc">所有印章均通过公安指定刻章单位制作，备案信息同步至公安机关管理系统</text>
      </view>
    </view>
  </block>

  <!-- ========== 原有刻章表单模式 ========== -->
  <block wx:else>
  <!-- 1. 顶部营销Banner -->
  <stamp-promo-banner wx:if="{{!isPersonal && !isElectronic}}" />

  <!-- 2. 表单填写区（仅企业显示） -->
  <stamp-apply-form id="stampForm" wx:if="{{!isPersonal && !isElectronic}}" bind:formchange="onFormChange" bind:openregion="onOpenRegion" />

  <!-- 地区选择弹窗（页面级，稳定性更好） -->
  <view class="region-mask" wx:if="{{showRegion}}" bindtap="closeRegion"></view>
  <view class="region-panel" wx:if="{{showRegion}}" catchtap="preventBubble">
    <view class="region-header">
      <text class="region-btn cancel" bindtap="closeRegion">取消</text>
      <text class="region-title">选择地区</text>
      <text class="region-btn confirm" bindtap="confirmRegion">确定</text>
    </view>
    <picker-view class="region-pv" value="{{ri}}" bindchange="onRegionChange" indicator-style="height:88rpx;">
      <picker-view-column><view class="region-cell" wx:for="{{ps}}">{{item}}</view></picker-view-column>
      <picker-view-column><view class="region-cell" wx:for="{{cs}}">{{item}}</view></picker-view-column>
      <picker-view-column><view class="region-cell" wx:for="{{ds}}">{{item}}</view></picker-view-column>
    </picker-view>
  </view>

  <!-- 3. 电子印章选择区（2列网格，与个人印章风格对齐） -->
  <view class="seal-select-section" wx:if="{{isElectronic}}">
    <view class="seal-select-title">选择印章类型</view>
    <view class="seal-grid">
      <view
        class="seal-grid-item {{selectedElectronicCategory === item.id ? 'active' : ''}}"
        wx:for="{{electronicSeals}}"
        wx:key="id"
        bindtap="onElectronicSealSelect"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-subcategoryid="{{item.subCategoryId}}"
      >
        <text class="seal-grid-item-text">{{item.name}}</text>
        <view class="seal-check" wx:if="{{selectedElectronicCategory === item.id}}">
          <text class="seal-check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3. 个人印章选择区（2格卡片） -->
  <view class="seal-select-section" wx:if="{{isPersonal}}">
    <view class="seal-select-title">选择印章类型</view>
    <view class="seal-grid">
      <view class="seal-grid-item {{selectedCategory === 9 ? 'active' : ''}}" bindtap="onOpenPersonalSeals">
        <text class="seal-grid-item-text">个人印章</text>
        <view class="seal-check" wx:if="{{selectedCategory === 9}}">
          <text class="seal-check-icon">✓</text>
        </view>
      </view>
      <view class="seal-grid-item {{selectedCategory === 10 ? 'active' : ''}}" bindtap="onOpenProfessionalSeals">
        <text class="seal-grid-item-text">个人职业章</text>
        <view class="seal-check" wx:if="{{selectedCategory === 10}}">
          <text class="seal-check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 4. 用户评价模块 -->
  <user-comment-block isPersonal="{{isPersonal}}" />

  <!-- 5. 反馈问答模块 -->
  <question-answer-module isPersonal="{{isPersonal}}" />

  <!-- 6. 业务介绍图 -->
  <business-introduce-card isPersonal="{{isPersonal}}" />

  <!-- 7. 底部提交按钮（电子印章/个人印章不需要，点击卡片直接下一步） -->
  <form-submit-btn wx:if="{{!isElectronic && !isPersonal}}" enabled="{{formValid}}" bind:submit="onSubmit" />

  <!-- 8. 半屏弹窗 -->
  <half-screen-popup id="sealPopup" title="{{popupTitle}}" source-title="{{pageTitle}}" licenseRegion="{{currentRegion}}" bind:confirm="onSealConfirm"></half-screen-popup>
  </block>
  </view>
</view>
