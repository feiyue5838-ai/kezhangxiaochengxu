/* pages/seal/form/index.wxss */

/* ========== 导航�?========== */
.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
}

.nav-back {
  position: absolute;
  left: 32rpx;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  z-index: 2;
}

.nav-title {
  position: absolute;
  left: 50%;
  top: 50%; transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
  white-space: nowrap;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}

/* 妞ょ敻娼伴崘鍛啇閸? */
.page {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 0;
}

.page ::v-deep .intro-card,
.page .intro-card {
  border: none;
  box-shadow: none;
  outline: none;
}

/* ===== 閸掕崵鐝锋径鍥攳閺屻儴顕楅弽宄扮础 ===== */
.query-location-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: var(--bg-white);
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
}

.query-location-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.query-location-city {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}

.query-location-arrow {
  font-size: 40rpx;
  color: var(--text-secondary);
  line-height: 1;
  transition: transform 0.2s;
}

.query-location-arrow.open {
  transform: rotate(180deg);
}

/* 閸╁骸绔舵稉瀣閸掓�? */
.query-city-dropdown {
  margin: -10rpx 24rpx 0;
  background: var(--bg-white);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgb(0 0 0 / 0.08);
}

.query-city-item {
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--border-color);
}

.query-city-item:last-child {
  border-bottom: none;
}

.query-city-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

/* 楠炲啿褰存穱鈩冧紖閸楋紕�? */
.query-platform-card {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: var(--bg-white);
  border-radius: 20rpx;
}

.query-platform-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.query-platform-badge {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.query-platform-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.query-platform-url {
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.query-platform-link {
  font-size: 24rpx;
  color: var(--primary-color);
  word-break: break-all;
  line-height: 1.6;
}

.query-platform-actions {
  margin-bottom: 20rpx;
}

.query-platform-btn {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 48rpx;
  background: var(--primary-color);
  color: #FFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.query-platform-btn-arrow {
  margin-left: 8rpx;
  width: 24rpx;
  height: 24rpx;
}

.query-platform-tip {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.query-platform-tip-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 鐠囧瓨妲戞穱鈩冧�?*/
.query-info-section {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 32rpx;
  background: var(--bg-white);
  border-radius: 20rpx;
}

.query-info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.query-info-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.query-info-item:last-child {
  margin-bottom: 0;
}

.query-info-dot {
  color: var(--primary-color);
  margin-right: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.query-info-text {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.6;
}

/* 娣団€叉崲閹绘劗�? */
.query-trust-card {
  margin: 0 24rpx 40rpx;
  padding: 28rpx 32rpx;
  background: rgb(12 26 46 / 0.06);
  border-radius: 20rpx;
  display: flex;
  align-items: flex-start;
}

.query-trust-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.query-trust-content {
  flex: 1;
}

.query-trust-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-color);
  display: block;
  margin-bottom: 8rpx;
}

.query-trust-desc {
  font-size: 24rpx;
  color: var(--text-regular);
  line-height: 1.6;
}

/* 閸楁壆鐝烽柅澶嬪閸栫尨绱欑€靛綊缍?select 妞ゅ灚鐗卞蹇ョ�?*/
.seal-select-section {
  padding: 30rpx 30rpx 10rpx;
}

.seal-select-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* 2閸掓缍夐弽纭风礄閿?select 妞ゅ吀绔撮懛杈剧礆 */
.seal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.seal-grid-item {
  background: var(--bg-white);
  border-radius: 20rpx;
  border: 2rpx solid var(--primary-color);
  padding: 40rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  box-sizing: border-box;
}

.seal-grid-item-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 闁鑵戦敓? */
.seal-grid-item.active {
  background: var(--primary-bg);
}

.seal-grid-item.active .seal-grid-item-text {
  color: var(--primary-dark);
  font-weight: 600;
}

/* 閸欏厖绗傜憴鎺戝瑎闁顫楅�? */
.seal-check {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-top: 36rpx solid var(--primary-color);
  border-left: 36rpx solid transparent;
}

.seal-check-icon {
  position: absolute;
  top: -28rpx;
  right: 4rpx;
  width: 24rpx;
  height: 24rpx;
}

/* 閿熸枻鎷烽敓鏂ゆ嫹鍗伴敓鏂ゆ嫹閫夐敓鏂ゆ嫹閿熸枻�? */
/* ����ѡ�񵯴� */
.region-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
}
.region-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 800rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 10000;
  padding-bottom: env(safe-area-inset-bottom);
}
.region-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}
.region-btn { font-size: 28rpx; }
.cancel { color: #999; }
.confirm { color: #5B6FE8; font-weight: 500; }
.region-title { font-size: 32rpx; font-weight: 600; color: #333; }
.region-pv { height: 400rpx; margin: 0; }
.region-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
}
