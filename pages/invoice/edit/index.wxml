<view class="page">
  <!-- 导航栏 -->
  <nav-bar title="发票信息" bind:back="goBack" />

  <view class="content">

    <!-- 发票类型选择 -->
    <view class="section-title">发票类型</view>
    <view class="type-card-row">
      <view class="type-card {{invoiceType === 'normal' ? 'selected' : ''}}" bindtap="switchType" data-type="normal">
        <image class="type-icon" src="/assets/icons/icon-invoice-normal.svg" mode="aspectFit" />
        <text class="type-name">普通发票</text>
        <text class="type-desc">电子普票，开具后发送至邮箱</text>
      </view>
      <view class="type-card {{invoiceType === 'special' ? 'selected' : ''}}" bindtap="switchType" data-type="special">
        <image class="type-icon" src="/assets/icons/icon-invoice-special.svg" mode="aspectFit" />
        <text class="type-name">专用发票</text>
        <text class="type-desc">增值税专用发票，需认证抵扣</text>
      </view>
    </view>

    <!-- ========== 普通发票 ========== -->
    <block wx:if="{{invoiceType === 'normal'}}">
      <!-- 抬头类型 -->
      <view class="section-title">发票抬头</view>
      <view class="title-type-row">
        <view class="title-type-btn {{normal.titleType === 'personal' ? 'selected' : ''}}" bindtap="switchTitleType" data-tt="personal">个人 / 非企业单位</view>
        <view class="title-type-btn {{normal.titleType === 'company' ? 'selected' : ''}}" bindtap="switchTitleType" data-tt="company">企业单位</view>
      </view>

      <!-- 填写表单 -->
      <view class="form-card">
        <view class="form-row">
          <text class="form-label"><text class="required">*</text>发票抬头</text>
          <input class="form-input" value="{{normal.title}}" bindinput="onNormalInput" data-field="title" placeholder="请输入发票抬头" maxlength="50" />
        </view>
        <!-- 企业需填税号 -->
        <block wx:if="{{normal.titleType === 'company'}}">
          <view class="form-row">
            <text class="form-label"><text class="required">*</text>税号</text>
            <input class="form-input" value="{{normal.taxNumber}}" bindinput="onNormalInput" data-field="taxNumber" placeholder="请输入统一社会信用代码" maxlength="20" />
          </view>
        </block>
        <view class="form-row">
          <text class="form-label">税号</text>
          <input class="form-input" value="{{normal.taxNumber}}" bindinput="onNormalInput" data-field="taxNumber" placeholder="{{normal.titleType === 'personal' ? '选填（个人可填身份证号）' : '选填'}}" maxlength="20" />
        </view>
        <view class="form-row" style="flex-direction: column; align-items: flex-start;">
          <text class="form-label" style="width:100%; margin-bottom:12rpx;">接收邮箱</text>
          <input class="form-input" style="text-align:left; width:100%;" value="{{normal.email}}" bindinput="onNormalInput" data-field="email" placeholder="发票开具后发送至此邮箱（选填）" type="text" />
        </view>
      </view>

      <!-- 温馨提示 -->
      <view class="tip-box">
        <text class="tip-title">温馨提示</text>
        <text class="tip-item">• 电子普通发票与纸质发票具有同等法律效力</text>
        <text class="tip-item">• 发票内容默认为"服务费"，如有特殊要求请备注</text>
        <text class="tip-item">• 发票将在订单完成后 1-3 个工作日内开具</text>
      </view>
    </block>

    <!-- ========== 专用发票 ========== -->
    <block wx:if="{{invoiceType === 'special'}}">
      <view class="section-title">开票信息</view>
      <view class="form-card">
        <view class="form-row">
          <text class="form-label"><text class="required">*</text>企业名称</text>
          <input class="form-input" value="{{special.title}}" bindinput="onSpecialInput" data-field="title" placeholder="请输入企业全称" maxlength="50" />
        </view>
        <view class="form-row">
          <text class="form-label"><text class="required">*</text>税号</text>
          <input class="form-input" value="{{special.taxNumber}}" bindinput="onSpecialInput" data-field="taxNumber" placeholder="统一社会信用代码（18位）" maxlength="20" />
        </view>
        <view class="form-row" style="flex-direction: column; align-items: flex-start;">
          <text class="form-label" style="width:100%;"><text class="required">*</text>注册地址</text>
          <textarea class="form-textarea" value="{{special.address}}" bindinput="onSpecialInput" data-field="address" placeholder="请输入企业注册地址" maxlength="100" auto-height />
        </view>
        <view class="form-row">
          <text class="form-label"><text class="required">*</text>电话号码</text>
          <input class="form-input" value="{{special.phone}}" bindinput="onSpecialInput" data-field="phone" type="number" maxlength="11" placeholder="注册电话" />
        </view>
        <view class="form-row">
          <text class="form-label"><text class="required">*</text>开户银行</text>
          <input class="form-input" value="{{special.bankName}}" bindinput="onSpecialInput" data-field="bankName" placeholder="如：招商银行成都分行" maxlength="30" />
        </view>
        <view class="form-row">
          <text class="form-label"><text class="required">*</text>银行账号</text>
          <input class="form-input" value="{{special.bankAccount}}" bindinput="onSpecialInput" data-field="bankAccount" type="number" placeholder="请输入对公账户" maxlength="30" />
        </view>
      </view>

      <!-- 温馨提示 -->
      <view class="tip-box">
        <text class="tip-title">温馨提示</text>
        <text class="tip-item">• 增值税专用发票需认证后方可抵扣</text>
        <text class="tip-item">• 开票信息必须与营业执照完全一致，否则无法抵扣</text>
        <text class="tip-item">• 专用发票开具后预计 3-5 个工作日送达</text>
      </view>
    </block>

  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="btn-clear" bindtap="clearInvoice">清空</button>
    <button class="btn-save" bindtap="saveInvoice">保存发票信息</button>
  </view>
</view>
