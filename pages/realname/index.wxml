<view class="page">
  <!-- 导航栏 -->
  <nav-bar title="实名认证" bind:back="onBack" />

  <view class="verify-wrap">

    <!-- 认证状态卡片 -->
    <view class="status-card">
      <image class="status-icon" src="{{statusIcon}}" mode="aspectFit" />
      <text class="status-title">{{statusTitle}}</text>
      <text class="status-desc">{{statusDesc}}</text>
      <text class="status-badge {{statusBadgeClass}}">{{statusBadgeText}}</text>
    </view>

    <!-- 认证选择页（未认证时展示两个入口） -->
    <view class="form-card" wx:if="{{verifyStatus === 0 && !showIdCardForm}}">
      <view class="form-title">选择认证方式</view>

      <!-- 方式一：微信实名认证（推荐） -->
      <view class="verify-method-card" bindtap="onStartWechatVerify">
        <view class="verify-method-left">
          <view class="verify-method-icon">
            <image src="/assets/icons/wechat-icon.svg" mode="aspectFit" />
          </view>
          <view class="verify-method-info">
            <text class="verify-method-title">微信实名认证</text>
            <text class="verify-method-desc">自动获取微信已认证身份，一键完成</text>
          </view>
        </view>
        <view class="verify-method-tag">推荐</view>
      </view>

      <!-- 方式二：上传身份证（兜底） -->
      <view class="verify-method-card" bindtap="showIdCardForm">
        <view class="verify-method-left">
          <view class="verify-method-icon">
            <image src="/assets/icons/idcard-icon.svg" mode="aspectFit" />
          </view>
          <view class="verify-method-info">
            <text class="verify-method-title">上传身份证认证</text>
            <text class="verify-method-desc">手动填写身份信息并上传证件照片</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 身份证上传表单（方案 B，降级入口；认证失败时直接展示） -->
    <view class="form-card" wx:if="{{showIdCardForm || verifyStatus === 2}}">
      <!-- 返回选择按钮（仅方案 B 入口时显示） -->
      <view class="back-btn-row" wx:if="{{showIdCardForm}}">
        <view class="back-btn" bindtap="onBackToChoice">
          <text>&lt; 返回选择认证方式</text>
        </view>
      </view>
      <view class="form-title">基本信息</view>

      <view class="form-row">
        <text class="form-label">姓名 <text>*</text></text>
        <input class="form-input" type="text" placeholder="请输入真实姓名" placeholder-class="form-input--gray"
          value="{{formData.name}}" bindinput="onNameInput" maxlength="20" />
      </view>

      <view class="form-row">
        <text class="form-label">身份证号 <text>*</text></text>
        <input class="form-input" type="idcard" placeholder="请输入18位身份证号" placeholder-class="form-input--gray"
          value="{{formData.idNumber}}" bindinput="onIdNumberInput" maxlength="18" />
      </view>

      <view class="form-title" style="margin-top:32rpx;">身份证照片</view>

      <!-- 身份证正面 -->
      <view class="form-row" style="border-bottom:none;padding-bottom:0;">
        <text class="form-label">人像面</text>
      </view>
      <view wx:if="{{formData.idCardFront}}" class="idcard-preview">
        <image src="{{formData.idCardFront}}" mode="aspectRatio" show-menu-by-longpress />
        <view class="replace-btn" bindtap="onUploadFront">重新上传</view>
      </view>
      <view wx:else class="idcard-add" bindtap="onUploadFront">
        <text>+</text>
        <text class="idcard-add-label">上传身份证人像面</text>
      </view>

      <!-- 身份证国徽面 -->
      <view class="form-row" style="border-bottom:none;padding-bottom:0;margin-top:24rpx;">
        <text class="form-label">国徽面</text>
      </view>
      <view wx:if="{{formData.idCardBack}}" class="idcard-preview">
        <image src="{{formData.idCardBack}}" mode="aspectRatio" show-menu-by-longpress />
        <view class="replace-btn" bindtap="onUploadBack">重新上传</view>
      </view>
      <view wx:else class="idcard-add" bindtap="onUploadBack">
        <text>+</text>
        <text class="idcard-add-label">上传身份证国徽面</text>
      </view>
    </view>

    <!-- 认证信息（已认证时展示） -->
    <view class="form-card" wx:if="{{verifyStatus === 1}}">
      <view class="form-title">认证信息</view>
      <view class="idcard-row">
        <text class="idcard-label">真实姓名</text>
        <text class="idcard-value">{{verifyData.name}}</text>
      </view>
      <view class="idcard-row">
        <text class="idcard-label">身份证号</text>
        <text class="idcard-value">{{verifyData.idNumberMask}}</text>
      </view>
      <view class="idcard-row">
        <text class="idcard-label">认证时间</text>
        <text class="idcard-value">{{verifyData.verifyTime}}</text>
      </view>
    </view>

    <button class="submit-btn {{canSubmit ? '' : 'submit-btn--disabled'}}"
      wx:if="{{showIdCardForm || verifyStatus === 2}}"
      bindtap="onSubmit">
      {{verifyStatus === 2 ? '重新认证' : '提交认证'}}
    </button>

    <button class="submit-btn submit-btn--success" wx:if="{{verifyStatus === 1}}">
      已认证 ✓
    </button>
  </view>
</view>
