/* pages/realname/index.wxss */

page { background: #F8F7FC; }

/* ========== 瀵艰埅鏍?========== */
.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  position: relative;
}

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
.nav-title { font-size: 34rpx; font-weight: 600; color: #fff; text-align: center; }

/* ========== 内容 ========== */
.verify-wrap {
  padding: 0 32rpx 80rpx;
}

.verify-wrap::after {
  content: '';
  display: block;
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}

.status-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgb(91 111 232 / 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-icon { width: 96rpx; height: 96rpx; margin-bottom: 20rpx; }

.status-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A2332;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.status-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.status-badge--pass { background: #F0FFF0; color: #52C41A; }
.status-badge--fail { background: #FFF0E6; color: #FA8C16; }
.status-badge--wait { background: #FFF7E6; color: #FAAD14; }

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgb(91 111 232 / 0.06);
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2332;
  margin-bottom: 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-row:last-child { border-bottom: none; }

.form-label {
  font-size: 28rpx;
  color: #555;
  width: 160rpx;
  flex-shrink: 0;
}
.form-label text { color: #E05050; }

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A2332;
  text-align: right;
}
.form-input--gray { color: #999; }

.idcard-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.idcard-row:last-child { border-bottom: none; padding-bottom: 0; }
.idcard-label { font-size: 28rpx; color: #555; width: 160rpx; flex-shrink: 0; }
.idcard-value { flex: 1; font-size: 28rpx; color: #1A2332; text-align: right; word-break: break-all; }

.idcard-preview {
  margin-top: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.idcard-preview image { width: 100%; display: block; }

.idcard-preview .replace-btn {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

.idcard-add {
  margin-top: 24rpx;
  border: 2rpx dashed #D5DDE8;
  border-radius: 16rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.idcard-add text { font-size: 48rpx; color: #B0BBC8; }
.idcard-add .idcard-add-label { font-size: 24rpx; color: #B0BBC8; }

/* ========== 鎻愪氦鎸夐挳 ========== */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 24rpx rgb(91 111 232 / 0.35);
}
.submit-btn::after { border: none; }
.submit-btn:active { opacity: 0.85; transform: scale(0.98); }

.submit-btn--disabled {
  background: #D5DDE8;
  box-shadow: none;
  color: #8C97A6;
}

.submit-btn--success {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  box-shadow: 0 8rpx 24rpx rgb(82 196 26 / 0.35);
}


/* ======= verify-method cards ======= */
.verify-method-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: #F8F7FC;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}
.verify-method-card:last-child { margin-bottom: 0; }
.verify-method-card:active { border-color: #5B6FE8; background: #EEF0FF; }

.verify-method-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.verify-method-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  flex-shrink: 0;
}
.verify-method-icon image { width: 44rpx; height: 44rpx; }

.verify-method-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.verify-method-title { font-size: 30rpx; font-weight: 600; color: #1A2332; }
.verify-method-desc { font-size: 22rpx; color: #8C97A6; }

.verify-method-tag {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}

/* ======= back button ======= */
.back-btn-row { margin-bottom: 24rpx; }

.back-btn {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  color: #5B6FE8;
  padding: 8rpx 0;
}
.back-btn:active { opacity: 0.7; }
