/* pages/outlet-binding/index.wxss */
page {
  background: #F4F5FB;
  min-height: 100vh;
}

.container {
  padding-bottom: 80rpx;
}

/* 顶部背景 */
.header-bg {
  background: linear-gradient(135deg, #5B6FE8 0%, #8B5CF6 100%);
  padding: calc(88rpx + constant(safe-area-inset-top)) 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.icon-store {
  font-size: 56rpx;
  line-height: 1;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 步骤条 */
.step-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 60rpx;
  background: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(91, 111, 232, 0.06);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #E8EAF6;
  color: #A0A8C8;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #E8EAF6;
  transition: all 0.3s;
}

.step-item.active .step-circle {
  background: #5B6FE8;
  color: #fff;
  border-color: #5B6FE8;
}

.step-label {
  font-size: 20rpx;
  color: #A0A8C8;
  white-space: nowrap;
}

.step-item.active .step-label {
  color: #5B6FE8;
  font-weight: 600;
}

.step-line {
  flex: 1;
  height: 3rpx;
  background: #E8EAF6;
  margin: 0 12rpx;
  margin-bottom: 28rpx;
  transition: background 0.3s;
}

.step-line.active {
  background: #5B6FE8;
}

/* 卡片 */
.card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(91, 111, 232, 0.07);
}

.card.hidden {
  display: none;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2332;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F1F8;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F8F9FF;
  border: 2rpx solid #E8EAF6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1A2332;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: #5B6FE8;
  background: #fff;
}

.form-input::placeholder {
  color: #B8C0D8;
}

/* 主按钮 */
.btn-primary {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #5B6FE8, #8B5CF6);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 46rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(91, 111, 232, 0.35);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 次要按钮 */
.btn-outline {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #E05050;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: 2rpx solid #E05050;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.btn-ghost {
  width: 100%;
  height: 80rpx;
  background: transparent;
  color: #8B90B0;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  font-weight: 500;
}

.btn-next {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #5B6FE8, #8B5CF6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(91, 111, 232, 0.3);
}

.tip-text {
  font-size: 22rpx;
  color: #B8C0D8;
  text-align: center;
  margin-top: 20rpx;
  line-height: 1.6;
}

/* 网点信息 */
.outlet-info {
  background: #F8F9FF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
  border-left: 4rpx solid #5B6FE8;
}

.outlet-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2332;
  margin-bottom: 8rpx;
}

.outlet-addr {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

/* 状态面板 */
.status-panel {
  background: #F8F9FF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-label {
  font-size: 28rpx;
  color: #1A2332;
  font-weight: 500;
}

.status-badge {
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.status-badge.on {
  background: #E8F7E8;
  color: #27AE60;
}

.status-badge.off {
  background: #FFF3E0;
  color: #E67E22;
}

/* 描述文字 */
.desc-text {
  font-size: 26rpx;
  color: #888;
  line-height: 1.7;
  margin-bottom: 28rpx;
  text-align: center;
}

.desc-text.on {
  color: #27AE60;
  font-weight: 500;
}

/* 通知信息 */
.notify-info {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  background: #F8F9FF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.notify-icon {
  font-size: 56rpx;
  line-height: 1;
  flex-shrink: 0;
}

.notify-desc {
  flex: 1;
}

.notify-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2332;
  margin-bottom: 10rpx;
}

.notify-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}

/* 开关行 */
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F1F8;
  margin-bottom: 20rpx;
}

.toggle-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2332;
}

.toggle-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.success-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #E8F7E8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #27AE60;
  font-weight: 600;
  margin: 20rpx 0;
}

.success-icon {
  font-size: 32rpx;
}

/* 完成页 */
.success-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 40rpx;
}

.success-emoji {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A2332;
  margin-bottom: 10rpx;
}

.success-sub {
  font-size: 26rpx;
  color: #888;
}

.summary-list {
  background: #F8F9FF;
  border-radius: 16rpx;
  padding: 8rpx 0;
  margin-bottom: 28rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F0F1F8;
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-value {
  font-size: 28rpx;
  color: #1A2332;
  font-weight: 600;
}

.summary-value.on {
  color: #27AE60;
}

.tip-box {
  background: #EEF2FF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.tip-box-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5B6FE8;
  margin-bottom: 10rpx;
}

.tip-box-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.7;
}
