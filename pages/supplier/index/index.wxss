/* pages/supplier/index/index.wxss */
.page { min-height: 100vh; background: #f5f6fa; }

.login-tip {
  margin: 80rpx 40rpx;
  padding: 60rpx 40rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
}
.tip-title { font-size: 38rpx; font-weight: 600; color: #1a1a1a; }
.tip-desc { font-size: 28rpx; color: #888; margin: 20rpx 0 40rpx; }
.tip-btn { background: #3a7afe; color: #fff; border-radius: 12rpx; font-size: 30rpx; }

.header {
  background: linear-gradient(135deg, #3a7afe, #2f6bff);
  padding: 40rpx 32rpx 30rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.header-name { font-size: 34rpx; font-weight: 600; }
.header-sub { font-size: 26rpx; opacity: 0.9; }

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab-active {
  color: #3a7afe;
  font-weight: 600;
}
.tab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #3a7afe;
}

.order-list { padding: 20rpx; }
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-no { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.order-status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.status-assigned { background: #fff0e6; color: #ff8c00; }
.status-accepted { background: #e6f0ff; color: #3a7afe; }
.status-processing { background: #f0e6ff; color: #8a3aff; }
.status-completed { background: #e6ffe6; color: #2ecc71; }
.status-cancelled { background: #f0f0f0; color: #999; }

.order-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #888;
}
.module-tag {
  background: #f5f6fa;
  color: #555;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.order-express {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-top: 20rpx; }

.loading-tip {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}
