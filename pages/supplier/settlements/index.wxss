/* pages/supplier/settlements/index.wxss */
.page { min-height: 100vh; background: #f5f6fa; }
.header {
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  padding: 40rpx 32rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.header-title { font-size: 34rpx; font-weight: 600; }
.header-sub { font-size: 26rpx; opacity: 0.9; }

.list { padding: 20rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.no { font-size: 28rpx; color: #666; }
.status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.status-pending { background: #fff0e6; color: #ff8c00; }
.status-confirmed { background: #e6f0ff; color: #3a7afe; }
.status-paid { background: #e6ffe6; color: #2ecc71; }
.status-cancelled { background: #f0f0f0; color: #999; }

.card-body { display: flex; justify-content: space-between; align-items: center; }
.period { font-size: 26rpx; color: #888; }
.amount { font-size: 38rpx; font-weight: 700; color: #ff6b35; }
.orders { font-size: 24rpx; color: #999; }

.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-top: 20rpx; }
.loading-tip { text-align: center; padding: 30rpx; font-size: 26rpx; color: #999; }
