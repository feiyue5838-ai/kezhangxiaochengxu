<view class="page" wx:if="{{order}}">
  <!-- 状态头 -->
  <view class="status-header status-{{order.status}}">
    <view class="status-text">{{statusText}}</view>
    <view class="order-no">{{order.orderNo}}</view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <view class="card-title">订单信息</view>
    <view class="row">
      <text class="label">业务类型</text>
      <text class="value">{{order.module === 'seal' ? '刻章' : order.module === 'newspaper' ? '登报' : order.module === 'bookkeeping' ? '记账' : order.module}}</text>
    </view>
    <view class="row">
      <text class="label">供应商</text>
      <text class="value">{{order.supplierName}}</text>
    </view>
    <view class="row" wx:if="{{order.assignedAt}}">
      <text class="label">派单时间</text>
      <text class="value">{{order.assignedAt}}</text>
    </view>
    <view class="row" wx:if="{{order.acceptedAt}}">
      <text class="label">接单时间</text>
      <text class="value">{{order.acceptedAt}}</text>
    </view>
    <view class="row" wx:if="{{order.startedAt}}">
      <text class="label">开始制作</text>
      <text class="value">{{order.startedAt}}</text>
    </view>
    <view class="row" wx:if="{{order.completedAt}}">
      <text class="label">完成时间</text>
      <text class="value">{{order.completedAt}}</text>
    </view>
    <view class="row" wx:if="{{order.cancelReason}}">
      <text class="label">取消原因</text>
      <text class="value">{{order.cancelReason}}</text>
    </view>
    <view class="row" wx:if="{{order.expressCompany}}">
      <text class="label">快递</text>
      <text class="value">{{order.expressCompany}} {{order.expressNo}}</text>
    </view>
    <view class="row" wx:if="{{order.remark}}">
      <text class="label">备注</text>
      <text class="value">{{order.remark}}</text>
    </view>
  </view>

  <!-- 已上传回执展示 -->
  <view class="card" wx:if="{{receipts.length > 0}}">
    <view class="card-title">回执照片（{{receipts.length}}）</view>
    <view class="receipt-list">
      <image wx:for="{{receipts}}" wx:key="index" class="receipt-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewReceipt" data-index="{{index}}"></image>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <block wx:if="{{order.status === 'assigned'}}">
      <button class="btn btn-reject" bindtap="onRejectTap">拒单</button>
      <button class="btn btn-primary" bindtap="onAccept" loading="{{actionLoading}}">接单</button>
    </block>
    <button wx:if="{{order.status === 'accepted'}}" class="btn btn-primary" bindtap="onStart" loading="{{actionLoading}}">开始制作</button>
    <block wx:if="{{order.status === 'processing'}}">
      <button class="btn btn-ghost" bindtap="onUploadReceipt">上传回执</button>
      <button class="btn btn-primary" bindtap="onDeliverTap">发货</button>
    </block>
    <button wx:if="{{order.status === 'completed'}}" class="btn btn-ghost" bindtap="onUploadReceipt">补充回执</button>
  </view>

  <!-- 拒单弹窗 -->
  <view class="mask" wx:if="{{showReject}}" bindtap="onRejectCancel">
    <view class="dialog" catchtap="">
      <view class="dialog-title">拒单</view>
      <textarea
        class="dialog-input"
        placeholder="请填写拒单原因"
        value="{{rejectReason}}"
        bindinput="onRejectInput"
        maxlength="200"
      ></textarea>
      <view class="dialog-btns">
        <button class="btn btn-ghost" bindtap="onRejectCancel">取消</button>
        <button class="btn btn-primary" bindtap="onRejectConfirm" loading="{{actionLoading}}">确认拒单</button>
      </view>
    </view>
  </view>

  <!-- 发货弹窗 -->
  <view class="mask" wx:if="{{showDeliver}}" bindtap="onDeliverCancel">
    <view class="dialog" catchtap="">
      <view class="dialog-title">发货</view>
      <input class="dialog-input" placeholder="快递公司（如：顺丰）" value="{{courier}}" bindinput="onCourierInput" />
      <input class="dialog-input" placeholder="快递单号" value="{{trackingNo}}" bindinput="onTrackingInput" />
      <view class="dialog-btns">
        <button class="btn btn-ghost" bindtap="onDeliverCancel">取消</button>
        <button class="btn btn-primary" bindtap="onDeliverConfirm" loading="{{actionLoading}}">确认发货</button>
      </view>
    </view>
  </view>

  <!-- 回执上传弹窗 -->
  <view class="mask" wx:if="{{showReceipt}}" bindtap="onReceiptCancel">
    <view class="dialog" catchtap="">
      <view class="dialog-title">上传回执</view>
      <view class="dialog-tip">支持 jpg / png / gif / webp / pdf，单张 ≤10MB</view>
      <view class="receipt-upload-area" bindtap="onUploadReceipt">
        <text class="receipt-upload-plus">＋</text>
        <text class="receipt-upload-text">选择图片</text>
      </view>
      <view class="dialog-btns">
        <button class="btn btn-ghost" bindtap="onReceiptCancel">取消</button>
      </view>
    </view>
  </view>
</view>

<view wx:elif="{{!loading}}" class="empty">
  <view class="empty-text">订单不存在或已删除</view>
</view>
<view wx:else class="loading-tip">加载中...</view>
