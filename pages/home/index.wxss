/* pages/home/index.wxss */

/* ========== 页面基础 ========== */
page {
  background: var(--bg-color, #F8F7FC);
  min-height: 100vh;
}

.page {
  min-height: 100vh;
}

.scroll {
  min-height: 100vh;
}

/* ========== 导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--primary-gradient, linear-gradient(135deg, #5B6FE8, #7B8FF7));
  box-sizing: border-box;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 128rpx;
  padding: 0 32rpx;
}

.nav-brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color, #5B6FE8);
  margin-right: 16rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

/* ========== Hero ========== */
.hero {
  padding: 48rpx 40rpx 80rpx;
  text-align: center;
  background: var(--primary-gradient, linear-gradient(135deg, #5B6FE8, #7B8FF7));
  position: relative;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.hero-sub {
  font-size: 26rpx;
  color: rgb(255 255 255 / 0.85);
  display: block;
  margin-top: 12rpx;
}

/* ========== 核心服务卡片 ========== */
.services {
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx;
  margin-top: -48rpx;
  position: relative;
  z-index: 10;
}

.svc-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--bg-white, #fff);
  border-radius: 24rpx;
  padding: 40rpx 0;
  width: 30%;
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.08);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

/* 刻章卡片高亮 */
.svc-col:first-child {
  border-top: 6rpx solid var(--primary-color, #5B6FE8);
}

/* 卡片hover效果 */
.svc-col--hover {
  opacity: 0.9;
  transform: scale(0.98);
  box-shadow: 0 8rpx 32rpx rgb(91 111 232 / 0.12);
  transition: all 0.3s ease;
}

.svc-col:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.1);
}

.svc-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

/* ========== 内联图标 — 刻章 ========== */
.si-seal-body {
  width: 78rpx;
  height: 60rpx;
  border: 4rpx solid var(--primary-color, #5B6FE8);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.si-seal-face {
  width: 30rpx;
  height: 30rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.si-seal-ring {
  position: absolute;
  inset: 0;
  border: 3rpx solid var(--primary-color, #5B6FE8);
  border-radius: 50%;
  box-sizing: border-box;
}

.si-seal-x-h,
.si-seal-x-v {
  position: absolute;
  background: var(--primary-color, #5B6FE8);
  border-radius: 2rpx;
}

.si-seal-x-h {
  width: 20rpx;
  height: 3rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.si-seal-x-v {
  width: 3rpx;
  height: 20rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* ========== 内联图标 — 登报 ========== */
.si-news-body {
  width: 66rpx;
  height: 74rpx;
  border: 4rpx solid var(--primary-color, #5B6FE8);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.si-news-line {
  width: 46rpx;
  height: 4rpx;
  background: var(--primary-color, #5B6FE8);
  border-radius: 2rpx;
  flex-shrink: 0;
}

.si-news-line--s {
  width: 30rpx;
}

/* ========== 内联图标 — 商标 ========== */
.si-tm-ring {
  width: 70rpx;
  height: 70rpx;
  border: 4rpx solid var(--primary-color, #5B6FE8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.si-tm-r {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color, #5B6FE8);
  line-height: 1;
}

.svc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #1A202C);
  margin-bottom: 8rpx;
}

.svc-desc {
  font-size: 24rpx;
  color: var(--text-secondary, #8896B3);
}

/* ========== 区块通用 ========== */
.section {
  background: var(--bg-white, #fff);
  margin: 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.08);
  transition: all 0.3s ease;
}

.section-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary, #1A202C);
}

.section-more {
  font-size: 26rpx;
  color: var(--text-secondary, #8896B3);
}

/* ========== 订单区域加载骨架 ========== */
.skeleton-order {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color, #E8EDF2);
}

.skeleton-order:last-child {
  border-bottom: none;
}

.skeleton-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--border-color, #E8EDF2);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.skeleton-lines {
  flex: 1;
}

.skeleton-line {
  height: 28rpx;
  background: var(--border-color, #E8EDF2);
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.skeleton-line:last-child {
  width: 60%;
  margin-bottom: 0;
}

/* ========== 订单列表 ========== */
.order {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color, #E8EDF2);
}

.order:last-child {
  border-bottom: none;
}

.order-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FFB020;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.order-dot.done {
  background: #52C41A;
}

.order-main {
  flex: 1;
}

.order-name {
  font-size: 30rpx;
  color: var(--text-primary, #1A202C);
  display: block;
  font-weight: 500;
}

.order-meta {
  font-size: 24rpx;
  color: var(--text-secondary, #8896B3);
  display: block;
  margin-top: 6rpx;
}

.order-status {
  font-size: 26rpx;
  color: #FFB020;
  font-weight: 500;
}

.order-status.done {
  color: #52C41A;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary, #8896B3);
}

/* ========== 保障徽章 ========== */
.badges {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  padding: 0 32rpx;
  margin: 32rpx 0;
  gap: 16rpx;
}

.badge {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--bg-white, #fff);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.06);
  transition: all 0.3s ease;
}

.badge:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgb(91 111 232 / 0.08);
}

.badge-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.badge-text {
  font-size: 24rpx;
  color: var(--text-primary, #1A202C);
  font-weight: 500;
  white-space: nowrap;
}

/* 底部安全区（在 scroll-view 内部） */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  width: 100%;
  background: transparent;
}
