/* pages/home/index.wxss */

/* ========== CSS变量与关键帧 ========== */
page {
  --primary-color: #5B6FE8;
  --primary-dark: #4A5CD1;
  --primary-light: #7B8FF7;
  --primary-gradient: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  --bg-color: #F5F6FA;
  --bg-white: #ffffff;
  --border-color: #E8EDF2;
  --text-primary: #1A202C;
  --text-secondary: #8896B3;
  --text-hint: #A8B4C5;
  --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
  background: var(--bg-color);
  min-height: 100vh;
}

/* 呼吸渐变动画 */
@keyframes gradientBreathe {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.page {
  min-height: 100vh;
}

.scroll {
  min-height: 100vh;
}

/* ========== 导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--primary-gradient);
  box-sizing: border-box;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 128rpx;
  padding: 0 32rpx;
}

.nav-brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-right: 16rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ========== Hero ========== */
.hero {
  padding: 48rpx 40rpx 96rpx;
  text-align: center;
  background: var(--primary-gradient);
  background-size: 200% 200%;
  animation: gradientBreathe 8s var(--ease-out-quart) infinite;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 — 右下角半透明大气元素 */
.hero::before {
  display: none; /* WeChat 不支持伪元素，改用真实元素 */
}

.hero-deco {
  position: absolute;
  right: -60rpx;
  bottom: -80rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.06);
  pointer-events: none;
}

.hero-deco-2 {
  position: absolute;
  left: -100rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.04);
  pointer-events: none;
}

/* 底部弧形装饰 */
.hero-arc {
  position: absolute;
  bottom: -2rpx;
  left: 0;
  right: 0;
  height: 48rpx;
  background: var(--bg-color);
  border-radius: 50% 50% 0 0;
  pointer-events: none;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  opacity: 0;
  transform: translateY(16rpx);
  animation: heroFadeIn 0.6s var(--ease-out-quart) 0.1s forwards;
}

.hero-sub {
  font-size: 26rpx;
  color: rgb(255 255 255 / 0.85);
  display: block;
  margin-top: 14rpx;
  opacity: 0;
  transform: translateY(12rpx);
  animation: heroFadeIn 0.6s var(--ease-out-quart) 0.25s forwards;
}

@keyframes heroFadeIn {
  to { opacity: 1; transform: translateY(0); }
}

/* ========== 核心服务卡片 ========== */
.services {
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx;
  margin-top: -56rpx;
  position: relative;
  z-index: 10;
}

.svc-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--bg-white);
  border-radius: 24rpx;
  padding: 36rpx 0;
  width: 30%;
  box-shadow: 0 4rpx 20rpx rgb(91 111 232 / 0.08);
  position: relative;
  transition: transform 0.35s var(--ease-out-quart),
              box-shadow 0.35s var(--ease-out-quart);
  opacity: 0;
  transform: translateY(24rpx);
}

/* 渐进入场 */
.svc-col:nth-child(1) { animation: cardIn 0.5s var(--ease-out-quart) 0.3s forwards; }
.svc-col:nth-child(2) { animation: cardIn 0.5s var(--ease-out-quart) 0.4s forwards; }
.svc-col:nth-child(3) { animation: cardIn 0.5s var(--ease-out-quart) 0.5s forwards; }

@keyframes cardIn {
  to { opacity: 1; transform: translateY(0); }
}

/* 卡片顶部装饰条（每张不同色） */
.svc-col-top {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 8rpx;
  border-radius: 24rpx 24rpx 0 0;
}

.svc-col:nth-child(1) .svc-col-top {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
}

.svc-col:nth-child(2) .svc-col-top {
  background: linear-gradient(135deg, #0984E3, #74B9FF);
}

.svc-col:nth-child(3) .svc-col-top {
  background: linear-gradient(135deg, #00CEC9, #81ECEC);
}

/* 卡片悬浮效果（只缩卡片，不缩图标） */
.svc-tap {
  transform: scale(0.96);
  box-shadow: 0 8rpx 32rpx rgb(91 111 232 / 0.15);
}

.svc-icon {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.svc-svg {
  width: 108rpx;
  height: 108rpx;
}

.svc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.svc-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ========== 区块通用 ========== */
.section {
  background: var(--bg-white);
  margin: 28rpx 32rpx;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.06);
}

.section-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  display: none;
}

/* 标题左侧装饰条 */
.section-title-bar {
  position: absolute;
  left: 0;
  top: 4rpx;
  bottom: 4rpx;
  width: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: background 0.2s ease;
}

.more-tap {
  background: var(--bg-color);
}

/* ========== 订单加载骨架 ========== */
.skeleton-order {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.skeleton-order:last-child {
  border-bottom: none;
}

.skeleton-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--border-color);
  margin-right: 24rpx;
  flex-shrink: 0;
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

.skeleton-lines {
  flex: 1;
}

.skeleton-line {
  height: 24rpx;
  background: var(--border-color);
  border-radius: 6rpx;
  margin-bottom: 12rpx;
  animation: skeletonPulse 1.5s ease-in-out 0.2s infinite;
}

.skeleton-line:last-child {
  width: 60%;
  margin-bottom: 0;
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ========== 订单列表 ========== */
.order {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: background 0.2s ease, padding-left 0.2s var(--ease-out-quart);
  border-radius: 12rpx;
  margin: 0 -12rpx;
  padding: 28rpx 12rpx;
}

.order:last-child {
  border-bottom: none;
}

.order-tap {
  background: var(--bg-color);
  padding-left: 20rpx;
}

.order-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFB020;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgb(255 176 32 / 0.15);
}

.order-dot.done {
  background: #52C41A;
  box-shadow: 0 0 0 4rpx rgb(82 196 26 / 0.15);
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-name {
  font-size: 30rpx;
  color: var(--text-primary);
  display: block;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 6rpx;
}

.order-status {
  font-size: 26rpx;
  color: #FFB020;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.order-status.done {
  color: #52C41A;
}

.empty {
  text-align: center;
  padding: 72rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ========== 保障徽章 ========== */
.badges {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  padding: 0 32rpx;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.badge {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--bg-white);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  box-shadow: 0 2rpx 12rpx rgb(91 111 232 / 0.05);
  transition: transform 0.25s var(--ease-out-quart),
              box-shadow 0.25s var(--ease-out-quart);
}

.badge-tap {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgb(91 111 232 / 0.1);
}

.badge-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.badge-text {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  white-space: nowrap;
}

/* 底部安全区 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  width: 100%;
  background: transparent;
}
