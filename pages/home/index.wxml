<!-- pages/home/index.wxml -->
<privacy-popup show="{{showPrivacyPopup}}"></privacy-popup>
<view class="page">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-content">
      <view class="nav-brand">
        <view class="brand-mark">R</view>
        <text class="brand-name">蓉城企服</text>
      </view>
    </view>
  </view>

  <!-- 滚动内容 -->
  <scroll-view scroll-y class="scroll" style="padding-top: {{navHeight}}px;">

    <!-- Hero -->
    <view class="hero">
      <text class="hero-title">企业服务 一站通达</text>
      <text class="hero-sub">公安备案 · 省级报刊 · 商标注册</text>
    </view>

    <!-- 核心服务 -->
    <view class="services">
      <view class="svc-col" bindtap="goToPage" data-page="seal" hover-class="svc-col--hover">
        <view class="svc-icon">
          <!-- 刻章图标: 圆角方章 + 圆形章面 + 十字 -->
          <view class="si-seal-body">
            <view class="si-seal-face">
              <view class="si-seal-ring"></view>
              <view class="si-seal-x-h"></view>
              <view class="si-seal-x-v"></view>
            </view>
          </view>
        </view>
        <text class="svc-name">在线刻章</text>
        <text class="svc-desc">公安备案</text>
      </view>

      <view class="svc-col" bindtap="goToPage" data-page="newspaper" hover-class="svc-col--hover">
        <view class="svc-icon">
          <!-- 登报图标: 报纸 + 文字线 -->
          <view class="si-news-body">
            <view class="si-news-line"></view>
            <view class="si-news-line"></view>
            <view class="si-news-line si-news-line--s"></view>
          </view>
        </view>
        <text class="svc-name">在线登报</text>
        <text class="svc-desc">省级报刊</text>
      </view>

      <view class="svc-col" bindtap="goToPage" data-page="license" hover-class="svc-col--hover">
        <view class="svc-icon">
          <!-- 商标图标: 圆 + ® 文字 -->
          <view class="si-tm-ring">
            <text class="si-tm-r">®</text>
          </view>
        </view>
        <text class="svc-name">商标注册</text>
        <text class="svc-desc">专业服务</text>
      </view>
    </view>

    <!-- 最近订单 -->
    <view class="section">
      <view class="section-hd">
        <text class="section-title">最近订单</text>
        <text class="section-more" bindtap="goToOrders">全部 ›</text>
      </view>

      <block wx:if="{{loading}}">
        <view class="skeleton-order" wx:for="{{3}}" wx:for-index="i" wx:key="i">
          <view class="skeleton-dot"></view>
          <view class="skeleton-lines">
            <view class="skeleton-line"></view>
            <view class="skeleton-line"></view>
          </view>
        </view>
      </block>

      <block wx:elif="{{orders.length > 0}}">
        <view class="order" wx:for="{{orders}}" wx:key="id"
          bindtap="onOrderTap" data-type="{{item.type}}" data-id="{{item.id}}">
          <view class="order-dot {{item.statusKey === 'completed' ? 'done' : ''}}"></view>
          <view class="order-main">
            <text class="order-name">{{item.name}}</text>
            <text class="order-meta">{{item.type}} · {{item.date}}</text>
          </view>
          <text class="order-status {{item.statusKey === 'completed' ? 'done' : ''}}">{{item.status}}</text>
        </view>
      </block>

      <view class="empty" wx:elif="!loading">
        <text class="empty-text">暂无订单</text>
      </view>
    </view>

    <!-- 保障 -->
    <view class="badges">
      <view class="badge" wx:for="{{features}}" wx:key="id">
        <image class="badge-icon" src="{{item.iconSvg}}" mode="aspectFit" />
        <text class="badge-text">{{item.title}}</text>
      </view>
    </view>
    <view style="height:160rpx;"></view>
    <view class='safe-bottom'></view>
  </scroll-view>
</view>