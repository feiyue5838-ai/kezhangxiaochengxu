<!-- pages/home/index.wxml -->
<privacy-popup show="{{showPrivacyPopup}}"></privacy-popup>
<view class="page">
  <!-- 导航栏 -->
  <nav-bar title="蓉城企服" showBack="{{false}}" />

  <!-- 平台公告栏（后台配置，跑马灯滚动；点击查看详情） -->
  <view class="announce-bar" wx:if="{{announcements.length > 0}}" bindtap="onAnnounceTap">
    <image class="announce-icon" src="/assets/icons/icon-megaphone.png" mode="aspectFit" />
    <view class="announce-viewport">
      <view class="announce-track">
        <text class="announce-text">{{announceText}}</text>
        <text class="announce-text">{{announceText}}</text>
      </view>
    </view>
    <text class="announce-more">›</text>
  </view>

  <!-- 滚动内容 -->
  <scroll-view scroll-y class="scroll">

    <!-- Banner 轮播（后台配置，优先展示；单张时静态展示） -->
    <view class="banner-wrap" wx:if="{{banners.length > 0}}">
      <!-- 多张：轮播 -->
      <swiper wx:if="{{banners.length > 1}}" class="banner-swiper" indicator-dots="{{true}}" autoplay="{{true}}" circular="{{true}}"
        indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#fff" interval="{{10000}}">
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <image class="banner-img" src="{{item.image}}" mode="aspectFit" bindtap="onBannerTap" data-link="{{item.link}}" />
        </swiper-item>
      </swiper>
      <!-- 单张：静态图 -->
      <view wx:else class="banner-static">
        <image class="banner-img" src="{{banners[0].image}}" mode="aspectFit" bindtap="onBannerTap" data-link="{{banners[0].link}}" />
      </view>
    </view>

    <!-- Hero（无 Banner 时展示默认引导语） -->
    <view class="hero" wx:else>
      <view class="hero-deco"></view>
      <view class="hero-deco-2"></view>
      <text class="hero-title">企业服务 一站通达</text>
      <text class="hero-sub">公安备案 · 省级报刊 · 代理记账</text>
      <view class="hero-arc"></view>
    </view>

    <!-- 核心服务 -->
    <view class="services">
      <view class="svc-col" bindtap="goToPage" data-page="seal" hover-class="svc-tap">
        <view class="svc-icon">
          <image class="svc-svg" src="{{iconSealBg}}" mode="aspectFit" />
        </view>
        <text class="svc-name">在线刻章</text>
        <text class="svc-desc">公安备案</text>
      </view>

      <view class="svc-col" bindtap="goToPage" data-page="newspaper" hover-class="svc-tap">
        <view class="svc-icon">
          <image class="svc-svg" src="{{iconNewsBg}}" mode="aspectFit" />
        </view>
        <text class="svc-name">在线登报</text>
        <text class="svc-desc">省级报刊</text>
      </view>

      <view class="svc-col" bindtap="goToPage" data-page="bookkeeping" hover-class="svc-tap">
        <view class="svc-icon">
          <image class="svc-svg" src="{{iconBookkeepingBg}}" mode="aspectFit" />
        </view>
        <text class="svc-name">代理记账</text>
        <text class="svc-desc">专业服务</text>
      </view>
    </view>

    <!-- 最近订单 -->
    <view class="section">
      <view class="section-hd">
        <text class="section-title">
          <view class="section-title-bar"></view>
          最近订单
        </text>
        <text class="section-more" bindtap="goToOrders" hover-class="more-tap">全部 ›</text>
      </view>

      <block wx:if="{{loading}}">
        <view class="skeleton-order" wx:for="{{3}}" wx:for-index="i" wx:key="i">
          <view class="skeleton-dot"></view>
          <view class="skeleton-lines">
            <view class="skeleton-line"></view>
            <view class="skeleton-line"></view>
          </view>
        </view>
      </block>

      <block wx:if="{{orders.length > 0}}">
        <view class="order" wx:for="{{orders}}" wx:key="id" hover-class="order-tap"
          bindtap="onOrderTap" data-type="{{item.type}}" data-id="{{item.id}}">
          <view class="order-dot {{item.statusKey === 'completed' ? 'done' : ''}}"></view>
          <view class="order-main">
            <text class="order-name">{{item.name}}</text>
            <text class="order-meta">{{item.type}} · {{item.date}}</text>
          </view>
          <text class="order-status {{item.statusKey === 'completed' ? 'done' : ''}}">{{item.status}}</text>
        </view>
      </block>

      <view class="empty" wx:if="{{!loading && orders.length === 0}}">
        <text class="empty-text">暂无订单</text>
      </view>
    </view>

    <!-- 保障 -->
    <view class="badges">
      <view class="badge" wx:for="{{features}}" wx:key="id" hover-class="badge-tap">
        <image class="badge-icon" src="{{item.iconSvg}}" mode="aspectFit" />
        <text class="badge-text">{{item.title}}</text>
      </view>
    </view>
    <view style="height:160rpx;"></view>
    <view class='safe-bottom'></view>
  </scroll-view>

  <!-- 公告详情弹窗 -->
  <view class="announce-mask" wx:if="{{showAnnounceModal}}" bindtap="onAnnounceClose">
    <view class="announce-modal" catchtap="onAnnounceStop">
      <view class="announce-modal-hd">
        <text class="announce-modal-title">平台公告</text>
        <text class="announce-modal-close" bindtap="onAnnounceClose">✕</text>
      </view>
      <scroll-view scroll-y class="announce-modal-body">
        <view class="announce-item" wx:for="{{announcements}}" wx:key="id">
          <text class="announce-item-title">{{item.title}}</text>
          <text class="announce-item-content">{{item.content}}</text>
          <text class="announce-item-time" wx:if="{{item.publishedAt}}">{{item.publishedAt}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
