/* pages/help/index.wxss */
page { background: #F8F7FC; }

/* ========== 导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  box-sizing: border-box;
}
.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  position: relative;
}
.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
.nav-placeholder {
  width: 60rpx;
  height: 100%;
}
.nav-title { font-size: 34rpx; font-weight: 600; color: #fff; text-align: center; }

/* ========== 内容区 ========== */
.help-wrap {
  );
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  padding: calc(88rpx + constant(safe-area-inset-top)) 0 40rpx;
}

.help-hotline {
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  margin: 24rpx 20rpx 0;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgb(91 111 232 / 0.3);
}

.hotline-left { display: flex; flex-direction: column; gap: 6rpx; }
.hotline-label { font-size: 22rpx; color: rgba(255,255,255,0.7); }
.hotline-number { font-size: 40rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }

.hotline-btn {
  background: rgba(255,255,255,0.25);
  border: 2rpx solid rgba(255,255,255,0.5);
  border-radius: 100rpx;
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.hotline-btn text { font-size: 26rpx; color: #fff; font-weight: 600; }
.hotline-btn image { width: 28rpx; height: 28rpx; }

/* 分类区 */
.help-cats { margin: 24rpx 20rpx 0; }

.help-cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2332;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}

.help-cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.help-cat-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgb(91 111 232 / 0.05);
  transition: all 0.2s;
}
.help-cat-item:active { transform: scale(0.96); opacity: 0.85; }

.help-cat-icon { width: 64rpx; height: 64rpx; }
.help-cat-name { font-size: 24rpx; color: #1A2332; text-align: center; font-weight: 500; }

/* FAQ 列表 */
.faq-list { margin: 24rpx 20rpx 0; }

.faq-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgb(91 111 232 / 0.05);
}

.faq-question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}
.faq-q-left { display: flex; align-items: flex-start; gap: 16rpx; flex: 1; }
.faq-q-tag {
  font-size: 20rpx;
  color: #5B6FE8;
  background: #EEF2FF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  font-weight: 600;
  margin-top: 2rpx;
}
.faq-q-text { font-size: 28rpx; color: #1A2332; line-height: 1.5; flex: 1; }
.faq-arrow { font-size: 32rpx; color: #C0C8D4; transition: transform 0.2s; flex-shrink: 0; }
.faq-arrow--open { transform: rotate(180deg); }

.faq-answer {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
  padding: 0 32rpx 28rpx;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
  display: none;
}
.faq-answer--open { display: block; }

/* 浮动客服按钮 */
.float-service {
  position: fixed;
  right: 32rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgb(91 111 232 / 0.4);
  z-index: 99;
}
.float-service text {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -1rpx;
}
