/* pages/order/detail/index.wxss — V2.0 统一订单详情 */
.page {
  min-height: 100vh;
  background: #f5f6f7;
  padding-bottom: 140rpx;
}

.loading-wrap, .empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-text, .empty-text { color: #999; font-size: 28rpx; }
.back-btn {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #576b95;
  background: none;
  border: 1rpx solid #576b95;
  border-radius: 8rpx;
  padding: 10rpx 40rpx;
}

/* 状态卡片 */
.status-card {
  padding: 40rpx 30rpx;
  color: #fff;
}
.status-text { font-size: 40rpx; font-weight: 600; display: block; }
.status-sub { font-size: 24rpx; opacity: 0.85; display: block; margin-top: 8rpx; }

/* 进度条 */
.progress-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.progress-title { font-size: 28rpx; font-weight: 600; margin-bottom: 24rpx; }
.progress-row {
  display: flex;
  justify-content: space-between;
}
.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
}
.progress-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #ccc;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}
.progress-step.done .progress-dot {
  background: #07c160;
  border-color: #07c160;
}
.progress-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
}
.progress-step.done .progress-label { color: #07c160; }

/* 信息卡片 */
.info-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}
.info-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.info-label { color: #999; flex-shrink: 0; margin-right: 20rpx; }
.info-value { color: #333; text-align: right; flex: 1; word-break: break-all; }
.price { color: #fa5151; font-weight: 600; font-size: 30rpx; }

/* 时间线 */
.timeline {
  padding-left: 8rpx;
}
.timeline-item {
  display: flex;
  padding: 10rpx 0;
}
.timeline-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #07c160;
  margin: 12rpx 16rpx 0 0;
  flex-shrink: 0;
}
.timeline-body {
  display: flex;
  flex-direction: column;
}
.timeline-name { font-size: 26rpx; color: #333; }
.timeline-time { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
  z-index: 10;
}
.action-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 40rpx;
  line-height: 68rpx;
  height: 68rpx;
}
.action-btn.primary {
  background: #576b95;
  color: #fff;
  border: none;
}
