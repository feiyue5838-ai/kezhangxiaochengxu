/* pages/order/logistics/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
}

/* 快递信息卡 */
.express-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.express-header {
  display: flex;
  align-items: center;
}

.express-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  background: #EEF1FF;
  border-radius: 50%;
  flex-shrink: 0;
}

.express-info {
  flex: 1;
}

.express-company {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.express-no {
  font-size: 26rpx;
  color: #666;
}

.copy-btn {
  padding: 10rpx 24rpx;
  background: #5B6FE8;
  color: #fff;
  border-radius: 40rpx;
  font-size: 24rpx;
}

/* 物流轨迹 */
.timeline-section {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #f0f0f0;
}

.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  position: relative;
}

.timeline-item .timeline-dot {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 32rpx;
  margin-right: 20rpx;
}

.timeline-item .dot-inner {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ddd;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.timeline-item .dot-line {
  width: 2rpx;
  flex: 1;
  min-height: 60rpx;
  background: #eee;
  margin: 6rpx 0;
}

.timeline-item:last-child .dot-line {
  display: none;
}

.timeline-item.latest .dot-inner {
  background: #5B6FE8;
  box-shadow: 0 0 0 4rpx rgba(91,111,232,.2);
}

.timeline-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.timeline-item:last-child .timeline-content {
  padding-bottom: 0;
}

.step-content {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.timeline-item.latest .step-content {
  color: #5B6FE8;
  font-weight: 500;
}

.step-time {
  font-size: 24rpx;
  color: #999;
}
