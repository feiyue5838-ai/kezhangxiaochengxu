/* pages/order/rate/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 订单卡片 */
.order-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05);
}
.order-type {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.order-price {
  font-size: 32rpx;
  color: #5B6FE8;
  font-weight: 600;
}

/* 通用区块 */
.section {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05);
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 评分星星 */
.star-row {
  display: flex;
  align-items: center;
}
.star {
  width: 64rpx;
  height: 64rpx;
  margin-right: 12rpx;
}
.star image {
  width: 100%;
  height: 100%;
}
.star-label {
  margin-left: 24rpx;
  font-size: 28rpx;
  color: #666;
}

/* 评价标签 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  padding: 12rpx 28rpx;
  border: 1px solid #ddd;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  background: #fafafa;
}
.tag.active {
  background: #EEF1FF;
  border-color: #5B6FE8;
  color: #5B6FE8;
}

/* 文字评价 */
.comment-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding: 16rpx;
  border: 1px solid #eee;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fafafa;
}
.word-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 图片评价 */
.img-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.img-item image {
  width: 100%;
  height: 100%;
}
.img-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-add {
  width: 200rpx;
  height: 200rpx;
  border: 1px dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.img-add image {
  width: 60rpx;
  height: 60rpx;
  opacity: 0.5;
}
.img-add text {
  font-size: 24rpx;
  color: #999;
}

/* 提交按钮 */
.submit-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: max(24rpx, env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
}
.submit-btn {
  text-align: center;
  padding: 24rpx;
  background: #5B6FE8;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.submit-btn.disabled {
  background: #ccc;
}
