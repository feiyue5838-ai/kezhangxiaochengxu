/* pages/order/list/index.wxss */

.page {
  min-height: 100vh;
  background: #F8F7FC;
}

/* 导航栏（与胶囊对齐） */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-sizing: border-box;
  background: #5B6FE8;
}

.nav-content {
  position: relative;
  height: 100%;
  padding: 0 32rpx;
}

.nav-back {
  position: absolute;
  left: 8rpx;
  display: flex;
  align-items: center;
  font-size: 44rpx;
  color: #fff;
  font-weight: 300;
  z-index: 10;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

/* Tab栏 */
.tab-bar {
  position: fixed;
  top: 88rpx;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #5B6FE8;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #5B6FE8;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  padding: 24rpx;
}

.order-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.order-left {
  flex: 1;
}

.order-type-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.order-module {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2332;
}

.order-status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.order-status-tag.pending {
  background: #FFF3E0;
  color: #FF9800;
}

.order-status-tag.processing {
  background: #E3F2FD;
  color: #2196F3;
}

.order-status-tag.completed {
  background: #E8F5E9;
  color: #4CAF50;
}

.order-status-tag.refund {
  background: #FCE4EC;
  color: #E91E63;
}

.order-status-tag.cancelled {
  background: #F5F5F5;
  color: #999;
}

.order-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.order-date {
  font-size: 24rpx;
  color: #999;
}

.order-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.order-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.review-btn {
  font-size: 24rpx;
  color: #5B6FE8;
  border: 1rpx solid #5B6FE8;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.aftersale-btn {
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #ddd;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #5B6FE8;
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
}
