/* pages/order/list/index.wxss */

.page {
  min-height: 100vh;
  background: #F8F7FC;
}

/* Tab栏 - 6个Tab均分宽度 */
.tab-bar {
  display: flex;
  width: 100%;
  background: #ffcccc;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 60rpx;
}

.tab-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 4rpx;
  font-size: 24rpx;
  color: #666;
  position: relative;
  white-space: nowrap;
  text-align: center;
}

.tab-text {
  display: inline-block;
  line-height: 1.4;
}

.tab-item.active {
  color: #7B5CFA;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #7B5CFA;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  padding: 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgb(0 0 0 / 0.04);
}

/* 订单头 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f8f7fc;
}

.order-type {
  flex: 1;
  min-width: 120rpx;   /* 保证标题至少占一定宽度，status 不挤到最左 */
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2332;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.order-status.pending { color: #FF6600; }    /* 待付款：橙色 */
.order-status.paid { color: #5B6FE8; }       /* 待发货：蓝色 */
.order-status.shipped { color: #FA8C16; }   /* 待收货：橙黄色 */
.order-status.completed { color: #FA8C16; }  /* 待评价：橙黄色 */
.order-status.cancelled { color: #999; }     /* 已取消：灰色 */
.order-status.refund { color: #FF6600; }      /* 退款/售后：橙色 */
.order-status.refunded { color: #FF6600; }   /* 同上 */

/* 订单内容 */
.order-body {
  padding: 24rpx 28rpx;
}

.order-desc {
  font-size: 28rpx;
  color: #1A2332;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-date {
  font-size: 24rpx;
  color: #8C97A6;
}

.order-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #7B5CFA;
}

/* 快捷操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f8f7fc;
}

.action-btn {
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  border: 2rpx solid #D5DDE8;
  color: #8C97A6;
  background: #fff;
}

.action-btn.primary {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  color: #fff;
  border: none;
}

.action-btn.cancel {
  color: #8C97A6;
  border: 2rpx solid #D5DDE8;
}

.action-btn.delete {
  color: #FF4D4F;
  border: 2rpx solid #FF4D4F;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8C97A6;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 60rpx;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #8C97A6;
}
