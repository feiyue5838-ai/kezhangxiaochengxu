<view class="page">
  <nav-bar title="全部订单" bind:back="goBack" />

  <!-- Tab 栏 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="status"
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      data-idx="{{index}}"
      bindtap="switchTab"
    >
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-line" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- 未登录引导 -->
  <view class="empty-wrap" wx:if="{{needLogin}}">
    <text class="empty-text">请先登录后查看订单</text>
    <view class="empty-btn" bindtap="goLogin">去登录</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{list.length > 0}}">
    <view
      class="order-card"
      wx:for="{{list}}"
      wx:for-item="order"
      wx:for-index="orderIdx"
      wx:key="id"
    >
      <!-- 订单头 -->
      <view class="order-header">
        <text class="order-type">{{order.type || '登报服务'}}</text>
        <text class="order-status {{order.statusClass}}">{{order.statusText}}</text>
      </view>

      <!-- 订单内容（点击跳转详情） -->
      <view class="order-body" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="goToDetail">
        <view class="order-desc">{{order.desc}}</view>
        <view class="order-meta">
          <text class="order-date">{{order.date}}</text>
          <text class="order-price">¥{{order.price}}</text>
        </view>
      </view>

      <!-- 快捷操作按钮 -->
      <view class="order-actions">
        <!-- 调试：显示实际状态 -->
        <text style="font-size: 20rpx; color: #999; display: block; margin-bottom: 10rpx;">status: [{{order.status}}] type: [{{order.module}}]</text>
        <!-- 待付款：取消 + 立即支付 -->
        <block wx:if="{{order.status === 'pending'}}">
          <view class="action-btn cancel" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="onCancelOrder">取消订单</view>
          <navigator class="action-btn primary" url="/pages/seal/order-detail/index?id={{order.id}}" wx:if="{{order.module === 'seal'}}">立即支付</navigator>
          <navigator class="action-btn primary" url="/pages/newspaper/order-detail/index?id={{order.id}}" wx:if="{{order.module === 'newspaper'}}">立即支付</navigator>
          <navigator class="action-btn primary" url="/pages/bookkeeping/order-detail/index?id={{order.id}}" wx:if="{{order.module === 'bookkeeping'}}">立即支付</navigator>
        </block>
        <!-- 待发货：查看物流 -->
        <block wx:if="{{order.status === 'paid'}}">
          <view class="action-btn" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="onViewLogistics">查看物流</view>
        </block>
        <!-- 待收货：申请售后 + 确认收货 -->
        <block wx:if="{{order.status === 'shipped'}}">
          <view class="action-btn" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="onApplyAftersale">申请售后</view>
          <view class="action-btn primary" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="onConfirmReceive">确认收货</view>
        </block>
        <!-- 待评价/已完成：申请售后 + 去评价 + 删除 -->
        <block wx:if="{{order.status === 'completed'}}">
          <view class="action-btn" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="onApplyAftersale">申请售后</view>
          <view class="action-btn primary" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="onRateOrder">去评价</view>
          <view class="action-btn delete" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="onDeleteOrder">删除</view>
        </block>
        <!-- 已取消/退款/已退款：删除 -->
        <block wx:if="{{order.status === 'cancelled' || order.status === 'refund' || order.status === 'refunded'}}">
          <view class="action-btn delete" data-id="{{order.id}}" data-module="{{order.module}}" bindtap="onDeleteOrder">删除</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{!needLogin && !loading && list.length === 0}}">
    <text class="empty-text">暂无订单</text>
    <navigator url="/pages/home/index" open-type="switchTab" class="empty-btn">去下单</navigator>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:else>
    <text class="loading-text">加载中...</text>
  </view>
</view>
