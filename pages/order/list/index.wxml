<view class="page">
  <nav-bar title="全部订单" bind:back="goBack" />

  <!-- Tab 栏 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="status"
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      data-idx="{{index}}"
      bindtap="switchTab"
    >
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-line" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{list.length > 0}}">
    <view
      class="order-card"
      wx:for="{{list}}"
      wx:key="id"
    >
      <!-- 订单头 -->
      <view class="order-header">
        <text class="order-type">{{item.type || '登报服务'}}</text>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <!-- 订单内容（点击跳转详情） -->
      <view class="order-body" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="goToDetail">
        <view class="order-desc">{{item.desc}}</view>
        <view class="order-meta">
          <text class="order-date">{{item.date}}</text>
          <text class="order-price">¥{{item.price}}</text>
        </view>
      </view>

      <!-- 快捷操作按钮 -->
      <view class="order-actions">
        <!-- 待支付：取消 + 支付 -->
        <block wx:if="{{item.status === 'pending'}}">
          <view class="action-btn cancel" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onCancelOrder">取消订单</view>
          <view class="action-btn primary" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onPayOrder">立即支付</view>
        </block>
        <!-- 进行中：完成 -->
        <block wx:elif="{{item.status === 'processing'}}">
          <view class="action-btn primary" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onCompleteOrder">确认完成</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:elif="{{!loading}}">
    <text class="empty-text">暂无订单</text>
    <navigator url="/pages/home/index" open-type="switchTab" class="empty-btn">去下单</navigator>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:else>
    <text class="loading-text">加载中...</text>
  </view>
</view>
