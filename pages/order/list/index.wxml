<view class="page">
  <nav-bar title="全部订单" bind:back="goBack" />

  <!-- Tab 栏 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="status"
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      data-idx="{{index}}"
      bindtap="switchTab"
    >
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-line" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- 未登录引导 -->
  <view class="empty-wrap" wx:if="{{needLogin}}">
    <text class="empty-text">请先登录后查看订单</text>
    <view class="empty-btn" bindtap="goLogin">去登录</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:elif="{{list.length > 0}}">
    <view
      class="order-card"
      wx:for="{{list}}"
      wx:key="id"
    >
      <!-- 订单头 -->
      <view class="order-header">
        <text class="order-type">{{item.type || '登报服务'}}</text>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <!-- 订单内容（点击跳转详情） -->
      <view class="order-body" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="goToDetail">
        <view class="order-desc">{{item.desc}}</view>
        <view class="order-meta">
          <text class="order-date">{{item.date}}</text>
          <text class="order-price">¥{{item.price}}</text>
        </view>
      </view>

      <!-- 快捷操作按钮 -->
      <view class="order-actions">
        <!-- 待支付：取消 + 支付 -->
        <block wx:if="{{item.status === 'pending'}}">
          <view class="action-btn cancel" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onCancelOrder">取消订单</view>
          <navigator class="action-btn primary" url="/pages/seal/order-detail/index?id={{item.id}}" wx:if="{{item.module === 'seal'}}">立即支付</navigator>
          <navigator class="action-btn primary" url="/pages/newspaper/order-detail/index?id={{item.id}}" wx:elif="{{item.module === 'newspaper'}}">立即支付</navigator>
          <navigator class="action-btn primary" url="/pages/bookkeeping/order-detail/index?id={{item.id}}" wx:elif="{{item.module === 'bookkeeping'}}">立即支付</navigator>
        </block>
        <!-- 待发货：查看物流入口（后台填单号后显示）-->
        <block wx:elif="{{item.status === 'paid'}}">
          <view class="action-btn" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onViewLogistics">查看物流</view>
        </block>
        <!-- 待收货：确认收货 -->
        <block wx:elif="{{item.status === 'shipped'}}">
          <view class="action-btn" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onApplyAftersale">申请售后</view>
          <view class="action-btn primary" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onConfirmReceive">确认收货</view>
        </block>
        <!-- 待评价：去评价 + 申请售后 -->
        <block wx:elif="{{item.status === 'completed'}}">
          <view class="action-btn" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onApplyAftersale">申请售后</view>
          <view class="action-btn primary" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onRateOrder">去评价</view>
          <view class="action-btn delete" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onDeleteOrder">删除</view>
        </block>
        <!-- 退款/售后/已取消：删除 -->
        <block wx:elif="{{item.status === 'cancelled' || item.status === 'refund' || item.status === 'refunded'}}">
          <view class="action-btn delete" data-id="{{item.id}}" data-module="{{item.module}}" bindtap="onDeleteOrder">删除</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:elif="{{!loading}}">
    <text class="empty-text">暂无订单</text>
    <navigator url="/pages/home/index" open-type="switchTab" class="empty-btn">去下单</navigator>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:else>
    <text class="loading-text">加载中...</text>
  </view>
</view>
