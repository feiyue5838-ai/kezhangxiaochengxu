.form-wrap {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 30rpx 24rpx;
}
.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}
.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eee;
}
.form-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.form-label { font-size: 30rpx; color: #333; margin-bottom: 16rpx; }
.req { color: #ff4d4f; margin-right: 4rpx; }
.form-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.form-value { font-size: 28rpx; color: #333; }
.form-value.placeholder { color: #999; }
.form-arrow { font-size: 32rpx; color: #ccc; }
.form-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333;
}

/* 地区选择弹窗 */
.region-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 998;
}
.region-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
}
.region-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}
.region-btn { font-size: 28rpx; }
.cancel { color: #999; }
.confirm { color: #7B5CFA; font-weight: 500; }
.region-title { font-size: 32rpx; font-weight: 600; color: #333; }
.region-pv { height: 440rpx; }
.region-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
}
