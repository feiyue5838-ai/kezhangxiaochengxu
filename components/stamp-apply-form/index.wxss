/* components/stamp-apply-form/index.wxss */
.form-wrap {
  background: var(--bg-white);
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 30rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgb(0 0 0 / 0.06);
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.form-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.form-label {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.req {
  color: var(--error);
  margin-right: 4rpx;
}

.form-value-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-light);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.form-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-value.placeholder {
  color: var(--text-hint);
}

.form-arrow {
  font-size: 32rpx;
  color: var(--text-disabled);
}

.form-input {
  background: var(--bg-light);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}
