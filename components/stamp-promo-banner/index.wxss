/* components/stamp-promo-banner/index.wxss */
.promo-banner {
  width: 100%;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.promo-image {
  width: 100%;
  height: 260rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.promo-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.promo-text-main {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--bg-white);
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgb(0 0 0 / 0.15);
}

.promo-text-sub {
  font-size: 26rpx;
  color: rgb(255 255 255 / 0.95);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.promo-notice {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: var(--error);
  padding: 14rpx 0;
}

.notice-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.notice-text {
  font-size: 26rpx;
  color: var(--bg-white);
  font-weight: 500;
  letter-spacing: 2rpx;
}
