<!-- components/nav-bar/nav-bar.wxml -->
<view class="nav-bar {{fixed ? 'nav-bar--fixed' : ''}}" style="background: {{backgroundColor}};">
  <!-- 状态栏占位 -->
  <view class="nav-status-bar" style="height: {{statusBarHeight}}px;"></view>
  
  <!-- 导航内容（高度由 JS 动态计算，胶囊对齐） -->
  <view class="nav-content" style="height: {{navContentHeight}}px;">
    <!-- 左侧：系统胶囊按钮区（透明覆盖，点击即返回） -->
    <view
      wx:if="{{showBack}}"
      class="nav-capsule"
      style="left: {{capsuleLeft}}px; top: {{capsuleTop}}px; width: {{capsuleWidth}}px; height: {{capsuleHeight}}px;"
      bindtap="onBack"
    ></view>
    
    <!-- 中间：标题 或 自定义插槽（垂直居中于 navContentHeight） -->
    <view class="nav-center" style="height: {{navContentHeight}}px;">
      <text class="nav-title" style="color: {{color}}; height: {{navContentHeight}}px; line-height: {{navContentHeight}}px;" wx:if="{{!customCenter}}">{{title}}</text>
      <slot name="center" wx:else></slot>
    </view>
    
    <!-- 右侧：自定义内容（插槽） -->
    <view class="nav-right">
      <slot name="right"></slot>
    </view>
  </view>
</view>

<!-- 占位元素（仅固定定位时需要） -->
<view wx:if="{{fixed}}" class="nav-bar-placeholder" style="height: {{navHeight}}px;"></view>
