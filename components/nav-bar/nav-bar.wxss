/* components/nav-bar/nav-bar.wxss */

.nav-bar {
  width: 100%;
  z-index: 1000;
  position: relative;
}

/* 渐变蓝紫背景 */
.nav-bar--gradient {
  background: linear-gradient(135deg, #5B6FE8 0%, #A78BFA 100%);
}

/* 固定定位 */
.nav-bar--fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
}

/* 状态栏占位 */
.nav-status-bar {
  width: 100%;
}

/* 导航内容区（高度由 JS 动态计算传入） */
.nav-content {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* 左侧占位（与右侧对称，保证标题居中） */
.nav-left {
  flex: 0 0 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

/* 返回按钮 */
.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -10rpx;
}

.nav-back-icon {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}

/* 中间区域（标题或插槽） */
.nav-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 标题 */
.nav-title {
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧区域 */
.nav-right {
  flex: 0 0 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}



/* 占位元素 */
.nav-bar-placeholder {
  width: 100%;
}