/* components/privacy-popup/index.wxss */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgb(0 0 0 / 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  box-shadow: 0 8rpx 40rpx rgb(0 0 0 / 0.15);
}

.popup-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A202C;
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-body {
  margin-bottom: 40rpx;
}

.popup-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.popup-link {
  color: #1677FF;
  font-size: 28rpx;
}

.popup-btns {
  display: flex;
  gap: 24rpx;
}

.popup-btn-cancel,
.popup-btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.popup-btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.popup-btn-confirm {
  background: #1677FF;
  color: #fff;
}
