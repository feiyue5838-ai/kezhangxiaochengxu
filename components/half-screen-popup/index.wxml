<!--components/half-screen-popup/index.wxml-->
<view class="mask {{show ? 'mask-visible' : ''}}" bindtap="onMaskTap" wx:if="{{visible}}">
  <!-- 上半屏预览浮窗 -->
  <view class="top-preview {{(selectedSealImg || previewSeals.length) ? 'top-preview-show' : ''}}" catchtap="onPreviewTap">
    <view class="top-preview-card">
      <!-- 顶部导航（紫色渐变区内，64px） -->
      <view class="top-preview-header">
        <view class="top-preview-nav-left"></view>
        <text class="top-preview-nav-title">印章预览</text>
        <view class="top-preview-nav-close" catchtap="onPreviewTap">
          <image src="/assets/icons/icon-wxml-0-5e074464.svg" mode="aspectFit" class="close-icon"/>
        </view>
      </view>

      <view class="top-preview-content">
        <image wx:if="{{selectedSealImg}}" class="top-preview-img" src="{{selectedSealImg}}" mode="aspectFit" />
        <swiper wx:if="{{previewSeals.length}}" class="top-preview-swiper" current="{{previewCurrent}}" bindchange="onSwiperChange" key="{{previewSeals.length}}">
          <swiper-item wx:for="{{previewSeals}}" wx:key="name">
            <view class="preview-seal-item">
              <image class="preview-seal-img" src="{{item.img}}" mode="aspectFit" />
              <text class="preview-seal-name">{{item.name}}</text>
            </view>
          </swiper-item>
        </swiper>
        <view wx:if="{{previewSeals.length > 1}}" class="swiper-dots">
          <view class="swiper-dot {{previewCurrent === index ? 'swiper-dot-active' : ''}}" wx:for="{{previewSeals}}" wx:key="name"></view>
        </view>
        <text class="top-preview-name">{{selectedSealName}}</text>
        <text class="top-preview-hint">点击收起</text>
      </view>
    </view>
  </view>

  <view class="popup {{show ? 'popup-visible' : ''}}" catchtap="preventClose">
    <view class="drag-bar-wrap" bindtap="onClose">
      <view class="drag-bar"></view>
    </view>

    <scroll-view class="popup-body" scroll-y>
      <view class="section-label" wx:if="{{filteredSingleSeals.length > 0}}">单枚印章</view>
      <view class="seal-grid">
        <view
          class="seal-card {{item.selected ? 'seal-card-active' : ''}}"
          wx:for="{{filteredSingleSeals}}"
          wx:key="id"
          bindtap="onSelect"
          data-id="{{item.id}}"
        >
          <view wx:if="{{item.selected}}" class="seal-badge">
            <image class="seal-badge-icon" src="/assets/icons/icon-wxml-1-a3deb6ec.svg" mode="aspectFit" />
          </view>
          <text class="seal-name">{{item.name}}</text>
        </view>
      </view>

      <view class="section-label" wx:if="{{filteredPackages.length > 0}}">特惠套餐</view>
      <view class="seal-grid">
        <view
          class="seal-card seal-card-pkg {{item.selected ? 'seal-card-active' : ''}}"
          wx:for="{{filteredPackages}}"
          wx:key="id"
          bindtap="onSelect"
          data-id="{{item.id}}"
        >
          <view class="badge" wx:if="{{item.badge}}">{{item.badge}}</view>
          <view wx:if="{{item.selected}}" class="seal-badge">
            <image class="seal-badge-icon" src="/assets/icons/icon-wxml-1-a3deb6ec.svg" mode="aspectFit" />
          </view>
          <text class="seal-name">{{item.name}}</text>
        </view>
      </view>

      <view style="height:200rpx;"></view>
    </scroll-view>
    <view class="popup-footer">
      <button class="submit-btn {{!selectedIds.length ? 'disabled' : ''}}" bindtap="onConfirm" disabled="{{!selectedIds.length}}">
        立即办理
      </button>
    </view>
  </view>
</view>
