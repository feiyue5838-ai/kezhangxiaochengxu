/* components/half-screen-popup/index.wxss */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgb(0 0 0 / 0.5);
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.mask-visible {
  opacity: 1;
  pointer-events: auto;
}

.popup {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  height: 70vh;
  background: var(--bg-color);
  border-radius: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.popup-visible {
  transform: translateY(0);
}

/* 鎷栨嫿鏉?*/
.drag-bar-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 4rpx;
  flex-shrink: 0;
}

.drag-bar {
  width: 60rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--border-color);
}

/* close-icon 閫氱敤灏哄 */
.close-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 绫诲瀷閫夋嫨鍖?===== */
.popup-body {
  flex: 1;
  padding: 0 30rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.section-label {
  font-size: 28rpx;
  color: var(--text-regular);
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 2鍒楃綉鏍?*/
.seal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 鍗＄墖 */
.seal-card {
  background: var(--bg-white);
  border-radius: 12rpx;
  border: 2rpx solid var(--primary-color);
  padding: 28rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  min-height: 80rpx;
}

.seal-name {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.3;
}

.seal-card-active {
  background: var(--primary-bg);
  border-color: var(--primary-color);
}

.seal-card-active .seal-name {
  color: var(--primary-dark);
  font-weight: 600;
}

/* 鐗规儬瑙掓爣 */
.badge {
  position: absolute;
  top: 0; right: 0;
  background: var(--error);
  color: var(--bg-white);
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 0 10rpx;
}

/* 閫変腑鍙充笂瑙掑嬀鏍?*/
.seal-badge {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-top: 32rpx solid var(--primary-color);
  border-left: 32rpx solid transparent;
}

.seal-badge-icon {
  position: absolute;
  top: -20rpx;
  right: 4rpx;
  font-size: 18rpx;
  color: #fff;
  line-height: 1;
}

/* 搴曢儴鎸夐挳 */
.popup-footer {
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-white);
  box-shadow: 0 -2rpx 12rpx rgb(0 0 0 / 0.06);
  flex-shrink: 0;
}

.submit-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--primary-color);
  color: var(--bg-white);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
  border: none;
}

.submit-btn.disabled {
  background: var(--text-disabled);
  color: var(--text-secondary);
}

/* ===== 鍥哄畾瀵艰埅鏍忥紙濮嬬粓鍙锛?===== */
.fixed-nav-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1002;
  background: linear-gradient(135deg, #5B6FE8, #A78BFA);
  box-sizing: border-box;
  /* height+padding-top 鐢?inline style 鍔ㄦ€佹彁渚?*/
}

/* 瀵艰埅鍐呭鍖?- 楂樺害鍜宲adding-top鍔ㄦ€佽绠楋紝涓庤兌鍥婃寜閽榻?*/
.fixed-nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* height 鍜?padding-top 鐢?inline style 鍔ㄦ€佹彁渚?*/
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.fixed-nav-left {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fixed-nav-left .nav-back-arrow {
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.fixed-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.fixed-nav-right {
  width: 60rpx;
  height: 100%;
  flex-shrink: 0;
}

/* ===== 涓婂崐灞忛瑙堟诞绐楋紙浠庡鑸爮涓嬫柟寮瑰嚭锛?===== */
.top-preview {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 1001;
  /* top 鍜?height 鐢?inline style 鍔ㄦ€佽绠?*/
  transform: translateY(-100%);
  opacity: 0;
  transition: transform 0.3s ease, opacity 0.3s ease;
  pointer-events: none;
  background: var(--bg-color, #F8F7FC);
}

.top-preview.top-preview-show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.top-preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-color, #F8F7FC);
  border-radius: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  /* 纭繚椤堕儴娌℃湁闂撮殭 */
  margin-top: 0;
  padding-top: 0;
}

.top-preview-img {
  width: 200rpx;
  height: 200rpx;
}

.top-preview-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-top: 16rpx;
  text-align: center;
}

.top-preview-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  text-align: center;
}

.top-preview-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.top-preview-swiper {
  width: 100%;
  height: 260rpx;
}

.preview-seal-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.preview-seal-img {
  width: 200rpx;
  height: 200rpx;
}

.preview-seal-name {
  font-size: 24rpx;
  color: var(--text-regular);
  margin-top: 8rpx;
}

/* 鎸囩ず鐐?*/
.swiper-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.swiper-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border-color);
}

.swiper-dot-active {
  background: var(--primary-color);
}

/* ===== 涓嬪崐灞忓脊绐楁爣棰樻爮锛堝嵃绔犻€夋嫨 + 鍏抽棴锛?===== */
.popup-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 30rpx 16rpx;
  background: var(--bg-white);
  flex-shrink: 0;
}

.popup-header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.popup-header-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
}

.popup-header-close .close-icon {
  width: 32rpx;
  height: 32rpx;
}
