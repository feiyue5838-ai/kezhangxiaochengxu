/* components/half-screen-popup/index.wxss */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgb(0 0 0 / 0.5);
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.mask-visible {
  opacity: 1;
  pointer-events: auto;
}

.popup {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  height: 70vh;
  background: var(--bg-color);
  border-radius: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.popup-visible {
  transform: translateY(0);
}

/* 拖拽条 */
.drag-bar-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 4rpx;
}

.drag-bar {
  width: 60rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--border-color);
}

/* 头部 */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0 30rpx 16rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.close-btn {
  position: absolute;
  right: 30rpx;
  top: -4rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 选中印章后的预览图 */
.seal-preview {
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-white);
  margin: 0 30rpx 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
}

.preview-img {
  width: 120rpx;
  height: 120rpx;
}

.preview-label {
  font-size: 24rpx;
  color: var(--text-regular);
  margin-left: 16rpx;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 12rpx 30rpx;
  flex-shrink: 0;
}

/* ===== 类型选择区 ===== */
.popup-body {
  flex: 1;
  padding: 0 30rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.section-label {
  font-size: 28rpx;
  color: var(--text-regular);
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 2列网格 */
.seal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 卡片 */
.seal-card {
  background: var(--bg-white);
  border-radius: 12rpx;
  border: 2rpx solid var(--primary-color);
  padding: 28rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  min-height: 80rpx;
}

.seal-name {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.3;
}

.seal-card-active {
  background: var(--primary-bg);
  border-color: var(--primary-color);
}

.seal-card-active .seal-name {
  color: var(--primary-dark);
  font-weight: 600;
}

/* 特惠角标 */
.badge {
  position: absolute;
  top: 0; right: 0;
  background: var(--error);
  color: var(--bg-white);
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 0 10rpx;
}

/* 选中右上角勾标 */
.seal-badge {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-top: 32rpx solid var(--primary-color);
  border-left: 32rpx solid transparent;
}

.seal-badge-icon {
  position: absolute;
  top: -24rpx;
  right: 4rpx;
  width: 28rpx;
  height: 28rpx;
}

/* 底部按钮 */
.popup-footer {
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-white);
  box-shadow: 0 -2rpx 12rpx rgb(0 0 0 / 0.06);
  flex-shrink: 0;
}

.submit-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--primary-color);
  color: var(--bg-white);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
  border: none;
}

.submit-btn.disabled {
  background: var(--text-disabled);
  color: var(--text-secondary);
}

/* ===== 上半屏预览浮窗 ===== */
.top-preview {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 30vh;
  z-index: 1001;
  display: flex;
  justify-content: center;
  align-items: center;
  transform: translateY(-100%);
  opacity: 0;
  transition: transform 0.3s ease, opacity 0.3s ease;
  pointer-events: none;
}

.top-preview.top-preview-show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.top-preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background: linear-gradient(135deg, #5B6FE8, #7B8FF7, #9BA8FF);
  border-radius: 0;
  padding-top: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.top-preview-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 24rpx 30rpx 16rpx;
  background: var(--bg-color);
  box-sizing: border-box;
    overflow-y: auto;
}

.top-preview-img {
  width: 240rpx;
  height: 240rpx;
}

.top-preview-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-top: 16rpx;
}

.top-preview-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* ========== 上半屏预览导航栏（64px）========== */
.top-preview-status-bar {
  width: 100%;
  height: 20px;  /* 默认高度，会被内联样式覆盖 */
  flex-shrink: 0;
}

.top-preview-nav-bar {
  width: 100%;
  height: 64px;
  background: #ffffff;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  flex-shrink: 0;
  overflow: visible;
  border-bottom: 1rpx solid #f0f2f5;
}

.top-preview-nav-content {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.top-preview-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a202c;
}

.top-preview-nav-left {
  width: 60rpx;
  height: 60rpx;
}

.top-preview-nav-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
}

.top-preview-nav-close .close-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 套餐单张左右滑动 */
.top-preview-swiper {
  width: 100%;
  height: 300rpx;
}

.preview-seal-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.preview-seal-img {
  width: 220rpx;
  height: 220rpx;
}

.preview-seal-name {
  font-size: 26rpx;
  color: var(--text-regular);
  margin-top: 12rpx;
}

/* 指示点 */
.swiper-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.swiper-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border-color);
}

.swiper-dot-active {
  background: var(--primary-color);
}


/* ========== 弹窗导航栏对齐（64px）========== */
.popup-status-bar {
  width: 100%;
  height: 20px;  /* 默认高度，会被内联样式覆盖 */
  flex-shrink: 0;
}

.popup-nav-bar {
  width: 100%;
  height: 64px;
  background: #ffffff;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f2f5;
  box-sizing: border-box;
  flex-shrink: 0;
  /* 确保导航栏可见 */
  min-height: 64px;
  overflow: visible;
}

.popup-nav-content {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.popup-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a202c;
}

.popup-nav-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
}

.popup-nav-close .close-icon {
  width: 36rpx;
  height: 36rpx;
}
