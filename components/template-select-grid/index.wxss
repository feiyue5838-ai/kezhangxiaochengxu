/* components/template-select-grid/index.wxss */

.template-grid {
  padding: 24rpx;
}

/* 2×2 网格布局 */
.grid-2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.grid-item {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid #f0f0f0;
  transition: all 0.3s ease;
  min-height: 140rpx;
}

.grid-item.selected {
  border-color: var(--primary-color, #5B6FE8);
  background: linear-gradient(135deg, rgb(22 119 255 / 0.05), rgb(64 150 255 / 0.08));
}

.grid-item:active {
  transform: scale(0.98);
}

/* 选中角标 */
.item-check {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: var(--primary-color, #5B6FE8);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 0 12rpx;
}

.item-check .check-icon {
  width: 24rpx;
  height: 24rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary, #333);
  margin-bottom: 8rpx;
}

.grid-item.selected .item-name {
  color: var(--primary-color, #5B6FE8);
}

.item-desc {
  font-size: 22rpx;
  color: var(--text-secondary, #999);
  line-height: 1.4;
}

/* 预览区域 */
.preview-section {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
}

.preview-header {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: #fafafa;
}

.preview-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary, #333);
}

.preview-content {
  padding: 24rpx;
  background: #fffef5;
}

.preview-text {
  font-size: 26rpx;
  color: var(--text-regular, #666);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
