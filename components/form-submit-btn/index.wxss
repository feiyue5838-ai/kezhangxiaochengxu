/* components/form-submit-btn/index.wxss */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-white);
  padding: 16rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgb(0 0 0 / 0.06);
  z-index: 999;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--bg-white);
  background: var(--text-disabled);
  border: none;
}

.submit-btn.active {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
}

.submit-btn[disabled] {
  background: var(--text-disabled) !important;
  color: var(--bg-white) !important;
}

.bottom-placeholder {
  height: 140rpx;
}
