/* components/business-introduce-card/index.wxss */
.intro-card {
  margin: 20rpx 0;
  background: transparent;
}

.intro-header {
  padding: 0 24rpx 16rpx;
}

.intro-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.intro-images {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.intro-img {
  width: 100%;
  display: block;
}

/* 加载态和空态 */
.intro-loading,
.intro-empty {
  padding: 40rpx 24rpx;
  text-align: center;
}

.intro-loading-text,
.intro-empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
