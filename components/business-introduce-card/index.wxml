<!--components/business-introduce-card/index.wxml-->
<view class="intro-card">
  <view class="intro-header">
    <text class="intro-title">业务介绍</text>
  </view>
  <view class="intro-images">
    <image
      wx:for="{{imageList}}"
      wx:key="idx"
      class="intro-img"
      src="{{item}}"
      mode="widthFix"
      bindtap="onImagePreview"
      data-src="{{item}}"
    />
  </view>
</view>
