<!-- components/bottom-bar/index.wxml -->
<view class="bottom-bar">
  <view class="tab-item {{selected === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
    <image class="tab-icon" src="{{selected === 0 ? '/images/tab-seal-active.png' : '/images/tab-seal.png'}}" mode="aspectFit" />
    <text class="tab-text">刻章</text>
  </view>
  <view class="tab-item {{selected === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
    <image class="tab-icon" src="{{selected === 1 ? '/images/tab-newspaper-active.png' : '/images/tab-newspaper.png'}}" mode="aspectFit" />
    <text class="tab-text">登报</text>
  </view>
  <view class="tab-item {{selected === 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">
    <image class="tab-icon" src="{{selected === 2 ? '/images/tab-home-active.png' : '/images/tab-home.png'}}" mode="aspectFit" />
    <text class="tab-text">首页</text>
  </view>
  <view class="tab-item {{selected === 3 ? 'active' : ''}}" bindtap="switchTab" data-index="3">
    <image class="tab-icon" src="{{selected === 3 ? '/images/tab-bookkeeping-active.png' : '/images/tab-bookkeeping.png'}}" mode="aspectFit" />
    <text class="tab-text">代理记账</text>
  </view>
  <view class="tab-item {{selected === 4 ? 'active' : ''}}" bindtap="switchTab" data-index="4">
    <image class="tab-icon" src="{{selected === 4 ? '/images/tab-profile-active.png' : '/images/tab-profile.png'}}" mode="aspectFit" />
    <text class="tab-text">我的</text>
  </view>
</view>